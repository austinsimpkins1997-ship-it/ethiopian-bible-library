{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://austinsimpkins1997-ship-it.github.io/ethiopian-bible-library/schemas/textual-lens.schema.json",
  "title": "Source-scoped textual measurement record",
  "description": "A bounded record of textual observations tied to named witnesses, source records, language tags, count rules, and review states. A valid record does not establish textual completeness, translation equivalence, or a correct interpretation.",
  "type": "object",
  "required": ["schema_version", "record_id", "status", "scope", "measurements", "interpretive_limits"],
  "properties": {
    "schema_version": { "const": 2 },
    "record_id": { "$ref": "#/$defs/id" },
    "status": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["unit", "witnesses"],
      "properties": {
        "unit": {
          "type": "object",
          "required": ["unit_type", "chapter"],
          "properties": {
            "unit_type": { "const": "chapter" },
            "chapter": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "witnesses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/witness" }
        }
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/measurement" }
    },
    "interpretive_limits": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "description": "A BCP 47-style language tag; syntax matching does not establish community usage or current registry status."
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" },
      "uniqueItems": true
    },
    "witness": {
      "type": "object",
      "required": ["witness_id", "role", "language_tag", "source_ids", "stored_verse_count", "text_sha256"],
      "properties": {
        "witness_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["source_text", "translation_companion", "transliteration", "other"] },
        "language_tag": { "$ref": "#/$defs/languageTag" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "stored_verse_count": { "type": "integer", "minimum": 0 },
        "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "breakdownValue": {
      "type": "object",
      "required": ["value", "count"],
      "properties": {
        "value": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "breakdown": {
      "type": "object",
      "required": ["dimension", "values"],
      "properties": {
        "dimension": { "enum": ["verse", "token", "string", "other"] },
        "values": { "type": "array", "items": { "$ref": "#/$defs/breakdownValue" } }
      },
      "additionalProperties": false
    },
    "excerpt": {
      "type": "object",
      "required": ["unit_label", "text"],
      "properties": {
        "unit_label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "speakerAttribution": {
      "type": "object",
      "required": ["statement", "review_state"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "review_state": { "enum": ["independently_reviewed", "not_independently_reviewed", "unknown"] }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["measurement_id", "witness_id", "language_tag", "feature", "state", "count", "count_unit", "operational_definition", "evidence_source_ids"],
      "properties": {
        "measurement_id": { "$ref": "#/$defs/id" },
        "witness_id": { "$ref": "#/$defs/id" },
        "language_tag": { "$ref": "#/$defs/languageTag" },
        "feature": { "type": "string", "minLength": 1 },
        "observed_value": { "type": "string", "minLength": 1 },
        "state": { "enum": ["measured", "unassessed", "withheld", "not_applicable"] },
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "count_unit": { "enum": ["token", "occurrence", "grammatical_form", "other"] },
        "operational_definition": { "type": "string", "minLength": 1 },
        "evidence_source_ids": { "$ref": "#/$defs/sourceIds" },
        "breakdowns": { "type": "array", "items": { "$ref": "#/$defs/breakdown" } },
        "excerpts": { "type": "array", "items": { "$ref": "#/$defs/excerpt" } },
        "speaker_attribution": { "$ref": "#/$defs/speakerAttribution" },
        "reason_for_state": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "measured" } }, "required": ["state"] },
          "then": { "properties": { "count": { "type": "integer", "minimum": 0 } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["unassessed", "withheld", "not_applicable"] } }, "required": ["state"] },
          "then": { "properties": { "count": { "type": "null" } }, "required": ["reason_for_state"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
