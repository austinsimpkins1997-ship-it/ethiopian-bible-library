  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "number": "1",
          "text": "Dubbiin Waaqayyoo kan bara Yosiyaas ilmi Aamoon mootii Yihuudaa ture keessa gara Sefaaniyaa ilma Kuushii, ilma Gedaaliyaas, ilma Amariyaa, ilma Hisqiyaas dhufe kanaa dha:",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "2",
          "text": "“Ani fuula lafaa irraa",
          "source_markers_before": [
            "b",
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Akeekkachiisa Waaʼee Badiisa Dhufaa Jiruu"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "waan hunda haxaaʼee nan balleessa”"
            },
            {
              "source_marker": "q2",
              "text": "jedha Waaqayyo."
            }
          ]
        },
        {
          "number": "3",
          "text": "“Ani namaa fi horii haxaaʼee nan balleessa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "simbirroota samiitii fi qurxummii galaanaa,"
            },
            {
              "source_marker": "q2",
              "text": "waaqota tolfamoo namoota hamoo"
            },
            {
              "source_marker": "q2",
              "text": "gufachiisan haxaaʼee nan balleessa.”"
            },
            {
              "source_marker": "q1",
              "text": "“Ani sanyii namaa lafa irraa nan balleessa”"
            },
            {
              "source_marker": "q2",
              "text": "jedha Waaqayyo."
            }
          ]
        },
        {
          "number": "4",
          "text": "“Ani Yihuudaa fi warra Yerusaalem keessa",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "jiraatan hundatti harka koo ol nan fudhadha."
            },
            {
              "source_marker": "q1",
              "text": "Ani hambaa Baʼaal hundaa fi // maqaa luboota waaqota tolfamoo waaqeffatanii"
            },
            {
              "source_marker": "q2",
              "text": "iddoo kanaa nan balleessa;"
            }
          ]
        },
        {
          "number": "5",
          "text": "warra raayyaa samii waaqeffachuuf",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "qinaaxxii manaa irratti sagadan,"
            },
            {
              "source_marker": "q1",
              "text": "warra sagadanii fi Waaqayyoon kakatan,"
            },
            {
              "source_marker": "q2",
              "text": "warra Moolekiinis kakatan,"
            }
          ]
        },
        {
          "number": "6",
          "text": "warra Waaqayyoon duukaa buʼuu dhiisanii duubatti deebiʼan,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "warra Waaqayyoon hin barbaanne // yookaan gorsa isaa hin gaafanne nan balleessa.”"
            }
          ]
        },
        {
          "number": "7",
          "text": "Guyyaan Waaqayyoo waan dhiʼaateef",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "fuula Waaqayyoo Gooftaa duratti calʼisaa."
            },
            {
              "source_marker": "q1",
              "text": "Waaqayyo aarsaa tokko qopheesseera;"
            },
            {
              "source_marker": "q2",
              "text": "inni warra affeere qulqulleesseera."
            }
          ]
        },
        {
          "number": "8",
          "text": "“Guyyaa aarsaa Waaqayyootti",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ani qondaaltota ilmaan mootichaatii fi"
            },
            {
              "source_marker": "q2",
              "text": "warra wayyaa ormaa uffatan hunda nan adaba."
            }
          ]
        },
        {
          "number": "9",
          "text": "Ani gaafas warra buusaa irra utaalan,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kanneen galma waaqota isaanii jeequmsaa fi"
            },
            {
              "source_marker": "q2",
              "text": "gowwoomsaadhaan guutan nan adaba.”"
            }
          ]
        },
        {
          "number": "10",
          "text": "Waaqayyo akkana jedha;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "“Gaafas Karra Qurxummii irraa iyya,"
            },
            {
              "source_marker": "q1",
              "text": "Waltajjii Lammaffaa irraa wawwaannaa,"
            },
            {
              "source_marker": "q2",
              "text": "gaarran irraa immoo"
            },
            {
              "source_marker": "q2",
              "text": "sagalee diigama guddaatu dhagaʼama."
            }
          ]
        },
        {
          "number": "11",
          "text": "Isin warri Makteesh keessa jiraattan wawwaadhaa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "daldaltoonni keessan hundi lafa irraa haxaaʼamu;"
            },
            {
              "source_marker": "q2",
              "text": "warri meetii daldalan hundinuus ni barbadaaʼu."
            }
          ]
        },
        {
          "number": "12",
          "text": "Ani yeroo sana Yerusaalemin ibsaadhaan nan sakattaʼa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "warra qananiidhaan jiraatan,"
            },
            {
              "source_marker": "q2",
              "text": "kanneen akka daadhii wayinii siicoo irratti hafee taʼan,"
            },
            {
              "source_marker": "q1",
              "text": "kanneen, ‘Waaqayyo waan tolaas taʼu waan hamaa"
            },
            {
              "source_marker": "q2",
              "text": "homaa hin godhu’ jedhanii yaadan nan adaba."
            }
          ]
        },
        {
          "number": "13",
          "text": "Qabeenyi isaanii ni saamama;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "manni isaanii ni ona."
            },
            {
              "source_marker": "q1",
              "text": "Isaan mana ijaarratu;"
            },
            {
              "source_marker": "q2",
              "text": "garuu keessa hin jiraatan;"
            },
            {
              "source_marker": "q1",
              "text": "isaan biqiltuu wayinii ni dhaabbatu;"
            },
            {
              "source_marker": "q2",
              "text": "garuu daadhii wayinii hin dhugan.”"
            }
          ]
        },
        {
          "number": "14",
          "text": "Guyyaan Waaqayyoo guddichi dhiʼaateera;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "dhiʼaatees dafee dhufaara."
            },
            {
              "source_marker": "q1",
              "text": "Dhagaʼaa! Iyyi guyyaa Waaqayyoo hadhaaʼaa dha;"
            },
            {
              "source_marker": "q2",
              "text": "goonni achitti sagalee ol fudhatee iyya."
            }
          ]
        },
        {
          "number": "15",
          "text": "Guyyaan sun guyyaa dheekkamsaa,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "guyyaa dhiphinaa fi gaddaa,"
            },
            {
              "source_marker": "q3",
              "text": "guyyaa rakkinaa fi badiisaa,"
            },
            {
              "source_marker": "q2",
              "text": "guyyaa dukkanaa fi dimimmisaa,"
            },
            {
              "source_marker": "q3",
              "text": "guyyaa duumessaa fi dukkana hamaa ni taʼa;"
            }
          ]
        },
        {
          "number": "16",
          "text": "magaalaawwan dallaa jabaa qabanii fi",
          "source_markers_before": [
            "q2"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "gamoowwan ol dhedheeroo irratti"
            },
            {
              "source_marker": "q2",
              "text": "guyyaa itti malakata afuufanii fi iyya waraanaa taʼa."
            }
          ]
        },
        {
          "number": "17",
          "text": "“Sababii isaan Waaqayyootti cubbuu hojjetaniif,",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ani akka isaan akkuma jaamotaatti deemaniif"
            },
            {
              "source_marker": "q2",
              "text": "uummatatti dhiphina nan fida."
            },
            {
              "source_marker": "q1",
              "text": "Dhiigni isaanii akkuma awwaaraa,"
            },
            {
              "source_marker": "q2",
              "text": "miʼi garaa isaaniis akkuma kosii gatama."
            }
          ]
        },
        {
          "number": "18",
          "text": "Guyyaa dheekkamsa Waaqayyootti",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "meetiin isaanii yookaan warqeen isaanii"
            },
            {
              "source_marker": "q2",
              "text": "isaan oolchuu hin dandaʼu.”"
            },
            {
              "source_marker": "q1",
              "text": "Ibidda hinaaffaa isaatiin"
            },
            {
              "source_marker": "q2",
              "text": "addunyaan hundi ni barbadoofti;"
            },
            {
              "source_marker": "q1",
              "text": "warra lafa irra jiraatan hundatti"
            },
            {
              "source_marker": "q2",
              "text": "inni badiisa tasaa ni fidaatii."
            }
          ]
        }
      ],
      "notes": [],
      "source_trailing_elements": [
        {
          "marker": "b",
          "text": null
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "number": "1",
          "text": "Yaa saba qaanii hin qabne,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "walitti qabamaa; walitti qabamaa;"
            }
          ]
        },
        {
          "number": "2",
          "text": "utuu yeroon murtaaʼe sun gaʼee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "guyyaan sun akkuma habaqiitti isin hin haxaaʼin,"
            },
            {
              "source_marker": "q1",
              "text": "utuu aariin Waaqayyoo bobaʼaan sun"
            },
            {
              "source_marker": "q2",
              "text": "isinitti hin dhufin,"
            },
            {
              "source_marker": "q1",
              "text": "utuu guyyaan dheekkamsa Waaqayyoo"
            },
            {
              "source_marker": "q2",
              "text": "isinitti hin dhufin walitti qabamaa."
            }
          ]
        },
        {
          "number": "3",
          "text": "Isin garraamonni lafaa",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kanneen waan inni ajaju hojjettan hundi // Waaqayyoon barbaaddadhaa."
            },
            {
              "source_marker": "q1",
              "text": "Qajeelummaa barbaadaa; gad of qabiisa barbaadaa;"
            },
            {
              "source_marker": "q2",
              "text": "isin guyyaa dheekkamsa Waaqayyootti"
            },
            {
              "source_marker": "q2",
              "text": "ni golbomamtu taʼaatii."
            }
          ]
        },
        {
          "number": "4",
          "text": "Gaazaan duwwaa hafti;",
          "source_markers_before": [
            "s2",
            "q1"
          ],
          "source_headings_before": [
            "Filisxeemitti"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Ashqaloon immoo ni onti."
            },
            {
              "source_marker": "q1",
              "text": "Sabni Ashdood guyyuma Saafaadhaan ariʼamee baʼa;"
            },
            {
              "source_marker": "q2",
              "text": "Eqroon immoo ni buqqifamti."
            }
          ]
        },
        {
          "number": "5",
          "text": "Yaa Kereetota qarqara galaanaa jiraattan,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isiniif wayyoo;"
            },
            {
              "source_marker": "q1",
              "text": "yaa Kanaʼaan, biyya Filisxeemotaa,"
            },
            {
              "source_marker": "q2",
              "text": "dubbiin Waaqayyoo akkana jedhee sitti dhufeera;"
            },
            {
              "source_marker": "q1",
              "text": "“Ani sin barbadeessa;"
            },
            {
              "source_marker": "q2",
              "text": "namni tokko iyyuu hin hafu.”"
            }
          ]
        },
        {
          "number": "6",
          "text": "Biyyi qarqara galaanaa,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "iddoon Kaliitonni jiraatan,"
            },
            {
              "source_marker": "q2",
              "text": "iddoo tiksoonni jiraatanii fi gola bushaayee taʼa."
            }
          ]
        },
        {
          "number": "7",
          "text": "Innis handhuuraa hambaa mana Yihuudaa taʼa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isaan achitti lafa dheedaa argatu."
            },
            {
              "source_marker": "q1",
              "text": "Isaan galgala galgala"
            },
            {
              "source_marker": "q2",
              "text": "mana Ashqaloon keessa ciciisu."
            },
            {
              "source_marker": "q1",
              "text": "Waaqayyo Waaqni isaanii isaan tiksa;"
            },
            {
              "source_marker": "q2",
              "text": "boojuu isaaniis ni deebisaaf."
            }
          ]
        },
        {
          "number": "8",
          "text": "“Ani arrabsoo Moʼaabii fi",
          "source_markers_before": [
            "s2",
            "q1"
          ],
          "source_headings_before": [
            "Moʼaabii fi Amoon"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Qoosaa Amoonotaa,"
            },
            {
              "source_marker": "q1",
              "text": "warra saba koo arrabsanii fi"
            },
            {
              "source_marker": "q2",
              "text": "biyya isaanii doorsisan sanaa dhagaʼeera."
            }
          ]
        },
        {
          "number": "9",
          "text": "Kanaafuu akkuma ani dhugumaan jiraataa taʼe sana”",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "jedha Waaqayyo Waan Hunda Dandaʼu,"
            },
            {
              "source_marker": "q2",
              "text": "Waaqni Israaʼel;"
            },
            {
              "source_marker": "q1",
              "text": "“Moʼaab dhugumaan akkuma Sodoom,"
            },
            {
              "source_marker": "q2",
              "text": "Amoononnis akka Gomoraa,"
            },
            {
              "source_marker": "q1",
              "text": "iddoo aramaatii fi boolla soogiddaa,"
            },
            {
              "source_marker": "q2",
              "text": "lafa bara baraan one ni taʼu."
            },
            {
              "source_marker": "q1",
              "text": "Hambaan uummata kootii isaan saamu;"
            },
            {
              "source_marker": "q2",
              "text": "warri saba koo keessaa badii jalaa baʼan biyya isaanii ni dhaalu.”"
            }
          ]
        },
        {
          "number": "10",
          "text": "Kun gatii isaan of tuulummaa isaaniitiif argatanii dha;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isaan saba Waaqayyoo Waan Hunda Dandaʼuu arrabsanii"
            },
            {
              "source_marker": "q2",
              "text": "itti qoosaniiruutii."
            }
          ]
        },
        {
          "number": "11",
          "text": "Waaqayyo yeroo waaqota biyyattii hunda barbadeessutti,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka malee isaan sodaachisa."
            },
            {
              "source_marker": "q1",
              "text": "Saboonni qarqara galaana hundaa irra jiraatan,"
            },
            {
              "source_marker": "q2",
              "text": "namni biyya isaa keessa jiraatu hundinuus isa waaqeffata."
            }
          ]
        },
        {
          "number": "12",
          "text": "“Yaa warra Itoophiyaa",
          "source_markers_before": [
            "s2",
            "q1"
          ],
          "source_headings_before": [
            "Itoophiyaa"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isinis goraadee kootiin ni gorraʼamtu.”"
            }
          ]
        },
        {
          "number": "13",
          "text": "Inni kaabatti harka ol fudhata;",
          "source_markers_before": [
            "s2",
            "q1"
          ],
          "source_headings_before": [
            "Asoor"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Asoorinis ni barbadeessa;"
            },
            {
              "source_marker": "q1",
              "text": "Nanawwee guutumaan guutuutti ni onsa;"
            },
            {
              "source_marker": "q2",
              "text": "akkuma gammoojjiitti gogsee hambisa."
            }
          ]
        },
        {
          "number": "14",
          "text": "Bushaayee fi loon,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "uumamawwan gosa hundaa achi ciciisu."
            },
            {
              "source_marker": "q1",
              "text": "Urunguu fi dhaddeen"
            },
            {
              "source_marker": "q2",
              "text": "utubaa ishee irra boqotu."
            },
            {
              "source_marker": "q1",
              "text": "Sagaleen isaanii foddaawwan keessaan dhagaʼama;"
            },
            {
              "source_marker": "q2",
              "text": "diigamni balbala isaanii dura jira;"
            },
            {
              "source_marker": "q2",
              "text": "demdemoon birbirsaa hundinuu qullaa hafa."
            }
          ]
        },
        {
          "number": "15",
          "text": "Kun magaalaa of hin eegganne",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kan garuu nagumaan jiraattuu dha."
            },
            {
              "source_marker": "q1",
              "text": "Magaalaan kun,"
            },
            {
              "source_marker": "q2",
              "text": "“Anuma qofa malee kan biraa na bira hin jiru” ofiin jette."
            },
            {
              "source_marker": "q1",
              "text": "Isheen akkam akkas ontee,"
            },
            {
              "source_marker": "q2",
              "text": "iddoo bineensi bosonaa jiraatu taate!"
            },
            {
              "source_marker": "q1",
              "text": "Namni ishee bira baʼee darbu hundinuu ni qoosa;"
            },
            {
              "source_marker": "q2",
              "text": "harka isaas ni raasa."
            }
          ]
        }
      ],
      "notes": [],
      "heading": [
        "Yihuudaa fi Yerusaalem Saboota waliin itti Murteeffame",
        "Yihuudaan akka Qalbii Jijjiirratuuf Akeekkachiifame"
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "number": "1",
          "text": "Magaalaa cunqursitootaa,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "finciltuu fi xurooftuu sanaaf wayyoo!"
            }
          ]
        },
        {
          "number": "2",
          "text": "Isheen nama tokkoof iyyuu hin ajajamtu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "sirreeffama tokko iyyuu hin fudhattu."
            },
            {
              "source_marker": "q1",
              "text": "Isheen Waaqayyoon hin amanattu;"
            },
            {
              "source_marker": "q2",
              "text": "Waaqa isheettis hin dhiʼaattu."
            }
          ]
        },
        {
          "number": "3",
          "text": "Qondaaltonni ishee leenca aaduu dha;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "bulchitoonni ishee yeeyyii galgalaa"
            },
            {
              "source_marker": "q2",
              "text": "kanneen waan tokko illee ganamaaf // hin bulfannee dha."
            }
          ]
        },
        {
          "number": "4",
          "text": "Raajonni ishee of tuultota;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isaan namoota hin amanamnee dha."
            },
            {
              "source_marker": "q1",
              "text": "Luboonni ishee iddoo qulqulluu"
            },
            {
              "source_marker": "q2",
              "text": "xureessanii seeras cabsu."
            }
          ]
        },
        {
          "number": "5",
          "text": "Waaqayyo inni ishee keessa jiru qajeelaa dha;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "inni dogoggora tokko illee hin hojjetu."
            },
            {
              "source_marker": "q1",
              "text": "Inni ganama ganama murtii qajeelaa kenna;"
            },
            {
              "source_marker": "q2",
              "text": "guyyaa tokko iyyuu waan kana hojjechuu hin dadhabu;"
            },
            {
              "source_marker": "q2",
              "text": "jalʼoonni garuu qaanii tokko iyyuu hin beekan."
            }
          ]
        },
        {
          "number": "6",
          "text": "“Ani saboota nan balleessa;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "daʼannoowwan isaanii diigamaniiru."
            },
            {
              "source_marker": "q1",
              "text": "Akka namni tokko iyyuu achiin hin dabarreef"
            },
            {
              "source_marker": "q2",
              "text": "ani daandiiwwan ishee onseera."
            },
            {
              "source_marker": "q1",
              "text": "Magaalaawwan isaanii onanii"
            },
            {
              "source_marker": "q2",
              "text": "nama malee, duwwaa hafu."
            }
          ]
        },
        {
          "number": "7",
          "text": "Ani magaalaa sanaan,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "‘Ati dhugumaan na sodaatta;"
            },
            {
              "source_marker": "q2",
              "text": "sirreeffamas ni fudhatta!’ nan jedhe."
            },
            {
              "source_marker": "q1",
              "text": "Ergasii iddoon jireenya ishee hin badu"
            },
            {
              "source_marker": "q2",
              "text": "yookaan adabbiin koo hundinuu isheetti hin dhufu."
            },
            {
              "source_marker": "q1",
              "text": "Isaan garuu waan hojjetan hunda keessatti"
            },
            {
              "source_marker": "q2",
              "text": "daba hojjechuutti ciman."
            }
          ]
        },
        {
          "number": "8",
          "text": "Kanaafuu guyyaa ani itti dhugaa baʼu eeggadhu”",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "jedha Waaqayyo;"
            },
            {
              "source_marker": "q1",
              "text": "“Ani sabootaa fi"
            },
            {
              "source_marker": "q2",
              "text": "mootummoota walitti qabee"
            },
            {
              "source_marker": "q1",
              "text": "dheekkamsa kootii fi"
            },
            {
              "source_marker": "q2",
              "text": "aarii koo sodaachisaa sana hunda"
            },
            {
              "source_marker": "q2",
              "text": "isaanitti dhangalaasuuf murteesseera."
            },
            {
              "source_marker": "q1",
              "text": "Addunyaan guutuun ibidda"
            },
            {
              "source_marker": "q2",
              "text": "hinaaffaa kootiin gubattee barbadoofti."
            }
          ]
        },
        {
          "number": "9",
          "text": "“Ergasii ani akka hundi isaanii // maqaa Waaqayyoo waammataniif,",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka walii galuudhaan isa tajaajilaniifis"
            },
            {
              "source_marker": "q2",
              "text": "afaan namootaa nan qulqulleessa."
            }
          ]
        },
        {
          "number": "10",
          "text": "Warri anaaf sagadan,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "intallan koo kanneen bittinnaaʼan"
            },
            {
              "source_marker": "q2",
              "text": "lageen Itoophiyaa gamaa kennaa naaf fidu."
            }
          ]
        },
        {
          "number": "11",
          "text": "Sababii ani warra of tuulummaa isaaniitti gammadan",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "magaalaa kana keessaa baasuuf,"
            },
            {
              "source_marker": "q1",
              "text": "gaafas yakka ati natti hojjette"
            },
            {
              "source_marker": "q2",
              "text": "sana hundaaf salphinni sitti hin dhufu."
            },
            {
              "source_marker": "q1",
              "text": "Ati lammata gaara koo"
            },
            {
              "source_marker": "q2",
              "text": "qulqulluu irratti of hin tuultu."
            }
          ]
        },
        {
          "number": "12",
          "text": "Ani garuu garraamotaa fi",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gad of qabeeyyii"
            },
            {
              "source_marker": "q1",
              "text": "kanneen maqaa Waaqayyoo amanatan"
            },
            {
              "source_marker": "q2",
              "text": "si keessatti nan hambisa."
            }
          ]
        },
        {
          "number": "13",
          "text": "Hambaan Israaʼel",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yakka tokko illee hin hojjetan."
            },
            {
              "source_marker": "q1",
              "text": "Isaan soba hin dubbatan"
            },
            {
              "source_marker": "q2",
              "text": "yookaan gowwoomsaan afaan isaanii keessatti hin argamu."
            },
            {
              "source_marker": "q1",
              "text": "Isaan nyaatanii boqotu;"
            },
            {
              "source_marker": "q2",
              "text": "kan isaan sodaachisus hin jiru.”"
            }
          ]
        },
        {
          "number": "14",
          "text": "Yaa Intala Xiyoon ati faarfadhu;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yaa Israaʼel sagalee ol fudhadhuu iyyi!"
            },
            {
              "source_marker": "q1",
              "text": "Yaa Intala Yerusaalem gammadiitii"
            },
            {
              "source_marker": "q2",
              "text": "garaa kee guutuudhaan ililchi!"
            }
          ]
        },
        {
          "number": "15",
          "text": "Waaqayyo adaba kee sirraa fuudheera;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "inni diinota kee sirraa deebiseera."
            },
            {
              "source_marker": "q1",
              "text": "Waaqayyo Mootiin Israaʼel, si wajjin jira;"
            },
            {
              "source_marker": "q2",
              "text": "ati lammata balaa tokko illee hin sodaattu."
            }
          ]
        },
        {
          "number": "16",
          "text": "Isaan gaafas",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Yerusaalemiin akkana ni jedhu;"
            },
            {
              "source_marker": "q1",
              "text": "“Yaa Xiyoon hin sodaatin;"
            },
            {
              "source_marker": "q2",
              "text": "harki kees hin laafin."
            }
          ]
        },
        {
          "number": "17",
          "text": "Waaqayyo Waaqni kee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "inni si wajjin jiru jabaa dha."
            },
            {
              "source_marker": "q1",
              "text": "Inni baayʼee sitti gammada;"
            },
            {
              "source_marker": "q2",
              "text": "inni jaalala isaatiin si boqochiisa;"
            },
            {
              "source_marker": "q2",
              "text": "faarfannaadhaanis sitti gammada.”"
            }
          ]
        },
        {
          "number": "18",
          "text": "“Ani gadda ati ayyaanota murteeffamaniif gadditu",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "sirraa nan fuudha;"
            },
            {
              "source_marker": "q2",
              "text": "isaan booʼichaa fi salphina sitti taʼu."
            }
          ]
        },
        {
          "number": "19",
          "text": "Ani yeroo sanatti",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "warra si cunqursan hunda nan adaba;"
            },
            {
              "source_marker": "q1",
              "text": "ani okkolaa nan baraara;"
            },
            {
              "source_marker": "q2",
              "text": "warra gatamanis walitti nan qaba."
            },
            {
              "source_marker": "q1",
              "text": "Ani biyya isaan itti qaaneffaman hunda keessatti"
            },
            {
              "source_marker": "q2",
              "text": "maqaa fi ulfina isaaniifin kennaaf."
            }
          ]
        },
        {
          "number": "20",
          "text": "Ani yeroo sanatti walittin isin qaba;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yeroo sanatti ani biyya keessanitti isin nan galcha."
            },
            {
              "source_marker": "q1",
              "text": "Ani yeroo utuma isin argitanuu"
            },
            {
              "source_marker": "q2",
              "text": "boojuu keessan deebisutti"
            },
            {
              "source_marker": "q1",
              "text": "saba lafaa hunda gidduutti"
            },
            {
              "source_marker": "q2",
              "text": "ulfinaa fi maqaa isiniifin kenna”"
            },
            {
              "source_marker": "q2",
              "text": "jedha Waaqayyo."
            }
          ]
        }
      ],
      "notes": [],
      "heading": [
        "Yerusaalem"
      ]
    }
  ]
}
