  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "number": "1",
          "text": "Raajii Anbaaqoom raajichi arge.",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "2",
          "text": "Yaa Waaqayyo, ani hamma yoomiittin gargaarsaaf // sitti iyyadha?",
          "source_markers_before": [
            "b",
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Guungummii Anbaaqoom"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Ati garuu na hin dhaggeeffattu;"
            },
            {
              "source_marker": "q1",
              "text": "yookaan ani hamma yoomiitti, “Goolii!”"
            },
            {
              "source_marker": "q2",
              "text": "jedhee sitti booʼee ati garuu na hin oolchitu?"
            }
          ]
        },
        {
          "number": "3",
          "text": "Ati maaliif akka ani murtii dabe argu na goota?",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Ati maaliif balleessaa namaa obsita?"
            },
            {
              "source_marker": "q1",
              "text": "Badiisnii fi gooliin fuula koo dura jiru;"
            },
            {
              "source_marker": "q2",
              "text": "lollii fi waldhabiinsi baayʼateera."
            }
          ]
        },
        {
          "number": "4",
          "text": "Kanaafuu seerri laamshaʼeera;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "murtiin qajeelaan dabsameera."
            },
            {
              "source_marker": "q1",
              "text": "Akka murtiin qajeelaan jalʼifamuuf;"
            },
            {
              "source_marker": "q2",
              "text": "namoonni hamoon qajeelota marsu."
            }
          ]
        },
        {
          "number": "5",
          "text": "“Saboota hubadhaa ilaalaa;",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Deebii Waaqayyoo"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka malees dinqisiifadhaa."
            },
            {
              "source_marker": "q1",
              "text": "Ani bara keessan keessa"
            },
            {
              "source_marker": "q2",
              "text": "waan isin yoo isinitti himame illee"
            },
            {
              "source_marker": "q2",
              "text": "hin amanne tokko nan hojjedha."
            }
          ]
        },
        {
          "number": "6",
          "text": "Ani warra Baabilon,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "uummata gara jabeessaa fi ariifataa,"
            },
            {
              "source_marker": "q1",
              "text": "kan iddoo jireenya isaa hin taʼin qabachuuf"
            },
            {
              "source_marker": "q2",
              "text": "guutummaa lafaa keessa yaaʼu sana nan kaasa."
            }
          ]
        },
        {
          "number": "7",
          "text": "Isaan saba sodaatamuu fi naasisuu dha;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isaan ofii isaaniitiifuu seera;"
            },
            {
              "source_marker": "q2",
              "text": "ulfina isaaniis ni guddifatu."
            }
          ]
        },
        {
          "number": "8",
          "text": "Fardeen isaanii qeerransa caalaa saffisu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yeeyyii galgalaa caalaa sodaachisu."
            },
            {
              "source_marker": "q1",
              "text": "Namoonni isaanii kanneen farda yaabbatan // ariitiidhaan gulufu;"
            },
            {
              "source_marker": "q2",
              "text": "abbootiin farda isaaniis fagoodhaa dhufu."
            },
            {
              "source_marker": "q1",
              "text": "Isaan akkuma risaa waa nyaachuuf ariifatuu barrisu;"
            }
          ]
        },
        {
          "number": "9",
          "text": "isaan hundinuu jeequmsaaf dhufu.",
          "source_markers_before": [
            "q2"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "Tuunni isaanii akkuma bubbee gammoojjii gara fuula duraatti qajeela;"
            },
            {
              "source_marker": "q2",
              "text": "namoota hidhamanis akkuma cirrachaa walitti qaba."
            }
          ]
        },
        {
          "number": "10",
          "text": "Isaan mootota tuffatanii",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "bulchitootatti qoosu."
            },
            {
              "source_marker": "q1",
              "text": "Daʼannoo hundatti ni kolfu;"
            },
            {
              "source_marker": "q2",
              "text": "biyyoos tuulanii isa qabatu."
            }
          ]
        },
        {
          "number": "11",
          "text": "Ergasii namoonni yakka hojjetan kanneen humna isaanii // waaqa isaanii godhatan,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka bubbee lafa haxaaʼanii karaa isaanii itti fufu.”"
            }
          ]
        },
        {
          "number": "12",
          "text": "Yaa Waaqayyo, ati bara baraa jalqabdee jirta mitii?",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Gungummii Anbaaqoom isa Lammaffaa"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Yaa Waaqa ko, yaa Qulqullicha ko, ati gonkumaa hin duutu."
            },
            {
              "source_marker": "q1",
              "text": "Yaa Waaqayyo, ati akka isaan murtii kennaniif // isaan muuddeerta;"
            },
            {
              "source_marker": "q2",
              "text": "yaa Kattaa ko, ati akka isaan nama adabaniif isaan ramaddeerta."
            }
          ]
        },
        {
          "number": "13",
          "text": "Iji kee akka waan hamaa hin ilaalleef akka malee qulqulluu dha;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ati daba argitee obsaan dhiisuu hin dandeessu."
            },
            {
              "source_marker": "q1",
              "text": "Yoos ati maaliif obsaan namoota hamoo ilaalta?"
            },
            {
              "source_marker": "q2",
              "text": "Ati maaliif yeroo namoonni hamoon"
            },
            {
              "source_marker": "q2",
              "text": "warra isaan caalaa qajeeloo taʼan liqimsanitti calʼistaa?"
            }
          ]
        },
        {
          "number": "14",
          "text": "Ati namoota akka qurxummii galaana keessaa,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka uumamawwan galaanaa kanneen bulchaa // hin qabnee gooteerta."
            }
          ]
        },
        {
          "number": "15",
          "text": "Diinni hokkoodhaan isaan hunda ol baasa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kiyyoo isaatiinis isaan harkisa;"
            },
            {
              "source_marker": "q1",
              "text": "kiyyoo isaa keessatti walitti isaan qabata;"
            },
            {
              "source_marker": "q2",
              "text": "kanaafuu inni ni gammada; ni ililchas."
            }
          ]
        },
        {
          "number": "16",
          "text": "Inni sababii kiyyoo isaatiin bashannanee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "nyaata isaa filatamaatti gammaduuf"
            },
            {
              "source_marker": "q1",
              "text": "kiyyoo isaatiif aarsaa dhiʼeessa;"
            },
            {
              "source_marker": "q2",
              "text": "kiyyoo isaatiif illee ixaana aarsa."
            }
          ]
        },
        {
          "number": "17",
          "text": "Inni kiyyoo isaa keessaa garagalchuudhaan,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gara laafina malee ittuma fufee saboota balleessuu qabaa?"
            }
          ]
        }
      ],
      "notes": [],
      "source_trailing_elements": [
        {
          "marker": "b",
          "text": null
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "number": "1",
          "text": "Ani iddoo koo dhaabadhee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "dallaa eegumsaa irra nan tura;"
            },
            {
              "source_marker": "q1",
              "text": "mee waan inni naan jedhu arguuf"
            },
            {
              "source_marker": "q2",
              "text": "deebii ani guungummii kanaaf kennuu malu beekuuf nan ilaala."
            }
          ]
        },
        {
          "number": "2",
          "text": "Ergasii Waaqayyo akkana jedhee deebii kenne:",
          "source_markers_before": [
            "s1",
            "p"
          ],
          "source_headings_before": [
            "Deebii Waaqayyoo"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "“Akka namni dubbisu tokko qabatee fiiguuf,"
            },
            {
              "source_marker": "q2",
              "text": "mulʼata sana ifa godhii"
            },
            {
              "source_marker": "q2",
              "text": "gabatee irratti barreessi."
            }
          ]
        },
        {
          "number": "3",
          "text": "Mulʼanni kun yeroo murtaaʼe tokko eeggataatii;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "inni waaʼee dhuma isaa dubbata malee hin sobu."
            },
            {
              "source_marker": "q1",
              "text": "Yoo tures isa eegi;"
            },
            {
              "source_marker": "q2",
              "text": "inni dhugumaan ni dhufa; hin turus."
            }
          ]
        },
        {
          "number": "4",
          "text": "“Kunoo inni of bokokseera;",
          "source_markers_before": [
            "b",
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hawwiin isaas sirrii miti;"
            },
            {
              "source_marker": "q2",
              "text": "namni qajeelaan garuu amantii isaatiin jiraata;"
            }
          ]
        },
        {
          "number": "5",
          "text": "dhugumaan inni daadhii wayiniitiin ni gowwoomfama;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "of tuula; boqonnaas hin qabu."
            },
            {
              "source_marker": "q1",
              "text": "Inni akkuma siiʼool sassata;"
            },
            {
              "source_marker": "q2",
              "text": "akka duʼaas kan hin quufnee dha."
            },
            {
              "source_marker": "q1",
              "text": "Inni saboota hunda walitti qabata;"
            },
            {
              "source_marker": "q2",
              "text": "uummata hundas boojiʼee fudhata."
            }
          ]
        },
        {
          "number": "6",
          "text": "“Isaan hundi isa tuffatanii itti kolfaa,",
          "source_markers_before": [
            "p"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "“ ‘Nama miʼa hatame tuullatee"
            },
            {
              "source_marker": "q2",
              "text": "saamichaan of sooromsuuf wayyoo!"
            },
            {
              "source_marker": "q2",
              "text": "Wanni kun hamma yoomiitti itti fufa’ // jedhanii itti hin qoosanii?"
            }
          ]
        },
        {
          "number": "7",
          "text": "Warri liqii sirraa qaban akkuma tasaa sitti hin kaʼanii?",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Isaan kaʼanii si hin hollachiisanii?"
            },
            {
              "source_marker": "q2",
              "text": "Ergasii ati harka isaanii jala galta."
            }
          ]
        },
        {
          "number": "8",
          "text": "Sababii ati saba hedduu saamteef",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "namoonni hafan si saamu."
            },
            {
              "source_marker": "q1",
              "text": "Ati dhiiga namaa dhangalaafteertaatii;"
            },
            {
              "source_marker": "q2",
              "text": "ati biyyoota, magaalaawwanii fi // namoota isaan keessa jiraatan hunda balleessiteerta."
            }
          ]
        },
        {
          "number": "9",
          "text": "“Nama buʼaa hin malleen mana ijaarratu",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kan badiisa jalaa baʼuuf jedhee"
            },
            {
              "source_marker": "q2",
              "text": "lafa ol kaʼaa irratti iddoo jireenyaa tolfatuuf wayyoo!"
            }
          ]
        },
        {
          "number": "10",
          "text": "Ati lubbuu nama baayʼee galaafachuudhaaf,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "waan nama qaanessu mana keetti malattee // lubbuu keetti badiisa fidde."
            }
          ]
        },
        {
          "number": "11",
          "text": "Dhagaawwan keenyan keessaa iyyu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "demdemoon mukaas jalaa qaba."
            }
          ]
        },
        {
          "number": "12",
          "text": "“Nama dhiiga dhangalaasuudhaan magaalaa ijaaruuf,",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kan yakkaan magaalaa hundeessuuf wayyoo!"
            }
          ]
        },
        {
          "number": "13",
          "text": "Akka dadhabbiin namaa akkuma qoraan ibiddaa taʼe,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka saboonnis akkasumaan of dadhabsiisan"
            },
            {
              "source_marker": "q2",
              "text": "Waaqayyoon Waan Hunda Dandaʼu murteesseera mitii?"
            }
          ]
        },
        {
          "number": "14",
          "text": "Akkuma bishaan galaana guutu sana",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "lafti ulfina Waaqayyoon beekuutiin guutamtiitii."
            }
          ]
        },
        {
          "number": "15",
          "text": "“Nama qullaa dhagna ollaa isaa ilaaluuf jedhee",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hamma inni machaaʼutti"
            },
            {
              "source_marker": "q2",
              "text": "qalqalloo keessaa daadhii wayinii isaaf buusuuf wayyoo."
            }
          ]
        },
        {
          "number": "16",
          "text": "Ati qooda ulfinaa qaaniidhaan guutamta.",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Amma dabareen kan kee ti! Akka qullaan kee mulʼatuuf dhugi."
            },
            {
              "source_marker": "q1",
              "text": "Xoofoon mirga Waaqayyoo sitti garagala;"
            },
            {
              "source_marker": "q2",
              "text": "salphinnis ulfina kee haguuga."
            }
          ]
        },
        {
          "number": "17",
          "text": "Fincilli ati Libaanoonitti hojjete si liqimsa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "horii fixuun kee si rifachiisa."
            },
            {
              "source_marker": "q1",
              "text": "Ati dhiiga namaa dhangalaafteertaatii;"
            },
            {
              "source_marker": "q2",
              "text": "ati biyyoota, magaalaawwanii fi namoota isaan keessa jiraatan // hunda balleessiteerta."
            }
          ]
        },
        {
          "number": "18",
          "text": "“Waaqni tolfamaan ogeessa harkaatiin soofamu",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yookaan fakkiin soba barsiisu faayidaa maalii qaba?"
            },
            {
              "source_marker": "q1",
              "text": "Namni isa tolchu tokko hojiidhuma harka isaa amanataatii;"
            },
            {
              "source_marker": "q2",
              "text": "inni waaqota tolfamoo dubbachuu hin dandeenye tolcha."
            }
          ]
        },
        {
          "number": "19",
          "text": "Nama mukaan, ‘Dammaqi!’",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yookaan dhagaa lubbuu hin qabneen, ‘Kaʼi!’ jedhuuf wayyoo."
            },
            {
              "source_marker": "q1",
              "text": "Inni barsiisuu ni dandaʼaa?"
            },
            {
              "source_marker": "q2",
              "text": "Kunoo inni warqee fi meetii dibameera;"
            },
            {
              "source_marker": "q2",
              "text": "hafuurri tokko iyyuu isa keessa hin jiru.”"
            }
          ]
        },
        {
          "number": "20",
          "text": "Waaqayyo garuu mana qulqullummaa isaa // qulqulluu sana keessa jira;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "lafti hundi fuula isaa duratti haa calʼistu."
            }
          ]
        }
      ],
      "notes": []
    },
    {
      "chapter": 3,
      "verses": [
        {
          "number": "1",
          "text": "Kadhannaa Anbaaqoom raajichaa shigiyonootiidhaan.",
          "source_markers_before": [
            "d"
          ]
        },
        {
          "number": "2",
          "text": "Yaa Waaqayyo, ani oduu kee dhagaʼeera;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yaa Waaqayyo, ani gochawwan kee nan sodaadha."
            },
            {
              "source_marker": "q1",
              "text": "Bara keenya keessa isaan haaromsi;"
            },
            {
              "source_marker": "q2",
              "text": "jabana keenya keessa isaan beekkamsiisi;"
            },
            {
              "source_marker": "q2",
              "text": "yeroo dheekamtutti araara yaadadhu."
            }
          ]
        },
        {
          "number": "3",
          "text": "Waaqni Teemaan irraa,",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Inni Qulqullichi Tulluu Phaaraaniitii dhufe."
            },
            {
              "source_marker": "q1",
              "text": "Ulfinni isaa samiiwwan haguuge;"
            },
            {
              "source_marker": "q2",
              "text": "galanni isaas lafa guute."
            }
          ]
        },
        {
          "number": "4",
          "text": "Miidhaginni isaa akkuma baʼiisa aduu ti;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gaanfawwan lama harka isaatii baʼu;"
            },
            {
              "source_marker": "q2",
              "text": "humni isaas achi dhokateera."
            }
          ]
        },
        {
          "number": "5",
          "text": "Fuula isaa dura dhaʼichatu deeme;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "golfaanis isa duukaa buʼe."
            }
          ]
        },
        {
          "number": "6",
          "text": "Inni dhaabatee lafa raase;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ilaalee akka saboonni hollatan godhe."
            },
            {
              "source_marker": "q1",
              "text": "Tulluuwwan durii ni burkutaaʼan;"
            },
            {
              "source_marker": "q2",
              "text": "gaarran bara hedduu jiraatanis ni diigaman."
            },
            {
              "source_marker": "q2",
              "text": "Karaan isaa kan bara baraa ti."
            }
          ]
        },
        {
          "number": "7",
          "text": "Ani utuu dunkaanonni Itoophiyaa dhiphatanuu nan arge;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "golgaawwan Midiyaaniis ni hollatu."
            }
          ]
        },
        {
          "number": "8",
          "text": "Yaa Waaqayyo, ati lageenitti aartee turtee?",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Burqaawwanittis dheekkamtee?"
            },
            {
              "source_marker": "q1",
              "text": "Ati yeroo fardeen keetiin guluftetti,"
            },
            {
              "source_marker": "q2",
              "text": "yeroo gaariiwwan moʼannaa kee yaabbatetti"
            },
            {
              "source_marker": "q2",
              "text": "galaanatti dheekkamtee turtee?"
            }
          ]
        },
        {
          "number": "9",
          "text": "Ati iddaa kee luqqifattee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "xiyya itti dhaabbatte."
            },
            {
              "source_marker": "q1",
              "text": "Lafas lageeniin gargar baqaqsite;"
            }
          ]
        },
        {
          "number": "10",
          "text": "tulluuwwan si arganii hollattan.",
          "source_markers_before": [
            "q2"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "Dhaʼaawwan bishaanii achiin darban;"
            },
            {
              "source_marker": "q2",
              "text": "tuujubni ni huurse;"
            },
            {
              "source_marker": "q2",
              "text": "dambalii isaas ol kaase."
            }
          ]
        },
        {
          "number": "11",
          "text": "Sababii xiyya kee calaqqisaa fiigu sanaatii fi",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "sababii ifa eeboo keetii sanaatiif aduu fi"
            },
            {
              "source_marker": "q2",
              "text": "jiʼi samii keessa dhaabatanii hafan."
            }
          ]
        },
        {
          "number": "12",
          "text": "Ati dheekkamsaan lafa irra marmaarte;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "aariidhaanis saboota lafatti dhidhiitte."
            }
          ]
        },
        {
          "number": "13",
          "text": "Ati saba kee furuuf,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "dibamaa kee oolchuuf dhufte."
            },
            {
              "source_marker": "q1",
              "text": "Hoogganaa biyya hamootaa ni daakte;"
            },
            {
              "source_marker": "q2",
              "text": "mataadhaa hamma miillaatti qullaa isa hambifte."
            }
          ]
        },
        {
          "number": "14",
          "text": "Yeroo loltoonni isaa nu bittinneessuuf kaʼanii,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akkuma waan rakkattoota dhokatanii jiran"
            },
            {
              "source_marker": "q1",
              "text": "fixuu gaʼaniitti gammadanitti,"
            },
            {
              "source_marker": "q2",
              "text": "ati eeboo ofii isaatiin mataa isaa waraante."
            }
          ]
        },
        {
          "number": "15",
          "text": "Ati fardeen keetiin bishaanota gurguddaa",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hoomacheessaa galaana irra deemte."
            }
          ]
        },
        {
          "number": "16",
          "text": "Ani dhagaʼeen garaan koo raafame;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hidhiin koo sagalee sanaan hollate;"
            },
            {
              "source_marker": "q1",
              "text": "tortorri lafee koo seene;"
            },
            {
              "source_marker": "q2",
              "text": "miilli koos ni hollate."
            },
            {
              "source_marker": "q1",
              "text": "Taʼus ani hamma guyyaan badiisaa"
            },
            {
              "source_marker": "q2",
              "text": "saboota nu weeraranitti dhufutti obsaan nan eeggadha."
            }
          ]
        },
        {
          "number": "17",
          "text": "Yoo mukni harbuu daraaruu baatee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "iji wayinii muka wayinii irra jiraachuu baate iyyuu,"
            },
            {
              "source_marker": "q1",
              "text": "yoo mukni ejersaa ija naqachuu didee"
            },
            {
              "source_marker": "q2",
              "text": "lafti qotiisaa midhaan dhowwate iyyuu,"
            },
            {
              "source_marker": "q1",
              "text": "yoo hoolonni gola keessaa,"
            },
            {
              "source_marker": "q2",
              "text": "loonis dallaa keessaa dhabaman iyyuu,"
            }
          ]
        },
        {
          "number": "18",
          "text": "ani garuu Waaqayyotti nan gammada;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Waaqa isa na fayyisutti nan gammada."
            }
          ]
        },
        {
          "number": "19",
          "text": "Waaqayyo Gooftaan jabina koo ti;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "inni miilla koo akka miilla borofaa godha;"
            },
            {
              "source_marker": "q2",
              "text": "lafa ol kaʼaa irras na deemsisa."
            },
            {
              "source_marker": "d",
              "text": "Dura buʼaa faarfannaatiif. Meeshaa koo kan ribuutiin kan faarfatame."
            }
          ]
        }
      ],
      "notes": [
        {
          "verse": "1",
          "marker": "Translator/editor note",
          "text": "+ Shigiyootiin it gosa muuziiqaa ti. it*",
          "note_type": "translator_note",
          "source_reference": "3:1"
        }
      ],
      "heading": [
        "Kadhannaa Anbaaqoom"
      ]
    }
  ]
}
