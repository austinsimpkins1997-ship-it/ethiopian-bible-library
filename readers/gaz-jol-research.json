  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "number": "1",
          "text": "Dubbii Waaqayyoo kan gara Yooʼeel ilma Phetuuʼeel dhufe.",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "2",
          "text": "Yaa maanguddoota, waan kana dhagaʼaa;",
          "source_markers_before": [
            "b",
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Weerara Hawwaannisaa"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "warri biyyattii keessa jiraattan hundinuu dhaggeeffadhaa."
            },
            {
              "source_marker": "q1",
              "text": "Wanni akkanaa takkumaa bara keessan keessa"
            },
            {
              "source_marker": "q2",
              "text": "yookaan bara abbootii keessanii keessa taʼee beekaa?"
            }
          ]
        },
        {
          "number": "3",
          "text": "Isin waan kana ijoollee keessanitti himaa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ijoolleen keessanis ijoollee ofii isaaniitti haa himan;"
            },
            {
              "source_marker": "q2",
              "text": "ijoolleen isaanii immoo dhaloota itti aanutti haa dabarsan."
            }
          ]
        },
        {
          "number": "4",
          "text": "Waan tuunni hawwaannisaa dhiise,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hawwaannisni guddaan fixe;"
            },
            {
              "source_marker": "q1",
              "text": "waan hawwaannisni guddaan dhiise,"
            },
            {
              "source_marker": "q2",
              "text": "hawwaannisni xixinnaan nyaatee fixe;"
            },
            {
              "source_marker": "q1",
              "text": "waan hawwaannisni xixinnaan dhiise immoo"
            },
            {
              "source_marker": "q2",
              "text": "hawwaannisni biraa dhufee nyaate."
            }
          ]
        },
        {
          "number": "5",
          "text": "Yaa machooftota, kaʼaatii booʼaa!",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Isin warri daadhii wayinii dhugdan // hundinuu wawwaadhaa;"
            },
            {
              "source_marker": "q1",
              "text": "sababii daadhii wayinii haaraatiif // wawwaadhaa;"
            },
            {
              "source_marker": "q2",
              "text": "inni afaan keessan irraa butameeraatii."
            }
          ]
        },
        {
          "number": "6",
          "text": "Sabni jabaan akka malee baayʼeen tokko",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "biyya koo weerareera;"
            },
            {
              "source_marker": "q1",
              "text": "inni ilkaan leencaa,"
            },
            {
              "source_marker": "q2",
              "text": "qarriffaa leenca dhalaa qaba."
            }
          ]
        },
        {
          "number": "7",
          "text": "Inni muka wayinii koo onsee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "harbuu koos barbadeesseera."
            },
            {
              "source_marker": "q1",
              "text": "Inni qola isaanii irraa quncisee lafatti gatee"
            },
            {
              "source_marker": "q2",
              "text": "dameelee isaanii duwwaa hambise."
            }
          ]
        },
        {
          "number": "8",
          "text": "Isin akkuma durba wayyaa gaddaa uffattee",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "dhirsa ijoollummaa isheetiif gaddituutti booʼaa."
            }
          ]
        },
        {
          "number": "9",
          "text": "Kennaan midhaaniitii fi dhibaayyuun",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "mana Waaqayyoo irraa citaniiru."
            },
            {
              "source_marker": "q1",
              "text": "Luboonni fuula Waaqayyoo dura tajaajilan"
            },
            {
              "source_marker": "q2",
              "text": "booʼaa jiru."
            }
          ]
        },
        {
          "number": "10",
          "text": "Lafti qotiisaa oneera;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "laftis gogeera;"
            },
            {
              "source_marker": "q1",
              "text": "midhaan barbadaaʼeera;"
            },
            {
              "source_marker": "q2",
              "text": "daadhiin wayinii haaraan dhumeera;"
            },
            {
              "source_marker": "q2",
              "text": "zayitiinis dhabameera."
            }
          ]
        },
        {
          "number": "11",
          "text": "Yaa qonnaan bultoota, isin raafamaa;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "warri wayinii dhaabbattan booʼaa;"
            },
            {
              "source_marker": "q1",
              "text": "sababii midhaan lafa qotiisaa keessanii"
            },
            {
              "source_marker": "q2",
              "text": "barbadaaʼeef qamadii fi garbuudhaaf booʼaa."
            }
          ]
        },
        {
          "number": "12",
          "text": "Wayiniin gogeera;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "harbuunis coollageera;"
            },
            {
              "source_marker": "q1",
              "text": "roomaaniin, meexxii fi hudhaan,"
            },
            {
              "source_marker": "q2",
              "text": "mukkeen lafa qotiisaa hundinuu goganiiru."
            },
            {
              "source_marker": "q1",
              "text": "Dhugumaan gammachuun ilmaan namaa"
            },
            {
              "source_marker": "q2",
              "text": "irraa badeera."
            }
          ]
        },
        {
          "number": "13",
          "text": "Yaa luboota, wayyaa gaddaa uffadhaatii booʼaa;",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Waamicha Qalbii Jijjiirrachuu"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isin warri iddoo aarsaa dura tajaajiltan wawwaadhaa."
            },
            {
              "source_marker": "q1",
              "text": "Isin warri fuula Waaqa koo dura tajaajiltan"
            },
            {
              "source_marker": "q2",
              "text": "kottaatii wayyaa gaddaa uffadhaa bulaa;"
            },
            {
              "source_marker": "q1",
              "text": "kennaan midhaaniitii fi dhibaayyuun"
            },
            {
              "source_marker": "q2",
              "text": "mana Waaqaa irraa hambifamaniiruutii."
            }
          ]
        },
        {
          "number": "14",
          "text": "Sooma qulqulluu labsaa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "waldaa qulqulluu waamaa."
            },
            {
              "source_marker": "q1",
              "text": "Maanguddootaa fi"
            },
            {
              "source_marker": "q2",
              "text": "warra biyyattii keessa jiraatan hunda"
            },
            {
              "source_marker": "q1",
              "text": "gara mana Waaqayyoo Waaqa keessaniitti waamaatii"
            },
            {
              "source_marker": "q2",
              "text": "Waaqayyootti booʼaa."
            }
          ]
        },
        {
          "number": "15",
          "text": "Badne kaa! Guyyaan sun dhiʼaateera.",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Guyyaan Waaqayyoo gaʼeeraatii;"
            },
            {
              "source_marker": "q2",
              "text": "inni akkuma badiisaatti // Waaqa Waan Hunda Dandaʼu biraa dhufa."
            }
          ]
        },
        {
          "number": "16",
          "text": "Ijuma keenya duratti",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "nyaanni cite;"
            },
            {
              "source_marker": "q1",
              "text": "ilillee fi gammachuunis"
            },
            {
              "source_marker": "q2",
              "text": "mana Waaqa keenyaa irraa hin cinnee?"
            }
          ]
        },
        {
          "number": "17",
          "text": "Sanyiin lafa keessatti",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "tortoree hafe."
            },
            {
              "source_marker": "q1",
              "text": "Mankuusni diigameera;"
            },
            {
              "source_marker": "q2",
              "text": "gombisaan caccabeera;"
            },
            {
              "source_marker": "q2",
              "text": "midhaan gogee hafeeraatii."
            }
          ]
        },
        {
          "number": "18",
          "text": "Loon akkam marʼatu!",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Karri loonii sababii waan dheedu dhabeef"
            },
            {
              "source_marker": "q1",
              "text": "asii fi achi joora;"
            },
            {
              "source_marker": "q2",
              "text": "bushaayeenis dhiphataniiru."
            }
          ]
        },
        {
          "number": "19",
          "text": "Yaa Waaqayyo ani sin waammadha;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ibiddi lafa dheedaa barbadeessee"
            },
            {
              "source_marker": "q2",
              "text": "arrabni ibiddaa immoo mukkeen diidaa hunda gubee fixeeraatii."
            }
          ]
        },
        {
          "number": "20",
          "text": "Bineensonni bosonaa sitti gaggabu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "lagni bishaanii gogeera;"
            },
            {
              "source_marker": "q2",
              "text": "ibiddis dirree dheedaa gubee balleesseera."
            }
          ]
        }
      ],
      "notes": []
    },
    {
      "chapter": 2,
      "verses": [
        {
          "number": "1",
          "text": "Xiyoon keessatti malakata afuufaa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gaara koo qulqulluu irratti sagalee // akeekkachiisaa dhageessisaa."
            },
            {
              "source_marker": "q1",
              "text": "Guyyaan Waaqayyoo dhufaa jiraatii;"
            },
            {
              "source_marker": "q2",
              "text": "warri lafa irra jiraatan hundi haa hollatan."
            },
            {
              "source_marker": "q1",
              "text": "Guyyaan sun dhiʼaateera;"
            }
          ]
        },
        {
          "number": "2",
          "text": "guyyaan dukkanaatii fi dimimmisaa,",
          "source_markers_before": [
            "b",
            "q2"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "guyyaan duumessaatii fi dukkana hamaa ni dhufa."
            },
            {
              "source_marker": "q1",
              "text": "Sabni guddaa fi jabaan tokko"
            },
            {
              "source_marker": "q2",
              "text": "akkuma ifa ganama tulluuwwan irratti baʼuutti ni dhufa;"
            },
            {
              "source_marker": "q1",
              "text": "wanni akkasii takkumaa bara durii keessa taʼee hin beeku"
            },
            {
              "source_marker": "q2",
              "text": "yookaan dhaloota dhufuuf jiru keessatti illee hin taʼu."
            }
          ]
        },
        {
          "number": "3",
          "text": "Fuula isaanii duraa ibiddi ni barbadeessa;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "dugda isaanii duubaan immoo arraba ibiddaatu bobaʼa."
            },
            {
              "source_marker": "q1",
              "text": "Fuula isaanii duraan lafti iddoo biqiltuu Eeden fakkaata;"
            },
            {
              "source_marker": "q2",
              "text": "dugda isaanii duubaan immoo lafti akkuma gammoojjii onee ti;"
            },
            {
              "source_marker": "q2",
              "text": "wanni tokko iyyuu isaan duraa hin miliqu."
            }
          ]
        },
        {
          "number": "4",
          "text": "Isaan bifa fardeenii qabu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akkuma fardeen lolaas ni gulufu."
            }
          ]
        },
        {
          "number": "5",
          "text": "Isaan sagalee akka gaarii waraanaatiin",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "fiixee tulluu irra utaalu;"
            },
            {
              "source_marker": "q1",
              "text": "akkuma ibidda yeroo qarmii gubutti xaaxaʼuu,"
            },
            {
              "source_marker": "q2",
              "text": "akkuma waraana jabaa lolaaf baʼe tokkoo ti."
            }
          ]
        },
        {
          "number": "6",
          "text": "Saboonni jara arginii dhiphatu;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "fuulli nama hundaas ni gurraachaʼa."
            }
          ]
        },
        {
          "number": "7",
          "text": "Isaan akkuma namoota jajjaboo fiigu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akkuma loltootaa dallaa yaabbatanii seenu."
            },
            {
              "source_marker": "q1",
              "text": "Hundi isaanii tarree galanii deemu;"
            },
            {
              "source_marker": "q2",
              "text": "isaan keessaa tokko iyyuu daandii isaa irraa hin jalʼatu."
            }
          ]
        },
        {
          "number": "8",
          "text": "Isaan wal hin dhiiban;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hundi isaanii qajeelanii fuula duratti deemu."
            },
            {
              "source_marker": "q1",
              "text": "Utuu toora isaanii hin dhiisin"
            },
            {
              "source_marker": "q2",
              "text": "ittisa cabsanii seenu."
            }
          ]
        },
        {
          "number": "9",
          "text": "Isaan magaalaa keessa asii fi achi fiigu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "dallaa irra fiigu."
            },
            {
              "source_marker": "q1",
              "text": "Isaan mana yaabbatu;"
            },
            {
              "source_marker": "q2",
              "text": "akkuma hattuus foddaadhaan ol seenu."
            }
          ]
        },
        {
          "number": "10",
          "text": "Fuula isaanii duratti lafti ni sochooti;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "samiin ni raafama;"
            },
            {
              "source_marker": "q1",
              "text": "aduu fi jiʼi ni dukkanaaʼu;"
            },
            {
              "source_marker": "q2",
              "text": "urjiiwwan deebiʼanii hin ibsan."
            }
          ]
        },
        {
          "number": "11",
          "text": "Waaqayyo fuula loltoota isaa duratti",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "sagalee dhageessisa;"
            },
            {
              "source_marker": "q1",
              "text": "loltoonni isaa akka malee baayʼee dha;"
            },
            {
              "source_marker": "q2",
              "text": "warri ajaja isaa eegan jajjaboo dha."
            },
            {
              "source_marker": "q1",
              "text": "Guyyaan Waaqayyoo guddaa dha;"
            },
            {
              "source_marker": "q2",
              "text": "guyyaan sun akka malee nama sodaachisa."
            },
            {
              "source_marker": "q2",
              "text": "Eenyutu dura dhaabachuu dandaʼa?"
            }
          ]
        },
        {
          "number": "12",
          "text": "“Amma iyyuu garaa guutuudhaan,",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Cubbuu Irraa Deebiʼaa"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "soomaan, booʼichaa fi gaddaan"
            },
            {
              "source_marker": "q2",
              "text": "gara kootti deebiʼaa” jedha Waaqayyo."
            }
          ]
        },
        {
          "number": "13",
          "text": "Isin utuu wayyaa keessan hin taʼin",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "garaa keessan tarsaasaa."
            },
            {
              "source_marker": "q1",
              "text": "Gara Waaqayyo Waaqa keessaniitti deebiʼaa;"
            },
            {
              "source_marker": "q2",
              "text": "inni arjaa fi gara laafessaatii;"
            },
            {
              "source_marker": "q1",
              "text": "inni dafee hin aaru; jaalalli isaa baayʼee dha;"
            },
            {
              "source_marker": "q2",
              "text": "inni badiisa erguu irraa of qusata."
            }
          ]
        },
        {
          "number": "14",
          "text": "Maaltu beeka? Tarii inni deebiʼee gaabbee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "eebba, kennaa midhaaniitii fi kennaa dhugaatii"
            },
            {
              "source_marker": "q1",
              "text": "kan Waaqayyo Waaqa keessaniif taʼu"
            },
            {
              "source_marker": "q2",
              "text": "isiniif hambisa taʼa."
            }
          ]
        },
        {
          "number": "15",
          "text": "Xiyoon keessatti malakata afuufaa;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "sooma qulqulluu labsaa;"
            },
            {
              "source_marker": "q2",
              "text": "waldaa qulqulluu waamaa."
            }
          ]
        },
        {
          "number": "16",
          "text": "Saba walitti qabaa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "waldaa sana qulqulleessaa;"
            },
            {
              "source_marker": "q1",
              "text": "maanguddoota walitti fidaa;"
            },
            {
              "source_marker": "q2",
              "text": "ijoollee walitti qabaa;"
            },
            {
              "source_marker": "q2",
              "text": "daaʼimman harma hodhan illee hin hambisinaa."
            },
            {
              "source_marker": "q1",
              "text": "Misirrichi kutaa isaa keessaa haa baʼu;"
            },
            {
              "source_marker": "q2",
              "text": "misirrittiinis diinqa isheetii haa baatu."
            }
          ]
        },
        {
          "number": "17",
          "text": "Luboonni fuula Waaqayyoo dura tajaajilan",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gardaafoo fi iddoo aarsaa gidduutti haa booʼan."
            },
            {
              "source_marker": "q1",
              "text": "Isaan akkana haa jedhan; “Yaa Waaqayyo saba kee baraari."
            },
            {
              "source_marker": "q2",
              "text": "Handhuuraa kee waan qoosaa,"
            },
            {
              "source_marker": "q2",
              "text": "saboota gidduuttis waan kolfaa hin godhin."
            },
            {
              "source_marker": "q1",
              "text": "Isaan maaliif namoota gidduutti,"
            },
            {
              "source_marker": "q2",
              "text": "‘Waaqni isaanii eessa jira?’ jedhu?”"
            }
          ]
        },
        {
          "number": "18",
          "text": "Waaqayyo biyya isaatiif ni hinaafa;",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Deebii Waaqayyo Kenne"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "saba isaatiifis garaa laafa."
            }
          ]
        },
        {
          "number": "19",
          "text": "Waaqayyo akkana jedhee deebii kennaaf:",
          "source_markers_before": [
            "p"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "“Ani midhaan, daadhii wayinii haaraa fi zayitii ejersaa"
            },
            {
              "source_marker": "q2",
              "text": "kan isin quubsu isiniif nan erga;"
            },
            {
              "source_marker": "q1",
              "text": "ani lammata saboota gidduutti"
            },
            {
              "source_marker": "q2",
              "text": "waan qoosaa isin hin godhu."
            }
          ]
        },
        {
          "number": "20",
          "text": "“Ani loltoota kaabaa isin duraa balleessee",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gara lafa gogaa fi duwwaatti isaan ariʼa;"
            },
            {
              "source_marker": "q1",
              "text": "loltoonni fuula duraan yaaʼan galaana baʼa biiftuu,"
            },
            {
              "source_marker": "q2",
              "text": "kanneen dugda duubaan yaaʼan immoo // galaana gama lixa biiftuu seenu."
            },
            {
              "source_marker": "q1",
              "text": "Reeffi isaanii ni xiraaʼa;"
            },
            {
              "source_marker": "q2",
              "text": "xiraan isaaniis ol baʼa.”"
            },
            {
              "source_marker": "q1",
              "text": "Dhugumaan inni waan guddaa hojjeteera!"
            }
          ]
        },
        {
          "number": "21",
          "text": "Yaa biyya Yihuudaa, hin sodaatin;",
          "source_markers_before": [
            "b",
            "q2"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gammadiitii ililchi."
            },
            {
              "source_marker": "q1",
              "text": "Waaqayyo dhugumaan waan guddaa hojjeteera!"
            }
          ]
        },
        {
          "number": "22",
          "text": "Yaa bineensota bosonaa, isinis hin sodaatinaa;",
          "source_markers_before": [
            "q2"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "dirreen dheedaa gabbachaa jiraatii."
            },
            {
              "source_marker": "q1",
              "text": "Mukkeen ija naqachaa,"
            },
            {
              "source_marker": "q2",
              "text": "harbuu fi wayiniinis ija kennaa jiru."
            }
          ]
        },
        {
          "number": "23",
          "text": "Yaa uummata Xiyoon gammadi;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Waaqayyo Waaqa keetti gammadi;"
            },
            {
              "source_marker": "q1",
              "text": "inni qajeelummaadhaan"
            },
            {
              "source_marker": "q2",
              "text": "rooba arfaasaa siif kenneeraatii."
            },
            {
              "source_marker": "q1",
              "text": "Inni akkuma durii bokkaa baayʼee,"
            },
            {
              "source_marker": "q2",
              "text": "rooba arfaasaa fi kan birraa siif erga."
            }
          ]
        },
        {
          "number": "24",
          "text": "Oobdiin midhaaniin guutama;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "boolli itti wayinii cuunfanis daadhii wayinii haaraa fi // zayitiidhaan guutamanii dhangalaasu."
            }
          ]
        },
        {
          "number": "25",
          "text": "“Ani waan bara hawwaannisni nyaate,",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "waan hawwaannisni gurguddaa fi xixinnaan nyaate,"
            },
            {
              "source_marker": "q2",
              "text": "waan hawwaannisni kaanii fi tuunni hawwaannisaa"
            },
            {
              "source_marker": "q1",
              "text": "jechuunis loltoonni koo jajjaboon ani gidduu keessanitti erge sun nyaatan // iddoo isiniif nan buusa."
            }
          ]
        },
        {
          "number": "26",
          "text": "Isin waan hamma quuftanitti nyaattan baayʼee ni qabaattu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "maqaa Waaqayyo Waaqa keessanii"
            },
            {
              "source_marker": "q2",
              "text": "kan waan dinqii isiniif hojjete sanaa ni galateeffattu;"
            },
            {
              "source_marker": "q1",
              "text": "uummanni koo lammata hin qaaneffamu."
            }
          ]
        },
        {
          "number": "27",
          "text": "Ergasii isin akka ani Israaʼel keessa jiru",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka ani Waaqayyo Waaqa keessan taʼe,"
            },
            {
              "source_marker": "q2",
              "text": "akka ana malee Waaqni biraa hin jirre ni beektu;"
            },
            {
              "source_marker": "q1",
              "text": "uummanni koo lammata hin qaaneffamu."
            }
          ]
        },
        {
          "number": "28",
          "text": "“Anis kana booddee,",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Guyyaa Waaqayyoo"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Hafuura koo nama hunda irratti nan dhangalaasa."
            },
            {
              "source_marker": "q1",
              "text": "Ilmaanii fi intallan keessan raajii dubbatu;"
            },
            {
              "source_marker": "q2",
              "text": "jaarsoliin keessan abjuu abjootu;"
            },
            {
              "source_marker": "q2",
              "text": "dargaggoonni keessan mulʼata argu."
            }
          ]
        },
        {
          "number": "29",
          "text": "Bara sana keessa, garboota koo",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "warra dhiiraa fi dubartii irratti illee"
            },
            {
              "source_marker": "q2",
              "text": "Hafuura koo nan dhangalaasa."
            }
          ]
        },
        {
          "number": "30",
          "text": "Ani ol samii irratti dinqii,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gad lafa irrattis dhiiga,"
            },
            {
              "source_marker": "q2",
              "text": "ibiddaa fi hurrii aaraa nan argisiisa."
            }
          ]
        },
        {
          "number": "31",
          "text": "Utuu guyyaan Waaqayyoo inni guddichii fi",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "sodaachisaan sun hin dhufin dura,"
            },
            {
              "source_marker": "q2",
              "text": "aduun dukkanatti geeddaramti;"
            },
            {
              "source_marker": "q2",
              "text": "jiʼi immoo dhiigatti geeddarama."
            }
          ]
        },
        {
          "number": "32",
          "text": "Namni maqaa Waaqayyoo waammatu",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hundinuu ni fayya;"
            },
            {
              "source_marker": "q1",
              "text": "akkuma Waaqayyo dubbatettis"
            },
            {
              "source_marker": "q2",
              "text": "Tulluu Xiyoon irraa fi"
            },
            {
              "source_marker": "q2",
              "text": "Yerusaalem keessa, furamatu jiraata;"
            },
            {
              "source_marker": "q1",
              "text": "hambaa gidduuttis warri Waaqayyo"
            },
            {
              "source_marker": "q2",
              "text": "isaan waame ni argamu."
            }
          ]
        }
      ],
      "notes": [],
      "heading": [
        "Raayyaa Hawwaanisaa"
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "number": "1",
          "text": "“Bara sana keessa, yeroo sanatti,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ani yommuun boojuu Yihuudaatii fi // Yerusaalem deebisutti,"
            }
          ]
        },
        {
          "number": "2",
          "text": "saboota hunda walitti qabeen",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gara Sulula Yehooshaafaaxitti // gad isaan nan buusa."
            },
            {
              "source_marker": "q1",
              "text": "Anis achitti sababii dhaala koo,"
            },
            {
              "source_marker": "q2",
              "text": "sababii Israaʼeliif isaanitti nan mura;"
            },
            {
              "source_marker": "q1",
              "text": "isaan saboota gidduutti saba koo"
            },
            {
              "source_marker": "q2",
              "text": "bittinneessanii biyya koos gargar qooddataniiruutii."
            }
          ]
        },
        {
          "number": "3",
          "text": "Isaan uummata kootti ixaa buufatanii",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ijoollee dhiiraas sagaagalummaatti geeddarataniiru;"
            },
            {
              "source_marker": "q2",
              "text": "akka dhuganiif dubara illee daadhii wayiniitti gurguratan."
            }
          ]
        },
        {
          "number": "4",
          "text": "“Yaa Xiiroosii fi Siidoonaa, isin kutaaleen Filisxeem hundinuu, amma maal narraa qabdu? Isin waan ani godheef haaloo na baafachaa jirtuu? Yoo isin haaloo na baafachaa jirtu taʼe ani dafee ariitiidhaan waan isin hojjettan sana matuma keessanittin deebisa.",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "5",
          "text": "Isin meetii fi warqee koo guurrattanii qabeenya koo filatamaas mana waaqeffannaa keessanitti geeffattaniirtuutii."
        },
        {
          "number": "6",
          "text": "Isin biyya isaanii irraa isaan fageessitanii uummata Yihuudaatii fi Yerusaalem Giriikotatti gurgurattan."
        },
        {
          "number": "7",
          "text": "“Kunoo, ani biyya isin itti isaan gurgurattan keessaa isaan baasee waan isin hojjettan sana matuma keessanitti nan deebisa.",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "8",
          "text": "Ani ilmaanii fi intallan keessan saba Yihuudaatti nan gurgura; isaan immoo saba fagoo jiru kan Saabaa jedhamutti dabarsanii isaan gurguratu.” Waaqayyo dubbateeraatii."
        },
        {
          "number": "9",
          "text": "Waan kana saboota gidduutti labsaa:",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Waraanaaf qophaaʼaa!"
            },
            {
              "source_marker": "q1",
              "text": "Gootota kakaasaa!"
            },
            {
              "source_marker": "q2",
              "text": "Loltoonni hundi dhiʼaatanii haa lolan."
            }
          ]
        },
        {
          "number": "10",
          "text": "Maarashaa keessan tumaatii goraadee godhadhaa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "haamtuu keessanis tumaatii eeboo godhadhaa."
            },
            {
              "source_marker": "q1",
              "text": "Namni laafaan,"
            },
            {
              "source_marker": "q2",
              "text": "“Ani jabaa dha!” haa jedhu."
            }
          ]
        },
        {
          "number": "11",
          "text": "Isin saboonni qixa hundaan dafaa kottaattii",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "achitti walitti qabamaa."
            },
            {
              "source_marker": "q1",
              "text": "Yaa Waaqayyo, loltoota kee gad ergi!"
            }
          ]
        },
        {
          "number": "12",
          "text": "“Saboonni haa kaʼan;",
          "source_markers_before": [
            "b",
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isaan dafanii gara Sulula Yehooshaafaax haa dhufan;"
            },
            {
              "source_marker": "q1",
              "text": "ani saboota gama hundaan jiranitti muruuf"
            },
            {
              "source_marker": "q2",
              "text": "achi nan taaʼaatii."
            }
          ]
        },
        {
          "number": "13",
          "text": "Midhaan gaʼeeraatii",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "haamtuu itti kaaʼaa."
            },
            {
              "source_marker": "q1",
              "text": "Kottaatii ija wayinii dhidhiitaa;"
            },
            {
              "source_marker": "q2",
              "text": "boolli itti wayinii cuunfan guuteeraatii;"
            },
            {
              "source_marker": "q2",
              "text": "sababii hamminni isaanii guddaa taʼeef"
            },
            {
              "source_marker": "q1",
              "text": "boolli itti wayinii cuunfan guutee irra dhangalaʼeera!”"
            }
          ]
        },
        {
          "number": "14",
          "text": "Waldaan guddaan, waldaan nama baayʼee",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "sulula murtii keessatti wal gaʼeera!"
            },
            {
              "source_marker": "q1",
              "text": "Guyyaan Waaqayyoo"
            },
            {
              "source_marker": "q2",
              "text": "sulula murtii keessatti dhufuu gaʼeeraatii."
            }
          ]
        },
        {
          "number": "15",
          "text": "Biiftuu fi addeessi ni dukkanaaʼu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "urjiiwwanis siʼachi ifa hin kennan."
            }
          ]
        },
        {
          "number": "16",
          "text": "Waaqayyo Xiyoon irraa ni iyya;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Yerusaalem keessaas sagalee dhageessisa;"
            },
            {
              "source_marker": "q2",
              "text": "lafaa fi samiin ni raafamu."
            },
            {
              "source_marker": "q1",
              "text": "Waaqayyo garuu saba isaatiif iddoo itti baqatan,"
            },
            {
              "source_marker": "q2",
              "text": "saba Israaʼeliif immoo daʼoo ni taʼa."
            }
          ]
        },
        {
          "number": "17",
          "text": "“Ergasii isin akka ani Waaqayyo Waaqni keessan Xiyoon keessa,",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Eebba Saba Waaqaatiif kenname"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gaara koo qulqulluu sana irra jiraadhu ni beektu."
            },
            {
              "source_marker": "q1",
              "text": "Yerusaalem qulqulluu taati;"
            },
            {
              "source_marker": "q2",
              "text": "namoonni biyya alaa gonkumaa lammata ishee hin weeraran."
            }
          ]
        },
        {
          "number": "18",
          "text": "“Gaafas tulluuwwan daadhii wayinii haaraa ni coccobsu;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
