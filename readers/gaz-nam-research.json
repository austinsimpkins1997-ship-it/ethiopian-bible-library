  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "number": "1",
          "text": "Raajii waaʼee Nanawwee dubbatame. Kitaaba mulʼata Naahoom Elqooshicha.",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "2",
          "text": "Waaqayyo Waaqa hinaafuu fi Waaqa haaloo baʼuu dha;",
          "source_markers_before": [
            "b",
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "Dheekkamsa Waaqayyoo Nanawweetti Dheekkame"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Waaqayyo haaloo ni baʼa; dheekkamsaanis guutameera."
            },
            {
              "source_marker": "q1",
              "text": "Waaqayyo diinota isaa haaloo ni baʼa;"
            },
            {
              "source_marker": "q2",
              "text": "dheekkamsa isaas amajaajota isaatiif ni kuusa."
            }
          ]
        },
        {
          "number": "3",
          "text": "Waaqayyo dheekkamuuf hin jarjaru; humni isaa immoo guddaa dha;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Waaqayyo nama balleessaa qabu utuu hin adabin hin dhiisu."
            },
            {
              "source_marker": "q1",
              "text": "Bubbee hamaa fi dhaʼaa galaanaa keessaas karaa qaba;"
            },
            {
              "source_marker": "q2",
              "text": "duumessi immoo awwaara miilla isaa ti."
            }
          ]
        },
        {
          "number": "4",
          "text": "Inni galaanatti dheekkamee gogsa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka lagni hundinuu gogu godha."
            },
            {
              "source_marker": "q1",
              "text": "Baashaanii fi Qarmeloos ni coollagu;"
            },
            {
              "source_marker": "q2",
              "text": "daraaraa Libaanoonis ni harcaʼa."
            }
          ]
        },
        {
          "number": "5",
          "text": "Fuula isaa duratti tulluuwwan ni kirkiru;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gaarranis baqanii badu."
            },
            {
              "source_marker": "q1",
              "text": "Iddoo inni jirutti lafti ni hollatti;"
            },
            {
              "source_marker": "q2",
              "text": "addunyaa fi wanni addunyaa irra jiraatu hundi ni hollatu."
            }
          ]
        },
        {
          "number": "6",
          "text": "Eenyutu dheekkamsa isaa dura dhaabachuu dandaʼa?",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Eenyutu dheekkamsa isaa sodaachisaa sana obsuu dandaʼa?"
            },
            {
              "source_marker": "q1",
              "text": "Dheekkamsi isaa akkuma ibiddaa dhangalaʼa;"
            },
            {
              "source_marker": "q2",
              "text": "fuula isaa duratti kattaawwan ni burkutaaʼu."
            }
          ]
        },
        {
          "number": "7",
          "text": "Waaqayyo gaarii dha;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "yeroo rakkinaattis daʼoo dha."
            },
            {
              "source_marker": "q1",
              "text": "Inni warra isa amanatan ni beeka;"
            }
          ]
        },
        {
          "number": "8",
          "text": "Garuu inni lolaa jabaadhaan",
          "source_markers_before": [
            "q2"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "Nanawwee ni balleessa;"
            },
            {
              "source_marker": "q2",
              "text": "amajaajota isaas ariʼee dukkanatti galcha."
            }
          ]
        },
        {
          "number": "9",
          "text": "Wanni isin Waaqayyootti yaaddan maali?",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "inni guutumaan guutuutti ni balleessa;"
            },
            {
              "source_marker": "q2",
              "text": "rakkoonis lammata hin dhufu."
            }
          ]
        },
        {
          "number": "10",
          "text": "Isaan qoraattii keessatti xaxamanii",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "daadhii wayinii isaaniitiin machaaʼu;"
            },
            {
              "source_marker": "q2",
              "text": "akkuma cidii gogeetti gubatanii dhumu."
            }
          ]
        },
        {
          "number": "11",
          "text": "Yaa Nanawwee,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "namni Waaqayyotti hammina malatee"
            },
            {
              "source_marker": "q2",
              "text": "waan hamaa karoorfatu si keessaa argameera."
            }
          ]
        },
        {
          "number": "12",
          "text": "Waaqayyo akkana jedha:",
          "source_markers_before": [
            "p"
          ],
          "continuations": [
            {
              "source_marker": "q1",
              "text": "“Isaan jabinaa fi baayʼina yoo qabaatan iyyuu"
            },
            {
              "source_marker": "q2",
              "text": "isaan ni barbadeeffamu; ni badus."
            },
            {
              "source_marker": "q1",
              "text": "Yaa Yihuudaa, ani yoon duraan si miidhee"
            },
            {
              "source_marker": "q2",
              "text": "jiraadhe iyyuu, siʼachi si hin miidhu."
            }
          ]
        },
        {
          "number": "13",
          "text": "Ani amma waanjoo isaanii gurmuu keessan irraa nan cabsa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "hudhaa kees sirraa nan kuta.”"
            }
          ]
        },
        {
          "number": "14",
          "text": "Yaa Nanawwee, Waaqayyo akkana jedhee waaʼee kee ajaja kennee jira:",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "“Ati sanyii maqaan kee ittiin waamamu hin qabaattu."
            },
            {
              "source_marker": "q1",
              "text": "Ani fakkiiwwan soofamanii fi waaqota tolfamoo baqfamanii tolfaman"
            },
            {
              "source_marker": "q2",
              "text": "kanneen galmawwan waaqota keetii keessa jiran nan barbadeessa."
            },
            {
              "source_marker": "q1",
              "text": "Waan ati akka malee balfamaa taateef"
            },
            {
              "source_marker": "q2",
              "text": "ani awwaala siif nan qopheessa.”"
            }
          ]
        },
        {
          "number": "15",
          "text": "Kunoo, miilli nama oduu gaarii fidu,",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kan nagaa labsu tokkoo tulluuwwan irra jira!"
            },
            {
              "source_marker": "q1",
              "text": "Yaa Yihuudaa, ayyaanota kee ayyaaneffadhu;"
            },
            {
              "source_marker": "q2",
              "text": "wareega kees baafadhu."
            },
            {
              "source_marker": "q1",
              "text": "Siʼachi hamaan si hin weeraru;"
            },
            {
              "source_marker": "q2",
              "text": "inni guutumaan guutuutti ni barbadeeffama."
            }
          ]
        }
      ],
      "notes": []
    },
    {
      "chapter": 2,
      "verses": [
        {
          "number": "1",
          "text": "Yaa Nanawwee, namni si lolu sitti dhufeera.",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Daʼoo eeggadhu;"
            },
            {
              "source_marker": "q2",
              "text": "karaa ilaalladhu."
            },
            {
              "source_marker": "q2",
              "text": "Mudhii kee hidhadhu;"
            },
            {
              "source_marker": "q2",
              "text": "humna kee hunda walitti qabadhu!"
            }
          ]
        },
        {
          "number": "2",
          "text": "Yoo balleessitoonni isaan onsanii",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "mukkeen wayinii isaanii barbadeessan iyyuu,"
            },
            {
              "source_marker": "q1",
              "text": "Waaqayyo akkuma ulfina Israaʼel deebise sana"
            },
            {
              "source_marker": "q2",
              "text": "ulfina Yaaqoobis iddootti ni deebisa."
            }
          ]
        },
        {
          "number": "3",
          "text": "Gaachanawwan loltoota isaa diddiimoo dha;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "gootonnis uffata bildiimaa uffataniiru."
            },
            {
              "source_marker": "q1",
              "text": "Guyyaa isaan itti qopheeffaman sana,"
            },
            {
              "source_marker": "q2",
              "text": "sibiilli gaarii lolaa irra jiru ni calaqqisa;"
            },
            {
              "source_marker": "q2",
              "text": "eeboon gaattiraa isaaniis ni mirmirfama."
            }
          ]
        },
        {
          "number": "4",
          "text": "Gaariiwwan lolaa karaa irra dadarbatamu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "oobdiiwwan keessas asii fi achi gulufu."
            },
            {
              "source_marker": "q1",
              "text": "Isaan guca bobaʼu fakkaatu;"
            },
            {
              "source_marker": "q2",
              "text": "akkuma bakakkaas ni darbatamu."
            }
          ]
        },
        {
          "number": "5",
          "text": "Inni gootota isaa ni yaadata;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isaan garuu karaatti gufatu."
            },
            {
              "source_marker": "q1",
              "text": "Isaan gara dallaa magaalattiitti ariifatu;"
            },
            {
              "source_marker": "q2",
              "text": "daʼoonis qopheeffameefii jira."
            }
          ]
        },
        {
          "number": "6",
          "text": "Balballi lageenii banamaa dha;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "masaraan mootummaas ni jiga."
            }
          ]
        },
        {
          "number": "7",
          "text": "Magaalattiin qullaatti hambaa",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka boojiʼamtu murteeffameera."
            },
            {
              "source_marker": "q1",
              "text": "Xomboreewwan ishee"
            },
            {
              "source_marker": "q2",
              "text": "qoma isaanii rurrukutanii akka gugee booʼu."
            }
          ]
        },
        {
          "number": "8",
          "text": "Nanawween akkuma haroo ti;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "bishaan ishees keessaa yaaʼee dhuma."
            },
            {
              "source_marker": "q1",
              "text": "Isaanis, “Dhaabadhaa! Dhaabadhaa!” jedhanii iyyu;"
            },
            {
              "source_marker": "q2",
              "text": "garuu namni tokko iyyuu dugda duubatti hin deebiʼu."
            }
          ]
        },
        {
          "number": "9",
          "text": "Meetii saamaa!",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Warqee saamaa!"
            },
            {
              "source_marker": "q1",
              "text": "Maddi ishee, badhaadhummaan"
            },
            {
              "source_marker": "q2",
              "text": "kuusaa qabeenya ishee hundaas dhuma hin qabu!"
            }
          ]
        },
        {
          "number": "10",
          "text": "Isheen duwwaa, qullaa fi ona taateerti!",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Lapheen baqeera; jilbi laafeera;"
            },
            {
              "source_marker": "q2",
              "text": "dhagni hollateera; fuulli hundis gurraachaʼeera."
            }
          ]
        },
        {
          "number": "11",
          "text": "Holqi leencotaa,",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "iddoon isaan itti ilmaan isaanii sooran,"
            },
            {
              "source_marker": "q1",
              "text": "iddoon leenci kormaa fi dhalaan keessa yaaʼan,"
            },
            {
              "source_marker": "q2",
              "text": "saafelli isaanis sodaa malee nagaadhaan jiraatan eessa?"
            }
          ]
        },
        {
          "number": "12",
          "text": "Leenci waan ilmaan isaatiif gaʼu ajjeefate;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "leenca dhalaa isaatiifis waa hudhee ajjeese;"
            },
            {
              "source_marker": "q1",
              "text": "boolla isaa waan adamseen,"
            },
            {
              "source_marker": "q2",
              "text": "holqa isaa immoo gumaa fooniitiin guuttate."
            }
          ]
        },
        {
          "number": "13",
          "text": "Waaqayyo Waan Hunda Dandaʼu akkana jedha;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "“Ani sitti kaʼeera;"
            },
            {
              "source_marker": "q1",
              "text": "ani gaariiwwan kee kanneen waraanaa gubee daaraa nan godha;"
            },
            {
              "source_marker": "q2",
              "text": "goraadeen leenca kee saafela ni fixa."
            },
            {
              "source_marker": "q1",
              "text": "Ani waan ati adamsattu tokko illee"
            },
            {
              "source_marker": "q2",
              "text": "lafa irratti siif hin hambisu."
            },
            {
              "source_marker": "q1",
              "text": "Sagaleen ergamoota keetii"
            },
            {
              "source_marker": "q2",
              "text": "lammata hin dhagaʼamu.”"
            }
          ]
        }
      ],
      "notes": [],
      "heading": [
        "Kufaatii Nanawwee"
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "number": "1",
          "text": "Magaalattii dhiigaatiif,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kan sobaan guutamteef,"
            },
            {
              "source_marker": "q1",
              "text": "kan saamichaan guutamteef,"
            },
            {
              "source_marker": "q2",
              "text": "kan warri hammina hojjetan keessaa // hin dhabamne sanaaf wayyoo!"
            }
          ]
        },
        {
          "number": "2",
          "text": "Iyyi qaccee,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kakaksuun gommaa,"
            },
            {
              "source_marker": "q1",
              "text": "gulufuun fardaa,"
            },
            {
              "source_marker": "q2",
              "text": "didichuun gaarii lolaa ni dhagaʼama!"
            }
          ]
        },
        {
          "number": "3",
          "text": "Abbaan fardaa ni gulufa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "goraadeen ni balaqqisa;"
            },
            {
              "source_marker": "q2",
              "text": "eeboon ni calaqqisa!"
            },
            {
              "source_marker": "q1",
              "text": "Balaan hedduun nama irra gaʼeera;"
            },
            {
              "source_marker": "q2",
              "text": "namni baayʼeen duʼeera;"
            },
            {
              "source_marker": "q1",
              "text": "reeffi lakkoobsa hin qabu;"
            },
            {
              "source_marker": "q2",
              "text": "namoonnis reeffa isaaniitti gufatu;"
            }
          ]
        },
        {
          "number": "4",
          "text": "kun hundi sababii baayʼina sagaagalummaa sagaagaltuu,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "giiftii falfaltootaa,"
            },
            {
              "source_marker": "q1",
              "text": "kan sagaagaltummaa isheetiin saboota,"
            },
            {
              "source_marker": "q2",
              "text": "tolcha isheetiin immoo uummata garboomsite sanaatiin taʼe."
            }
          ]
        },
        {
          "number": "5",
          "text": "Waaqayyo Waan Hunda Dandaʼu akkana jedha:",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "“Ani sitti kaʼeen jira."
            },
            {
              "source_marker": "q2",
              "text": "Ani uffata kee fuula keetti ol soqola."
            },
            {
              "source_marker": "q1",
              "text": "Ani sabootatti qullaa kee,"
            },
            {
              "source_marker": "q2",
              "text": "mootummootatti immoo qaanii kee nan mulʼisa."
            }
          ]
        },
        {
          "number": "6",
          "text": "Ani xuriidhaan sin faala;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "akka malee sin tuffadha;"
            },
            {
              "source_marker": "q2",
              "text": "waan kolfaa illee sin godha."
            }
          ]
        },
        {
          "number": "7",
          "text": "Namni si argu hundi sirraa baqatee,",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "‘Nanawween baduutti jirti; eenyutu booʼaaf?’ siin jedha."
            },
            {
              "source_marker": "q2",
              "text": "Ani nama si jajjabeessu tokko illee eessaa argadha?”"
            }
          ]
        },
        {
          "number": "8",
          "text": "Ati, Nooʼi Amoon",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "biyya laga Abbayyaa irraa"
            },
            {
              "source_marker": "q2",
              "text": "kan bishaaniin marfamte sana caaltaa?"
            },
            {
              "source_marker": "q1",
              "text": "Lagni daʼoo ishee ti;"
            },
            {
              "source_marker": "q2",
              "text": "bishaanis dallaa ishee ti."
            }
          ]
        },
        {
          "number": "9",
          "text": "Itoophiyaa fi Gibxi jabina ishee kan dhuma hin qabnee dha;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "Fuuxii fi Liibiyaan tumsitoota ishee ti."
            }
          ]
        },
        {
          "number": "10",
          "text": "Taʼus isheen boojiʼamtee",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "biyya ormaatti geeffamte."
            },
            {
              "source_marker": "q1",
              "text": "Daaʼimman ishee mataa daandii hundaa irratti"
            },
            {
              "source_marker": "q2",
              "text": "miciriqfamanii dhuman."
            },
            {
              "source_marker": "q1",
              "text": "Namoota ishee ulfaatootti ixaa buufatanii"
            },
            {
              "source_marker": "q2",
              "text": "namoonni ishee gurguddoonni hundinuu // foncaadhaan hidhaman."
            }
          ]
        },
        {
          "number": "11",
          "text": "Atis ni machoofta; ni dhokattas;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "diina jalaa baʼuufis daʼoo barbaaddatta."
            }
          ]
        },
        {
          "number": "12",
          "text": "Daʼoon kee hundi mukkeen harbuu",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "kanneen ija jalqabatti bilchaate qaban fakkaata;"
            },
            {
              "source_marker": "q1",
              "text": "yeroo mukkeen sun hurgufamanitti"
            },
            {
              "source_marker": "q2",
              "text": "iji isaanii afaan nama waa nyaatuu keessa buʼa."
            }
          ]
        },
        {
          "number": "13",
          "text": "Mee raayyaawwan kee ilaali;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "isaan hundinuu dubartoota!"
            },
            {
              "source_marker": "q1",
              "text": "Karrawwan biyya keetii diinota keetiif"
            },
            {
              "source_marker": "q2",
              "text": "balʼatanii banamanii jiru;"
            },
            {
              "source_marker": "q2",
              "text": "ibiddis danqaraa isaanii gubee fixeera."
            }
          ]
        },
        {
          "number": "14",
          "text": "Utuu hin marfamin bishaan waraabbadhu;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "humna hittisaa kee jajjabeeffadhu!"
            },
            {
              "source_marker": "q1",
              "text": "Suphee tolfadhu;"
            },
            {
              "source_marker": "q2",
              "text": "dhoqqee suphee dhiittadhu;"
            },
            {
              "source_marker": "q2",
              "text": "xuubii tolfadhu."
            }
          ]
        },
        {
          "number": "15",
          "text": "Achitti ibiddi si fixa;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "goraadeenis si cicciree"
            },
            {
              "source_marker": "q2",
              "text": "akkuma korophisaas si barbadeessa."
            },
            {
              "source_marker": "q1",
              "text": "Akka korophisaa hori;"
            },
            {
              "source_marker": "q2",
              "text": "akkuma hawwaannisaa baayʼadhu."
            }
          ]
        },
        {
          "number": "16",
          "text": "Ati hamma isaan urjii samii caalaa",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "baayʼatanitti daldaltoota kee baayʼifatteerta;"
            },
            {
              "source_marker": "q1",
              "text": "isaan garuu akkuma hawwaannisaa biyyatii qullaa hambisanii"
            },
            {
              "source_marker": "q2",
              "text": "ergasii barrisanii deemu."
            }
          ]
        },
        {
          "number": "17",
          "text": "Eegdonni kee akkuma hawwaannisaa ti;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "qondaaltonni kees akkuma tuuta hawwaannisaa"
            },
            {
              "source_marker": "q2",
              "text": "kan guyyaa qabbanaa dallaa irra qubatuu ti;"
            },
            {
              "source_marker": "q1",
              "text": "yeroo aduun baatu garuu barrisanii badu;"
            },
            {
              "source_marker": "q2",
              "text": "namni tokko iyyuu gara isaan dhaqan hin beeku."
            }
          ]
        },
        {
          "number": "18",
          "text": "Yaa mootii Asoor tiksoonni kee ni mugu;",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "namoonni kee ulfaatoon boqochuuf gad ciciisaniiru."
            },
            {
              "source_marker": "q1",
              "text": "Namoonni kee nama walitti isaan qabu dhabanii"
            },
            {
              "source_marker": "q2",
              "text": "tulluuwwan irratti bibittinnaaʼaniiru."
            }
          ]
        },
        {
          "number": "19",
          "text": "Wanni tokko iyyuu madaa kee fayyisuu hin dandaʼu;",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "miidhamni kees kan duʼaan si gaʼuu dha."
            },
            {
              "source_marker": "q1",
              "text": "Namni oduu waaʼee keetii dhagaʼu hundinuu"
            },
            {
              "source_marker": "q2",
              "text": "kufaatii keetti harka walitti rurrukuta;"
            },
            {
              "source_marker": "q1",
              "text": "gara jabina kee kan dhuma hin qabne sanaan"
            },
            {
              "source_marker": "q2",
              "text": "eenyutu hin miidhamin?"
            }
          ]
        }
      ],
      "notes": [],
      "heading": [
        "Nanawweef Wayyoo"
      ]
    }
  ]
}
