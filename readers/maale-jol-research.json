      "verses": [
        {
          "number": "1",
          "text": "ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "«ዬኖ ዎዶና ዬሩሳላሜና ዪሁዳናፓ ዲዒንቴ ባኮንታ ዓሶንታ ታኣኒ ጊንሣ ማሃንዳኔ፤"
            }
          ]
        },
        {
          "number": "2",
          "text": "ዒማና ሜሌ ዴሮ ቢያ ታኣኒ ቡኩሲ",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዒዮሳፒፄ ዶኦጮ ኬይሳንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ታኣሮ ማዔ ዒስራዔኤሌ ዴሮ"
            },
            {
              "source_marker": "q2",
              "text": "ዔያቶ ባኣካ ዔያታ ዜርቂ ሳዖዋ ጊሽቲ ዔኬሢሮ"
            },
            {
              "source_marker": "q2",
              "text": "ዒዮሳፒፄ ዶኦጮይዳ ፑርታ ዎጌ ዔያቶይዳ ዎጋኒ ዒኢካ ሺኢሻንዳኔ።"
            }
          ]
        },
        {
          "number": "3",
          "text": "ዲዒ ዔኬ ታኣኮ ዴሮ ጊሽታኒ ዒፃ ዔያታ ዓጌኔ፤",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዔያታ ዞኦዛ ኮኦማ ላኣሎና ላሃኒ ዓቲንቆ ናኣቶ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዎይኖ ዑዦ ዑሽካኒያ ዉዱሮ ናኣቶ ዓይሌ ማሂ ሻንቼኔ።»"
            }
          ]
        },
        {
          "number": "4",
          "text": "«ዒንሢ ፂሮሴንታ ሲዶናንታ ፒሊስፄኤሜ ዓጮ ዴራ! ዒንሢ ማዻ ባካ ዓይጎዳይ? ታና ኮማኒ ዒንሢ ማላ? ያዺ ማዔቴ ዒንሢ ማዼ ማዾ ኔጉዋዖ ታኣኒ ዒንሢዳ ሺርሻንዳኔ።",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "5",
          "text": "ታኣኮ ቢሮ ዓንጎንታ ዎርቆንታ፤ ዬያጉዲ ሃሣ ጴዹዋያ ማዔ፥ ታኣኮ ቆሎ ቢያ ዒንሢ ዔኪ ዒንሢኮ ካኣሽኮ ሜሌ ፆኦዞ ማኣሪ ጌልዜኔ።"
        },
        {
          "number": "6",
          "text": "ዪሁዳና ዬሩሳላሜናይዳ ሾይንቴ ዓሶ ዔያቶኮ ዓጫፓ ሃኪሲ ዔኪ ዴንዲ ጊሪኬ ዓሶም ዒንሢ ሻንቼኔ።"
        },
        {
          "number": "7",
          "text": "ሃሢ ዓካሪ ታኣኒ ዔያታ ሻንቺንቴ ቤዛፓ ዔያቶ ዔቂሲ፥ ዬኖ ዓጫፓ ዔያታ ኬስካንዳጉዲ ማሃንዳኔ፤ ዔያቶይዳ ዒንሢ ማዼ ፑርቶ ባኮ ቢያ ዒንሢዳ ታኣኒ ሺርሺ ዔኪ ዬዓንዳኔ።"
        },
        {
          "number": "8",
          "text": "ዒንሢኮ ዓቲንቆንታ ዉዱሮ ናኣቶንታ ዪሁዳ ዴሮም ሻንቺንታንዳኔ፤ ዬካፓ ዪሁዳ ዓጮ ዓሳ ሃኬይዳ ዓኣ ሳኣባ ዓሶም ዔያቶ ሻንቻንዳኔ፤ ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»"
        },
        {
          "number": "9",
          "text": "«ዬያ ሜሌ ዴሮም ቢያ ዒላቲ ኬኤዙዋቴ፤",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዖልዚማኣ ጊኢጊንቱዋቴ!"
            },
            {
              "source_marker": "q2",
              "text": "ዖሎና ዔርቴ ዓሶዋ ዔኤሊ ኬሱዋቴ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዖሎ ዖላ ዓሳ ቢያ ቡኪንቲ ዖሎሮ ኬስኮንጎ።"
            }
          ]
        },
        {
          "number": "10",
          "text": "ማራሾ ዒንሢኮ ዹይ ጬንቻ ዓራፖ፥ ባኣጮዋ ዹይ ዎርሢ ማሁዋቴ፤",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዎልቄ ባኣሢታቴያ ‹ታኣኒ ዶዲኬ!› ፔና ጎዖንጎ፤"
            }
          ]
        },
        {
          "number": "11",
          "text": "ዒንሢ ቢያ ዛሎና ዓኣ ሜሌ ዴራ ቢያ፤",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዑካዺ ኬስኩዋቴ!"
            },
            {
              "source_marker": "q2",
              "text": "ዶኦጮይዳ ቡኪንቱዋቴ።»"
            },
            {
              "source_marker": "q1",
              "text": "ናንጊና ናንጋ ጎዳሢዮ! ኔኤኮ ዖሎ ዓሶ ዳኬ።"
            }
          ]
        },
        {
          "number": "12",
          "text": "«ሜሌ ዴራ ቢያ ዔቂ ዒዮሳፒፄ ዶኦጮ ዓኣዾንጎ፤",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ታኣኒ፥ ናንጊና ናንጋ ጎዳ ቢያ ዛላ ዓኣ ሜሌ ዴሮይዳ"
            },
            {
              "source_marker": "q2",
              "text": "ፑርታ ዎጌ ዎጋኒ ዒኢካ ታኣኒ ዴዓንዳኔ።"
            }
          ]
        },
        {
          "number": "13",
          "text": "ዔያቶኮ ፑርቱማ ዑሣ ዓኣዼ ዺቤኔ፤",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ካፄ ሃኣኮ ባኣቺና ጮኦሪንታሢጉዲ ዔያቶ ጮኦሩዋቴ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዎይና ሶዮና ዎላ ጩኡጶ ቤዞይዳ ኩሚ ሄርቂንታሢጉዲ ዔያቶ ሄርቁዋቴ።»"
            }
          ]
        },
        {
          "number": "14",
          "text": "ናንጊና ናንጋ ጎዳ ዎጎ ዎጎ ዶኦጮይዳ ዎጋ ኬላ ሄሌኔ፤",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዬያሮ ኮሺ ሚርጌ ዴሬ ዒኢካ ቡኪንቴኔ።"
            }
          ]
        },
        {
          "number": "15",
          "text": "ዬኖ ኬሎና ዓቦንታ ዓጊኖንታ ዹማንዳኔ፤",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዦኦጋሢያ ፖዑዋያ ማዓንዳኔ።"
            }
          ]
        },
        {
          "number": "16",
          "text": "ናንጊና ናንጋ ጎዳ ፂዮኔ ዹኮይዳ፤ ጊንሣ ሃሣ ዬሩሳላሜይዳ ዔቂ",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ፔኤኮ ዒጊቻ ዑኡዞ ዋይዚሳንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ጫሪንጮንታ ሳዖንታ ዓጊፃንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዒዚ ፔ ዴሮ ዒስራዔኤሌኮ"
            },
            {
              "source_marker": "q2",
              "text": "ካናዾ ዋርዲዮ ማዓንዳኔ።"
            }
          ]
        },
        {
          "number": "17",
          "text": "«ዒስራዔኤሌ ዓሲዮቴ! ዒማና ታኣኒ፥ ናንጊና ናንጋ ጎዳሢ",
          "source_markers_before": [
            "s1",
            "q1"
          ],
          "source_headings_before": [
            "ፆኦሲ ፔ ዴሮ ዓንጄሢ"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዒንሢኮ ፆኦዛሢታሢ ዒንሢ ዔራንዳኔ፤"
            },
            {
              "source_marker": "q1",
              "text": "ታኣም ዱማዼ ፂዮኔ ዹኮይዳ ታኣኒ ናንጋንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዬሩሳላሜያ ታኣም ዱማዼ ካታማ ማዓንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ሃካፓ ሴካ ሜሌ ዓጮ ፖኦሊሳ ዖሊ ዒዞ ዓርቃዓኬ።»"
            }
          ]
        },
        {
          "number": "18",
          "text": "«ዬኖ ዎዶና ዹኮይዳ ቢያ ዎይኔ ባቃሊ ኩማንዳኔ፤",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ጌሜሮ ዑፆይዳኣ ሚርጌ ማኣፃ ባይ ሄንቃንዳኔ፤"
            },
            {
              "source_marker": "q1",
              "text": "ዪሁዳ ዓጮ ዎራ ቢያ ዋኣሢ ዓኣያ ማዓንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮይዳፓ ዋኣሢ ዓልቃንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ሺፂሜ ዶኦጮዋ ዬይ ዋኣፃ ዑሻንዳኔ።»"
            }
          ]
        },
        {
          "number": "19",
          "text": "«ጊብፄና ዔዶኦሜ ዓጮ ዓሶና ዪሁዳ ዴሮ ዑፃ",
          "source_markers_before": [
            "b",
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ጌኔ ማዾ ማዼሢሮ፥ ፂሎ ዴሮዋ ዎዼሢሮ"
            },
            {
              "source_marker": "q2",
              "text": "‹ጊብፄ ዓሲ ናንጉዋ ዓጪ ማዓንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዔዶኦሜያ ዓሲ ናንጉዋ ዳውሌ ማዓንዳኔ።›"
            }
          ]
        },
        {
          "number": "20-21",
          "text": "ዬያሮ ሃይማ ሄላንዳኣና ኮሞ ኮፁዋዖ ታኣኒ ሃሼ",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ጌኤዦ ዓሶ ሱጉፆ ዛሎ ኮሞ ታኣኒ ኮፃንዳኔ፤"
            },
            {
              "source_marker": "q1",
              "text": "ጋዓንቴ ዬሩሳላሜንታ ዪሁዳንታ ታኣኮ ዴራ ናኣናና ናንጋ ቤሲ ማዓንዳኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ታኣኒ፥ ናንጊና ናንጋ ጎዳሢ ፂዮኔ ዹኮይዳ ናንጋንዳኔ።»"
            }
          ]
        }
      ],
      "notes": [
        {
          "verse": "4",
          "marker": "Translator/editor note",
          "text": "Source note reference 3፡4. - ዒሲ. 14፡29-31፤ 23፡1-18፤ ዔር. 47፡1-7፤ ሂዚ. 25፡15—28፡26፤ ዓሞ. 1፡6-10፤ ሶፖ. 2፡4-7፤ ዛካ. 9፡1-7፤ ማቲ. 11፡21-22፤ ሉቃ. 10፡13-14።",
          "note_type": "translator_note",
          "source_reference": "3፡4"
        },
        {
          "verse": "10",
          "marker": "Translator/editor note",
          "text": "Source note reference 3፡10. - ዒሲ. 2፡4፤ ሚኪ. 4፡3።",
          "note_type": "translator_note",
          "source_reference": "3፡10"
        },
        {
          "verse": "13",
          "marker": "Translator/editor note",
          "text": "Source note reference 3፡13. - ዮሃ. ፆፔዻ 14፡14-16፤ 19፤ 20፤ 19፡15።",
          "note_type": "translator_note",
          "source_reference": "3፡13"
        },
        {
          "verse": "16",
          "marker": "Translator/editor note",
          "text": "Source note reference 3፡16. - ዓሞ. 1፡2።",
          "note_type": "translator_note",
          "source_reference": "3፡16"
        }
      ],
      "heading": [
        "ናንጊና ናንጋ ጎዳ ሜሌ ዴሮይዳ ዎጋንዳያ ማዒፆ"
      ]
    }
  ]
}
