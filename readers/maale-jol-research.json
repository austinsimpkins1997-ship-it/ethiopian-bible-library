      "chapter": 1,
      "verses": [
        {
          "number": "1",
          "text": "ባኣቱዔኤሌ ናኣዚ ዒዩዔኤሌም ናንጊና ናንጋ ጎዳፓ ዳኪንቴ ኪኢቶ ቃኣላ ያዺኬ፦",
          "source_markers_before": [
            "p"
          ]
        },
        {
          "number": "2",
          "text": "ዒንሢ ጋርቾ ዓሳ ዋይዙዋቴ!",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዪሁዳ ዓጫ ናንጋ ዓሳ ቢያ ዒናፓ ዋይዙዋቴ!"
            },
            {
              "source_marker": "q1",
              "text": "ዒንሢ ናንጌ ዎዶይዳ ሃያ ጉዴ ባኣዚ፤"
            },
            {
              "source_marker": "q2",
              "text": "ጊንሣ ሃሣ ዒንሢኮ ቤርታኣ ዓዶንሢ ዎዶናኣ ዓሲ ዛጊ ቤቂያ?"
            }
          ]
        },
        {
          "number": "3",
          "text": "ዬያ ባኮ ዒንሢኮ ናኣቶም ኬኤዙዋቴ፤",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዒንሢኮ ናኣታ ጊንሣ ፔ ናኣቶም ኬኤዞንጎ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዬያታኣ ዔያቶ ሄሊ ሙካ ሾይንቶም ኬኤዞንጎ።"
            }
          ]
        },
        {
          "number": "4",
          "text": "ሜልካሢዳፓ ዓቴ ሃኣኮ ባቃሎ",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ሻዻ ዓቢፃ ሙዔኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዬካፓ ዓቴሢ ሃሣ ዢኢፓ ዒርዚጉዲ ዲኢና"
            },
            {
              "source_marker": "q2",
              "text": "ዓቢፃ ሙይ ባይዜኔ፤"
            },
            {
              "source_marker": "q2",
              "text": "ዓቴሢያኣ ማካሢ ሙዔኔ።"
            }
          ]
        },
        {
          "number": "5",
          "text": "ሃይካፓ ሴካ ዒንሢ ሙርጎ ዎይኖ ዑዦ ዻንጋ ካንሢንዱዋኣሢሮ",
          "source_markers_before": [
            "q1"
          ],
          "continuations": [
            {
              "source_marker": "q2",
              "text": "ዒንሢ ማሢንታ ዓሳ ጊንዓስካፓ ጴጪ ዬኤኩዋቴ፤"
            },
            {
