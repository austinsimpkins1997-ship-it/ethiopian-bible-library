      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ዘከመ፡ ኢይደሉ፡ ዛውዐ፡ ነገር"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=1"
          ],
          "text": "እምጳውሎስ፡ ሐዋርያሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። በትእዛዘ፡ እግዚአብሔር፡ መድኀኒነ፡ ወኢየሱስ፡ ክርስቶስ፡ ተስፋነ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=2"
          ],
          "text": "ለጢሞቴዎስ፡ ወልድየ፡ ዘአፈቅር፡ በሃይማኖት። ሰላም፡ ለከ፡ ወሣህል፡ ወጸጋሁ፡ ለእግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=3"
          ],
          "text": "በከመ፡ አስተብቋዕኩከ፡ ትንበር፡ ኤፌሶን፡ አመ፡ አሐውር፡ መቄዶንያ። ከመ፡ ትገሥጾሙ፡ ከመ፡ ኢያምጽኡ፡ ካልአ፡ ትምህርተ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=4"
          ],
          "text": "ወኢያምጽኡ፡ መሐድምተ፡ ወዛውዐ፡ ነገር፡ ዘይፈጥሩ፡ በዘያስሕቱ። ወያመጽኡ፡ ተኃሥሦ፡ ወየኀድጉ፡ ሕገ፡ እግዚአብሔር፡ ዘሃይማኖት።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ፍቅር"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=5"
          ],
          "text": "ወማኅለቅቱሰ፡ ለትእዛዝ፡ ተፋቅሮ፡ በንጹሕ፡ ልብ፡ ወበሠናይ፡ ግእዝ። ወሃይማኖት፡ ዘአልቦ፡ ኑፋቄ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=6"
          ],
          "text": "እስመ፡ ቦ፡ እለ፡ አውከኩ፡ ወገብኡ፡ ውስተ፡ ነገረ፡ ከንቱ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=7"
          ],
          "text": "ወእንዘ፡ ይፈቅዱ፡ መምህራነ፡ ይኩኑ፡ ኢየአምሩ፡ ዘለሊሆሙ፡ ይነብቡ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=8"
          ],
          "text": "ነአምር፡ ከመ፡ ሠናይ፡ ውእቱ፡ ኦሪት፡ ለዘይገብሮ፡ በሕጉ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ሕግ"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=9"
          ],
          "text": "ወነአምር፡ ዘኒ፡ ከመ፡ አኮ፡ ለጻድቃን፡ ዘይሠራዕ። ዘእንበለ፡ ለኃጥኣን፡ ወለጽልሕዋን፡ ወለዝሉፋን። ወለውፁኣን፡ እምጽድቅ፡ ወለርኩሳነ፡ ልብ። ወቀተልተ፡ አበዊሆሙ፡ ወእሞሙ፡ ወቀተልተ፡ አዝማዲሆሙ፡ ወቀተልተ፡ ነፍስ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=10"
          ],
          "text": "ዘማውያን፡ ወእለ፡ የሐውሩ፡ ብእሲተ፡ ብእሲ። ሰረቅተ፡ ሰብእ፡ ሐሳውያን፡ ወእለ፡ ይምሕሉ፡ በሐሰት። ወቦ፡ ባዕድኒ፡ ዓዲ፡ በዘይትቃወምዋ፡ ለትምህርተ፡ ሕይወት።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=11"
          ],
          "text": "ዘወንጌለ፡ ስብሐቲሁ፡ ለብፁዕ፡ እግዚአብሔር፡ ዘአነ፡ ተአመንኩ፡ ቦቱ።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "አኰቴት፡ በእንተ፡ ጽዋዔሁ"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=12"
          ],
          "text": "አአኵቶ፡ ለዘተአመነኒ፡ ወአጽንዐኒ፡ በክርስቶስ፡ ኢየሱስ፡ እግዚእነ። እስመ፡ ምእመነ፡ ረሰየኒ፡ ለመልእክቱ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=13"
          ],
          "text": "እንዘ፡ ቀዲሙ፡ ጸራፊ፡ አነ፡ ወሰዳዲ፡ ወጸአሊ። ወባሕቱ፡ ተሣሀለኒ፡ እስመ፡ በኢያእምሮ፡ ገበርኩ፡ በኢ፡ አሚን።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=14"
          ],
          "text": "ወፈድፈደ፡ ጸጋሁ፡ ለእግዚአብሔር፡ በላዕሌየ። በሃይማኖቱ፡ ወፍቅሩ፡ ለኢየሱስ፡ ክርስቶስ፡ እግዚእነ።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=15"
          ],
          "text": "እሙን፡ ነገሩ፡ ወርቱዕ፡ ይትወከፍዎ፡ በኵሉ። እስመ፡ ኢየሱስ፡ ክርስቶስ፡ መጽአ፡ ውስተ፡ ዓለም። ከመ፡ ያድኅኖሙ፡ ለኃጥኣን፡ ዘአነ፡ ቀዳሚሆሙ።"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=16"
          ],
          "text": "ወባሕቱ፡ ተሣሀለኒ፡ ከመ፡ ያርኢ፡ ተኣምራቲሁ፡ በላዕሌየ፡ ኢየሱስ፡ ክርስቶስ፡ ወብዝኀ፡ ትዕግሥቱ። ወእኩኖሙ፡ አርአያ፡ ለእለ፡ የአምኑ፡ ቦቱ፡ ለሕይወት፡ ዘለዓለም።"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=17"
          ],
          "text": "ንጉሥ፡ ዘለዓለም፡ ዘኢይመውት፡ ወኢያስተርኢ፡ አምላክ፡ ባሕቲቱ። ዘሎቱ፡ ክብር፡ ወስብሐት፡ ለዓለመ፡ ዓለም፡ አሜን።"
        },
        {
          "number": 22,
          "unit_order": 22,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "አማሕፅኖ፡ በእንተ፡ ትእዛዝ"
        },
        {
          "number": 23,
          "unit_order": 23,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=18"
          ],
          "text": "ዘንተ፡ ትእዛዘ፡ አማሕፀንኩከ፡ ኦ፡ ወልድየ፡ ጢሞቴዎስ፡ በከመ፡ ተነብዮ፡ ዘላዕሌከ። ከመ፡ ትጽናዕ፡ በኵሉ፡ ገድል፡ ሠናይ።"
        },
        {
          "number": 24,
          "unit_order": 24,
          "source_marker": "19",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=1&verse=19"
          ],
          "text": "እንዘ፡ ብከ፡ ሃይማኖት፡ ወሠናይ፡ ግዕዝ። እስመ፡ ሀለዉ፡ እለ፡ አውከኩ፡ እምሃይማኖት፡ ወተሰብሩ።"
        },
        {
