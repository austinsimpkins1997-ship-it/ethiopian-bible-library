          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=3&verse=3"
          ],
          "text": "ዘኢያበዝኅ፡ ሰትየ፡ ወይን፡ ዘኢያፈጥን፡ እዴሁ፡ ለዘቢጥ፡ ባቊዕ፡ ዘኢይትገአዝ፡ ዘኢያፈቅር፡ ንዋየ።"
