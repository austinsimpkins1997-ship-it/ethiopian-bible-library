          "number": 17,
          "unit_order": 17,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=5&verse=15"
          ],
          "text": "እስመ፡ ቦ፡ እለ፡ ተመይጡ፡ ወተለውዎ፡ ለሰይጣን።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=5&verse=16"
          ],
          "text": "ወለእመ፡ ቦ፡ እምእመናን፡ ዘቦ፡ ዕቤር፡ ይዕቀባ። ወኢያክብድ፡ ላዕለ፡ ቤተ፡ ክርስቲያን፡ ከመ፡ ትክሀል፡ ለእለ፡ በአማን፡ ዕቤራት።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ምክዕቢተ፡ ጥበብ፡ ለቀሲሳን"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=5&verse=17"
          ],
          "text": "እለሰ፡ ሠናየ፡ ተልእኩ፡ ቀሲሳን፡ ምክዕቢተ፡ ክብር፡ ይደልዎሙ። ወፈድፈደሰ፡ ለእለ፡ ይሠርሑ፡ በቃል፡ ወበምህሮ።"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=5&verse=18"
          ],
          "text": "ወይብል፡ መጽሐፍ፡ ኢትፍጽሞ፡ አፉሁ፡ ለላሕም፡ ሶበ፡ ታከይድ፡ እክለከ። ወይደልዎ፡ ዐስቡ፡ ለዘይትቀነይ።"
        },
        {
          "number": 22,
          "unit_order": 22,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ሠሪዐ፡ ቤተ፡ ክርስቲያን"
        },
        {
          "number": 23,
          "unit_order": 23,
          "source_marker": "19",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Ti&chapter=5&verse=19"
          ],
          "text": "ላዕለ፡ ልሂቅ፡ ኢትስማዕ፡ ውዴተ። ዘእንበለ፡ ይዝልፍዎ፡ ክልኤቱ፡ ወሠለስቱ፡ ሰማዕት።"
        },
