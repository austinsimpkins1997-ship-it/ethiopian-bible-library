          "unit_order": 7,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=2&verse=5"
          ],
          "text": "ኢትዜከሩኑ፡ ከመ፡ አመ፡ ሀሎኩ፡ ኀቤክሙ፡ አቅደምኩ፡ ወነገርኩክሙ፡ ዘንተ።"
        },
