          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=2&verse=10"
          ],
          "text": "ወበኵሉ፡ አስሕቶ፡ ዘኀጢአት፡ ለሕርቱማን። እስመ፡ ኢተወክፉ፡ ፍቅረ፡ ቃለ፡ ጽድቅ፡ በዘየሐይዉ።"
