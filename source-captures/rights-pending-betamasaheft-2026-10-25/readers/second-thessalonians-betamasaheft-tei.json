        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ተመክሖ፡ በፍቅረ፡ አኀው"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=1"
          ],
          "text": "እምጳውሎስ፡ ወስልዋኖስ፡ ወጢሞቴዎስ፡ ለቤተ፡ ክርስቲያን፡ ዘተሰሎንቄ። ምእመናን፡ በእግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=2"
          ],
          "text": "ሰላም፡ ለክሙ፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=3"
          ],
          "text": "ርቱዕ፡ ናእኵቶ፡ ለእግዚአብሔር፡ በኵሉ፡ ጊዜ፡ በእንቲኣክሙ፡ አኀዊነ፡ በከመ፡ ይደልዎ። እስመ፡ ዐብየት፡ ሃይማኖትክሙ፡ ወፈድፈደት፡ ተፋቅሮትክሙ፡ ምስለ፡ ኵሉ፡ ቢጽክሙ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=4"
          ],
          "text": "ከመ፡ ንሕነኒ፡ ንትመካሕ፡ ብክሙ፡ በቤተ፡ ክርስቲያኑ፡ ለእግዚአብሔር። በእንተ፡ ሃይማኖትክሙ፡ ወትዕግሥትክሙ፡ በሕማምክሙ፡ ወምንዳቤክሙ፡ ዘትትዔገሡ፡ ወትትዌከፉ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=5"
          ],
          "text": "ከመ፡ ታርእዩ፡ ኵነኔ፡ ጽድቁ፡ ለእግዚአብሔር። ከመ፡ ይክፍልክሙ፡ መንግሥቶ፡ ዘበእንቲኣሁ፡ ተሐምሙ።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ምጽአተ፡ እግዚእነ"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=6"
          ],
          "text": "ወርቱዕሰ፡ ይትፈደዩ፡ በኀበ፡ እግዚአብሔር፡ ሕማመ፡ እለ፡ ያሐምሙክሙ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=7"
          ],
          "text": "ወለክሙ፡ ለእለ፡ ተሐምሙ፡ ዕረፍተ፡ ምስሌነ። በምጽአቱ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ እምሰማያት፡ ምስለ፡ መላእክተ፡ ኀይሉ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=8"
          ],
          "text": "ከመ፡ ይትበቀሎሙ፡ በነደ፡ እሳት፡ ለእለ፡ ኢየአምርዎ፡ ለእግዚአብሔር። ወለእለ፡ ኢይሰምዑ፡ ትምህርተ፡ ወንጌሉ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=9"
          ],
          "text": "ወይረክቡ፡ ፍዳሆሙ፡ ኵነኔ፡ ሀጕል፡ ወተሠርዎ፡ ዘለዓለም። እምቅድመ፡ ገጹ፡ ለእግዚእነ፡ ወእምስብሐተ፡ ኀይሉ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ነሢአ፡ ዕሴት"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=10"
          ],
          "text": "አመ፡ ይመጽእ፡ ይሴባሕ፡ በቅዱሳኒሁ፡ ወይትአኰት፡ በእለ፡ የአምኑ፡ ቦቱ። እስመ፡ ይትአመነነ፡ ስምዕነ፡ በላዕሌክሙ፡ በይእቲ፡ ዕለት።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=11"
          ],
          "text": "ወበእንተ፡ ዝ፡ እጼሊ፡ ዘልፈ፡ በእንቲኣክሙ። ከመ፡ ይክፍልክሙ፡ ርስቶ፡ ዘጸውዐክሙ፡ እግዚአብሔር። ወይፈጽም፡ ለክሙ፡ ኵሎ፡ ሣህሎ፡ ወሠናይቶ፡ ወምግባረ፡ ሃይማኖት፡ በኀይሉ።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Th&chapter=1&verse=12"
          ],
          "text": "ከመ፡ ይሰባሕ፡ ስመ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ በላዕሌክሙ። ወአንትሙሂ፡ ቦቱ፡ በከመ፡ ጸጋሁ፡ ለአምላክነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ወአንትሙሂ፡ ተሀልዉ፡ ቦቱ።"
        }
