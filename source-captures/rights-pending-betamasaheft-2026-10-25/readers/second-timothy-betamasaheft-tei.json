        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=8"
          ],
          "text": "እንከሰ፡ ጽኑሕ፡ ሊተ፡ አክሊለ፡ ጽድቅ። ዘየዐስየኒ፡ እግዚአብሔር፡ ይእተ፡ ዕለተ፡ መኰንነ፡ ጽድቅ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=9"
          ],
          "text": "ወአኮ፡ ለባሕቲትየ፡ አላ፡ ለኵሎሙ፡ እለ፡ ያፈቅሩ፡ ምጽአተ፡ ዚኣሁ። አስተፋጥን፡ ትምጻእ፡ ኀቤየ፡ ፍጡነ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=10"
          ],
          "text": "ዴማስ፡ ኀደገኒ፡ ወአፍቀሮ፡ ለዝንቱ፡ ዓለም፡ ዘይእዜ፡ ወሖረ፡ ተሰሎንቄ። ወቆሬቄስኒ፡ ገላትያ፡ ወቲቶ፡ ድልማጥያ፡ ሉቃስ፡ ባሕቲቱ፡ ምስሌየ።"
        },
