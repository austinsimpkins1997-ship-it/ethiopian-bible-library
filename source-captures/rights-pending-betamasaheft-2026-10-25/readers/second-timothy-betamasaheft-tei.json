        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ትእዛዝ፡ ወትንቢት"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=1"
          ],
          "text": "ወእኤዝዘከ፡ በቅድመ፡ እግዚአብሔር፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ዘሀለዎ፡ ይኰንን፡ ሕያዋነ፡ ወምዉታነ፡ አመ፡ ይመጽእ፡ በመንግሥቱ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=2"
          ],
          "text": "ከመ፡ ትስብክ፡ ቃሎ፡ ቀዊመከ፡ በድቡት፡ በጊዜሁ፡ ወዘእንበለ፡ ጊዜሁ። ገሥጽ፡ ወተዛለፍ፡ ናዝዝ፡ ወየውህ፡ እንዘ፡ ትትዔገሥ፡ በኵሉ፡ ወትሜህር።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=3"
          ],
          "text": "እስመ፡ ይበጽሕ፡ ጊዜሁ፡ አመ፡ የአብይዋ፡ ለትምህርተ፡ ሕይወት። ወየሐውሩ፡ በፍትወቶሙ፡ ወያመጽኡ፡ መምህራነ፡ ለርእሶሙ፡ በሁከተ፡ እዘኒሆሙ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=4"
          ],
          "text": "ወይመይጡ፡ እዘኒሆሙ፡ እምጽድቅ፡ ወያመጽኡ፡ ካልአ፡ ትምህርተ። ወይትመየጡ፡ ኀበ፡ መሐድምት።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=4&verse=5"
          ],
          "text": "ወአንተሰ፡ ንቃሕ፡ ወጥበብ፡ በኵሉ፡ ወጻሙ፡ ወግበር፡ ምግባረ፡ ወንጌላዌ። ወኩን፡ ወፈጽም፡ መልእክተከ።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ፍጻሜ፡ ስምዑ፡ ለጳውሎስ"
