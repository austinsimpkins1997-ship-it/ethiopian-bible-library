        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ጢሞቴዎስ፡ ወሃይማኖቱ"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=1"
          ],
          "text": "እምጳውሎስ፡ ሐዋርያሁ፡ ለኢየሱስ፡ ክርስቶስ፡ በፈቃደ፡ እግዚአብሔር። ወበተስፋ፡ ሕይወት፡ እንተ፡ በኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=2"
          ],
          "text": "ለጢሞቴዎስ፡ ወልድየ፡ ዘአፈቅር፡ ሰላም፡ ለከ። ወሣህል፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=3"
          ],
          "text": "አአኵቶ፡ ለእግዚአብሔር፡ ዘኪያሁ፡ አመልክ፡ በልብ፡ ንጹሕ፡ እምፍጥረትየ። ወዘልፈ፡ እዜከረከ፡ በጸሎትየ፡ መዓልተ፡ ወሌሊተ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=4"
          ],
          "text": "ወእፈቱ፡ እርአይከ፡ ወእዜከር፡ አንብዐከ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=5"
          ],
          "text": "ወእትፌሣሕ፡ ተዘኪርየ፡ ሃይማኖተከ፡ ዘአልቦ፡ ኑፋቄ። እንተ፡ ኀደረት፡ ላዕለ፡ እምከ፡ ኤውንቄ፡ ወእምሔውትከ፡ ሎይድ። ወእፌጽም፡ ፍሥሓየ፡ ወእትአመን፡ ከመ፡ ላዕሌከኒ።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=6"
          ],
          "text": "ወበእንተ፡ ዝ፡ እዜከረከ፡ ከመ፡ ይትሐደስ፡ ጸጋሁ፡ ለእግዚአብሔር። ዘረከብከ፡ በሢመተ፡ እዴየ፡ ላዕሌከ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ዘኢይደሉ፡ ኀፍረት፡ በሃይማኖት"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=7"
          ],
          "text": "እስመ፡ አኮ፡ መንፈሰ፡ ፍርሀት፡ ዘወሀበነ፡ እግዚአብሔር። ዘእንበለ፡ መንፈሰ፡ ኀይል፡ ወንጽሕ፡ ወተፋቅሮ፡ ወጥበብ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=8"
          ],
          "text": "ወኢትኅፈር፡ እንከ፡ በእንተ፡ ስምዑ፡ ለእግዚእነ፡ ወኢታስተኀፍረኒ፡ ኪያየ፡ ሙቁሖ። ዳእሙ፡ ጻሙ፡ ለምህሮ፡ በኀይለ፡ እግዚአብሔር፡ ዘአድኀነነ፡ ወጸውዐነ፡ በጽዋዔሁ፡ ቅዱስ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=9"
          ],
          "text": "ወአኮ፡ በከመ፡ ምግባሪነ፡ ዳእሙ፡ በከመ፡ ፈቃዱ፡ ወጸጋሁ። ዘተውህበ፡ ለነ፡ በኢየሱስ፡ ክርስቶስ፡ እምቅድመ፡ ዓለም።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=10"
          ],
          "text": "ወአስተርአየ፡ ይእዜ፡ በምጽአቱ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ መድኀኒነ። ዘሰዐሮ፡ ለሞት፡ ወአብርሃ፡ ለሕይወት፡ ወአሰሰለ፡ ሙስና፡ በትምህርተ፡ ወንጌሉ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ስምዕ፡ ወማሕፀንት"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=11"
          ],
          "text": "ዘሎቱ፡ ተሠየምኩ፡ ሐዋርያ፡ ወዐዋዴ፡ ወመምህረ፡ ለአሕዛብ።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=12"
          ],
          "text": "ወበእንቲኣሁ፡ አሐምም፡ ወኢይትኀፈር፡ እምዘአነ፡ ቦቱ። እስመ፡ አአምር፡ ዘተአመንኩ፡ ወእትአመንሂ። ከመ፡ ይክል፡ ዐቂበ፡ ሊተ፡ ዘአማሕፀነኒ፡ እስከ፡ ይእቲ፡ ዕለት።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=13"
          ],
          "text": "ወይኩን፡ ለከ፡ አርአያ፡ ውእቱ፡ ቃለ፡ ሕይወት። ዘሰማዕከ፡ በኀቤየ፡ በሃይማኖት፡ ወበፍቅረ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=14"
          ],
          "text": "ዕቀብ፡ ማሕፀንተከ፡ ሠናየ፡ በመንፈስ፡ ቅዱስ፡ ዘኅዱር፡ ላዕሌከ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=15"
          ],
          "text": "ወዘንተኒ፡ ተአምር፡ ከመ፡ ዐለዉኒ፡ ኵሎሙ፡ እለ፡ በእስያ፡ እለ፡ ፊሎጎስ፡ ወኤርዋኔጌስ።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ጸሎት፡ ወበረከት"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=16"
          ],
          "text": "ወየሀቦ፡ እግዚአብሔር፡ ሣህለ፡ ለቤተ፡ ሄኔሴፎሩ። እስመ፡ ብዙኀ፡ አዕረፈ፡ ወኢኀፈረ፡ በእንተ፡ መዋቅሕትየ።"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=2Ti&chapter=1&verse=17"
          ],
          "text": "ወበጺሖ፡ ኀበ፡ ሮሜ፡ ፍጡነ፡ ኀሠሠኒ፡ ወረከበኒ፡ ሙቁሕየ።"
        },
        {
