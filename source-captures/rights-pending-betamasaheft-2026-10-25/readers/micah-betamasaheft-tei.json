    {
      "chapter": 7,
      "source_chapter_label": "7",
      "heading": [
        "Chapter 7"
      ],
      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=1"
          ],
          "text": "አሌሊተ፡ እስመ፡ ኮንኩ፡ ከመ፡ ዜስተጋብእ፡ ቀሪመ፡ በማእረር፡ ወከመ፡ ተቅራም፡ እመ፡ ቀስም፡ ዘአልቦ፡ አስካ፡ ዘይበልኡ። አሌላ፡ ለነፍስየ።"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=2"
          ],
          "text": "እስመ፡ ኀልቀ፡ ኄር፡ እምድር፡ ወአልቦ፡ ሰብእ፡ ዘይረትዕ፡ ኩሉ፡ ለለለነፍሱ፡ ይሴነን፡ ወክሉ፡ ለያጠውቅ፡ ቢጾ፡ ወያመነደብ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=3"
          ],
          "text": "ወያነስኡ፡ እደውሆሙ፡ ለእኩይ፡ መልአክኒ፡ ይስእል፡ ወመኮንንኒ፡ ይየውህ፡ ከመ፡ ይርከብ፡ ፍትወተ፡ ነፍሱ፡ ወአጠፍኦ፡ ለበረከቶሙ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=4"
          ],
          "text": "ከመ፡ ጻፄ፡ ዘይበልዕ፡ ወየዐርግ፡ ዲበ፡ ንዋይ፡ በዕለተ፡ ጽልመት። አሌለኪ፡ በጽሒኪ፡ ፍዳኪ፡ ይእዜ፡ ይበጽሖሙ፡ ግዓር።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=5"
          ],
          "text": "ኢትትአመንዎሙ፡ እንከ፡ ለአዕርክቲክሙ፡ ወኢትትወከልዎሙ፡ ለመላእክት፡ ወእምብእሲትከ፡ ብስተ፡ ምስካብከ፡ ተዐቀብ፡ ከመ፡ ትእበያ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=6"
          ],
          "text": "እስመ፡ ወልድኒ፡ ያኀስር፡ አባሁ፡ ወወለትኒ፡ ትትነሣእ፡ ዲበ፡ እማ፡ ወመርዓትኒ፡ ትትነሣእ፡ ዲበ፡ እማ፡ ወመርዓት፡ ላዕለ፡ ሐማታ፡ ወኲሉ፡ ሰብ፡ ቤቱ፡ ይጻረሮ፡ ለሰብእ።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=7"
          ],
          "text": "ወአንሰ፡ ዲበ፡ እግዚአብሔር፡ አዐርፍ፡ ወእሴፈዎ፡ ለአምላኪየ፡ ወመድኃንየ፡ ወይሰምዐኒ፡ አምላኪየ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=8"
          ],
          "text": "ወኢይከውን፡ ስላተ፡ ጸላእየ፡ እኒ፡ ድኀጽኩ፡ እትነሳእ፡ ወእመኒ፡ ነበርኩ፡ ስተ፡ ጽልመጽ፡ እግዚአብሔር፡ በርህ፡ ሊተ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=9"
          ],
          "text": "ተግሳጽ፡ እግዚአብሔር፡ አንሰ፡ ተዐገስኩ፡ እስመ፡ አበስኩ፡ ሎቱ፡ እስከ፡ ያጸድቂ፡ ፍትሕየ። ወይገብሮ፡ ሊተ፡ ቅስትየ፡ ወያገብአኒ፡ ውስተ፡ ብርሃን፡ ወእሬእያ፡ ለጽድቁ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=10"
          ],
          "text": "ወትሬኢ፡ ጸላእትየ፡ ወትለብስ፡ ኃፍረተ፡ እንተ፡ ትብለኒ፡ አይቴ፡ ውእቱ፡ እግዚአብሔር፡ አምላክከ። ወይሬእያ፡ አዕይንትየ፡ ይእዜ፡ ትከውን፡ ከመ፡ ጽንጒን፡ ዜከይዱ፡ ውስተ፡ ፍኖት።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=11"
          ],
          "text": "ወታጠፍአኪ፡ ይእተ፡ ዕለተ፡ ወትማስን፡ ህግኪ፡ ይእተ፡ ዕለተ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=12"
          ],
          "text": "ወትዐጸው፡ አህጉሪኪ፡ ወይትካፈልዎን፡ ፋርስ፡ ለአህጉሪኪ፡ ጽኑዓት፡ እምጢስ፡ እስከ፡ ፈለገ፡ ሶርያ፡ ወእምባሕር፡ እስከ፡ ባሕር፡ ወእምአድባር፡ እስከ፡ አድባር።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=13"
          ],
          "text": "ወትማስን፡ ምድር፡ ምስለ፡ ኩሉ፡ ዘይነብራ፡ እምፍሬ፡ እከየ፡ ምግባሮሙ።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=14"
          ],
          "text": "ረዐይ፡ ሕዝብከ፡ በበትርከ፡ ወነገደ፡ አባግዐ፡ ርስትከ፡ ወይኀድሩ፡ ባሕቲቶሙ፡ ወይትረዐዩ፡ ውስተ፡ ዖም፡ ዘማእከለ፡ ቀርሜሎስ፡ ወባሳን፡ ወገለአድ፡ በከመ፡ መዋዕለ፡ ዓለም።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=15"
          ],
          "text": "ወከመ፡ መዋዕክ፡ ዘአመ፡ ዐርጉ፡ እምግብጽ፡ ወትሬእዩ፡ መንክረ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=16"
          ],
          "text": "ወይርአዩ፡ አሕዛብ፡ ወይትኀፈሩ፡ በኩሉ፡ ኃይሎሙ፡ ይወድዩ፡ እደዊሆሙ፡ ዲበ፡ አፋሆሙ፡ ወይጠይዑ፡ እዘኒሆሙ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=17"
          ],
          "text": "ወይልሕሱ፡ መሬተ፡ ከመ፡ አርዌ፡ ምድር፡ ወይትከውሱ፡ በውስተ፡ መዕገቶሙ፡ ወይደነግፁ፡ እምእግዚአብሔር፡ አምላክነ፡ ወይፈርሁ፡ እምኔሁ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=18"
          ],
          "text": "መኑ፡ አምላክ፡ ከማከ፡ ዘያአትት፡ ኃጢአተ፡ ወይትዐደው፡ አበሳሆሙ፡ ለርስቱ፡ ለእለ፡ ተርፋ፡ ወኢያጽንዐ፡ ስምዐ፡ መዐቱ፡ እስመ፡ ፈቃዴ፡ ምሕረት፡ ውእቱ።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": "19",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=19"
          ],
          "text": "ይትመየጠነ፡ ዋይሠሀለነ፡ ወያሠጥሞን፡ ለኃጣውኢነ፡ ወይዌርዎን፡ ውስተ፡ ቀላየ፡ ባሕር፡ ለአበሳነ።"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "20",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Mic&chapter=7&verse=20"
          ],
          "text": "ወትሁብ፡ ጽድቀ፡ ለያዕቆብ፡ መሳህ፡ ለአብርሃም፡ በከመ፡ መሐልከ፡ ለአበዊነ፡ በመዋዕለ፡ ትካት።"
        }
      ],
