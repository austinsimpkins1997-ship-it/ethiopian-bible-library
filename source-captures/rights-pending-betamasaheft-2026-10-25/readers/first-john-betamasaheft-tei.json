        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Jo&chapter=3&verse=3"
          ],
          "text": "ወኵሉ፡ ዘተወከለ፡ ኪያሁ፡ ያንጽሕ፡ ርእሶ፡ በከመ፡ ውእቱ፡ ንጹሕ።"
        },
        {
