          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Jo&chapter=2&verse=9"
          ],
          "text": "ወዘሰ፡ ይብል፡ ውስተ፡ ብርሃን፡ ሀሎኩ፡ ወይጸልእ፡ ቢጾ። ሐሳዊ፡ ውእቱ፡ ወውስተ፡ ጽልመት፡ ሀሎ፡ እስከ፡ ይእዜ።"
