          "unit_order": 11,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Jo&chapter=1&verse=10"
          ],
          "text": "ወእመሰ፡ ንቤ፡ ኢአበስነ፡ ሐሳዌ፡ ንሬስዮ፡ ሎቱ፡ ወቃሉኒ፡ ኢሀሎ፡ ኀቤነ።"
        }
