        {
          "number": 14,
          "unit_order": 14,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ዘከመ፡ ኢይደሉ፡ ሐዘን፡ ዘቀቢጸ፡ ተስፋ"
        },
        {
          "number": 15,
          "unit_order": 15,
