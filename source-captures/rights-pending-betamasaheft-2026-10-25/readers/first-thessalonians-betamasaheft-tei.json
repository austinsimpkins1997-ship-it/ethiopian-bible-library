            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=11"
          ],
          "text": "ዘከመ፡ ተአምሩ፡ ለለ፡ አሐዱ፡ እምውስቴትክሙ። ከመ፡ አብ፡ ለወልዱ፡ ናስተበቊዐክሙ፡ ወንናዝዘክሙ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=12"
          ],
          "text": "ወናሰምዕ፡ ለክሙ፡ ከመ፡ ትሑሩ፡ ወትሩጹ፡ በዘይደልወክሙ፡ ለኀበ፡ እግዚአብሔር። ዘጸውዐክሙ፡ ውስተ፡ መንግሥተ፡ ስብሐቲሁ።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ተወክፎተ፡ ቃል፡ ዘእግዚአብሔር"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=13"
          ],
          "text": "በእንተ፡ ዝ፡ ንሕነሂ፡ ዘልፈ፡ ነአኵቶ፡ ለእግዚአብሔር። እስመ፡ ተወከፍክሙ፡ ቃለ፡ ትእዛዙ፡ ለእግዚአብሔር። ወአኮ፡ ቃለ፡ ዜና፡ ሰብእ፡ አላ፡ አማን፡ ከማሁ፡ ቃለ፡ እግዚአብሔር። ወይረድአክሙሂ፡ በገቢር፡ ለእለ፡ ተአመንክሙ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=14"
          ],
          "text": "ወአንትሙ፡ አኀዊነ፡ ተመሰልክሙ፡ በቤተ፡ ክርስቲያኑ፡ ለእግዚአብሔር። እለ፡ በይሁዳ፡ ምእመናን፡ በኢየሱስ፡ ክርስቶስ። እስመ፡ ሐመምክሙ፡ አንትሙሂ፡ እምሕዝብክሙ። በከመ፡ ሐሙ፡ እሙንቱሂ፡ እምአይሁድ። እለ፡ ቀተልዎ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=15"
          ],
          "text": "ወለነቢያቲሂ፡ እለ፡ እምውስቴቶሙ፡ ሰደድዎሙ። ወኪያነሂ፡ ወኢያሠምርዎ፡ ለእግዚአብሔር፡ ወይትቃረኑ፡ ምስለ፡ ኵሉ፡ ሰብእ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=16"
          ],
          "text": "ወይከልኡነ፡ ኢንንግር፡ ለአሕዛብ፡ በዘየሐይዉ፡ ከመ፡ ይትፈጸሞሙ፡ ኀጢአቶሙ፡ ለዝሉፉ። ወናሁ፡ በጽሖሙ፡ መቅሠፍቶሙ፡ ዘለዓለም።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ አዘክሮተ፡ ፍቅር"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=17"
          ],
          "text": "ወንሕነሰ፡ አኀዊነ፡ ከመ፡ ዕጓለ፡ ማውታ፡ ኮነ፡ እምኔክሙ፡ በዝ፡ መዋዕል፡ ለገጽ፡ ዳእሙ፡ ወአኮሰ፡ እምልብ። ወፈድፋደ፡ ጽሕቅነ፡ ንርአይ፡ ገጸክሙ።"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=18"
          ],
          "text": "ወብዙኀ፡ ፈቀድኩ፡ እምጻእ፡ ኀቤክሙ፡ ለልየ፡ ጳውሎስ፡ ምዕረ። ወካዕበ፡ ወአዕቀፈኒ፡ ሰይጣን።"
        },
        {
          "number": 22,
          "unit_order": 22,
          "source_marker": "19",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=19"
          ],
          "text": "መኑ፡ ተስፋነ፡ ወፍሥሓነ፡ ወአክሊለ፡ ምክሕነ። አኮኑ፡ አንትሙ፡ በቅድመ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ በምጽአቱ።"
        },
        {
          "number": 23,
          "unit_order": 23,
          "source_marker": "20",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=2&verse=20"
          ],
          "text": "እስመ፡ አንትሙ፡ ክብርነ፡ ወፍሥሓነ።"
        }
      ],
      "notes": []
    },
    {
      "chapter": 3,
      "source_chapter_label": "3",
      "heading": [
        "ምዕራፍ 3"
      ],
      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ዘከመ፡ ኢይደሉ፡ ቀቢጸ፡ ተስፋ"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=1"
          ],
          "text": "ወስኢነነ፡ ተዐግሦ፡ አብደርነ፡ ንንበር፡ አቴና፡ አሐተኔ፡ ባሕቲተነ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=2"
          ],
          "text": "ወፈነውናሁ፡ ለጢሞቴዎስ፡ እኁነ፡ ላእከ፡ እግዚአብሔር፡ ወረድኤትነ፡ በትምህርተ፡ ክርስቶስ። ከመ፡ ያጽንዕክሙ፡ ወያስተብቊዕክሙ፡ በእንተ፡ ሃይማኖትክሙ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=3"
          ],
          "text": "ከመ፡ ኢታንቀልቅሉ፡ ወኢይቅብጽ፡ አሐዱሂ፡ እምውስቴትክሙ፡ በዛቲ፡ ሕማምክሙ። ተአምሩ፡ ለሊክሙ፡ ከመ፡ ዝንቱ፡ ዳእሙ፡ ይጸንሐነ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=4"
          ],
          "text": "ወአመ፡ ሀሎኩ፡ ኀቤክሙ፡ ዘንተ፡ ክመ፡ አቅደምኩ፡ ወነገርኩክሙ። ከመ፡ ሀለወነ፡ ንሕምም፡ ወይሣቅዩነ። ወበከመ፡ አመርናክሙ፡ ኮነ፡ ውእቱ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ሐውጾ፡ አርድእት፡ በላእካን"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=5"
          ],
          "text": "ወበእንተ፡ ዝ፡ አነሂ፡ ስኢንየ፡ ተዐግሦ፡ ፈነውኩ፡ ጢሞቴዎስሃ። ከመ፡ አእምር፡ ሃይማኖተክሙ። እመ፡ ቦ፡ ከመ፡ አመከርክሙ፡ ዘያሜክር። ወለከንቱ፡ ይከውን፡ ጻማነ፡ ዘበእንቲኣክሙ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=6"
          ],
          "text": "ወይእዜሰ፡ እምአመ፡ በጽሐ፡ ጢሞቴዎስ፡ ኀቤነ፡ እምኀቤክሙ። ወዜነወነ፡ ሃይማኖተክሙ፡ ወተፋቅሮተክሙ፡ ወከመሂ፡ ትዜክሩነ፡ በሠናይ፡ ዘልፈ። ወትፈትዉ፡ ትርአዩነ፡ በከመ፡ ንፈቱ፡ ንሕነሂ፡ ርእዮተክሙ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=7"
          ],
          "text": "በእንተ፡ ዝ፡ ተፈሣሕነ፡ አኀዊነ፡ በእንተ፡ ኵሉ፡ ሕማምነ፡ ወምንዳቤነ፡ ዘበእንተ፡ ሃይማኖትክሙ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=8"
          ],
          "text": "እስመ፡ ይእዜ፡ ነሐዩ፡ እምከመ፡ አንትሙ፡ ቆምክሙ፡ በእግዚእነ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ጸሎተ፡ መምህራን፡ ኵሎ፡ ጊዜ"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=9"
          ],
          "text": "አየ፡ አኰቴተ፡ ንክል፡ ዐስዮቶ፡ ለእግዚአብሔር። ህየንተ፡ ኵሉ፡ ፍሥሓነ፡ ዘተፈሣሕነ፡ በእንቲኣክሙ። ዘእንበለ፡ ከመ፡ ንጸሊ፡ ኀበ፡ አምላክነ፡ መዓልተ፡ ወሌሊተ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=10"
          ],
          "text": "ወፈድፋደሰ፡ ንጼሊ፡ ከመ፡ ንርአይ፡ ገጸክሙ፡ ወይትፈጸም፡ ሕጸጸ፡ ሃይማኖትክሙ።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=11"
          ],
          "text": "ወእግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ያርትዕ፡ ፍኖተነ፡ ኀቤክሙ።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=12"
          ],
          "text": "ወለክሙሂ፡ ያብዝኅ፡ ወያፈድፍድ፡ ተፋቅሮተክሙ፡ በበይናቲክሙ፡ ወምስለ፡ ኵሉ፡ ለለ፡ አሐዱ። በከመ፡ ንሕነ፡ ናፈቅረክሙ፡ ለክሙ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Th&chapter=3&verse=13"
          ],
          "text": "ወይጽናዕ፡ ልብክሙ፡ በንጽሕ፡ ወበቅድሳት፡ ለቅድመ፡ እግዚአብሔር፡ አቡነ። አመ፡ ምጽአተ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ምስለ፡ ኵሎሙ፡ ቅዱሳን።"
        }
      ],
      "notes": []
    },
