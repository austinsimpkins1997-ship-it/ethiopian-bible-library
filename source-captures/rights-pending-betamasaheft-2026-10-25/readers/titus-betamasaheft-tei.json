          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=3&verse=5"
          ],
          "text": "አኮ፡ በምግባረ፡ ጽድቅነ፡ ዳእሙ፡ በምሕረቱ፡ አድኀነነ። በጥምቀተ፡ ዳግም፡ ልደት፡ ወተሐድሶ፡ በመንፈስ፡ ቅዱስ።"
