        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=2"
          ],
          "text": "ወበተስፋ፡ ሕይወት፡ ዘለዓለም፡ ዘአሰፈወ፡ እግዚአብሔር። ዘኢይሔሱ፡ እምፍጥረተ፡ ዓለም።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=3"
          ],
          "text": "ወአርአየ፡ ቃሎ፡ በዕድሜሁ፡ በስብከተ፡ ዚኣነ፡ ኪያሁ። ወተአመነኒ፡ ሊተ፡ ላዕሌሁ፡ በትእዛዘ፡ እግዚአብሔር፡ መድኀኒነ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=4"
          ],
          "text": "ለቲቶ፡ ወልድየ፡ ዘአፈቅር፡ በተፋቅሮ፡ ወበሃይማኖት፡ ሰላም፡ ለከ። ወጸጋ፡ ወሣህል፡ እምኀበ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ መድኀኒነ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ሢመተ፡ ቅስና"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=5"
          ],
          "text": "እስመ፡ እንበይነ፡ ዝንቱ፡ ኀደጉከ፡ ውስተ፡ ቀርጤስ፡ ከመ፡ ታስተራትዕ፡ ዘተርፈ። ወትሢም፡ ቀሲሳነ፡ ለለ፡ አህጉር፡ በከመ፡ አዘዝኩከ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=6"
          ],
          "text": "ብእሴ፡ ዘአሐተ፡ ብእሲተ፡ አውሰበ፡ ኅሩየ። ዘኢየሐምይዎ፡ በእኩይ፡ ዘቦ፡ ውሉድ፡ መሃይምናን። ዘኢያስተዋድይዎሙ፡ በምርዓት፡ እለ፡ ኢኮኑ፡ ዝሉፋነ፡ እለ፡ ይትኤዘዙ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=7"
          ],
          "text": "ወርቱዕ፡ ይሠየም፡ ጳጳስ፡ ዘአልቦ፡ ሐሜት፡ ዘኢያደሉ፡ ከመ፡ መጋቤ፡ እግዚአብሔር። ዘኢኮነ፡ መዓትመ፡ ዘልቡብ፡ ዘኢያበዝኅ፡ ሰትየ፡ ወይን። ወኢያፈጥን፡ እዴሁ፡ ለዘቢጥ፡ ወዘኢያፈቅር፡ ንዋየ፡ ከንቶ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=8"
          ],
          "text": "መፍቀሬ፡ ነግድ፡ ዘሠናይ፡ ምግባሩ፡ ዘአንጽሐ፡ ርእሶ። ጻድቅ፡ ወኄር፡ ወየዋህ፡ መስተዐግሥ፡ ዘያነሐሲ፡ ዘምሁር፡ ቃለ፡ ሃይማኖት።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=9"
          ],
          "text": "ዘይክል፡ ገሥጾ፡ በትምህርተ፡ ሕይወት፡ ወይዛለፎሙ፡ ለእለ፡ ይተዋሥኡ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ሥርዐት፡ በእንተ፡ እለ፡ ኢይትኤዘዙ"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=10"
          ],
          "text": "እስመ፡ ብዙኃን፡ እለ፡ ኢይትኤዘዙ፡ ወነገሮሙኒ፡ ከንቱ። ወያስሕትዎሙ፡ ለጽሉላነ፡ ልብ።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=11"
          ],
          "text": "ወፈድፋደሰ፡ ለእለ፡ እምአይሁድ፡ እለ፡ ርቱዕ፡ ይፍፅምዎም፡ አፉሆሙ። እስመ፡ እሉ፡ ይገፈትዑ፡ አብያተ፡ ኵሉ። ወይሜሀሩ፡ በዘኢይደሉ፡ በዘይረብሖሙ፡ ኀሳር።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=12"
          ],
          "text": "ወናሁ፡ ይቤ፡ አሐዱ፡ እምኔሆሙ፡ ነቢዮሙ፡ በእንቲኣሆሙ። እስመ፡ ሰብአ፡ ቀርጤስ፡ መደልዋን፡ ሐሳውያን፡ ዘልፈ፡ አራዊት፡ እኩያን፡ ከርሠ፡ መካን። ወዝንቱ፡ ስምዕ፡ እሙን፡ ላዕሌሆሙ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=1&verse=13"
          ],
          "text": "በእንተ፡ ዝንቱ፡ ተዛለፎሙ፡ ምቱረ፡ ከመ፡ ይጠይቁ፡ በሃይማኖት።"
        },
