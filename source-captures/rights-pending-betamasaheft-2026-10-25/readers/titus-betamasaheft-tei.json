      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ግብረ፡ መምህራን"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=3&verse=1"
          ],
          "text": "ዘክሮሙ፡ ለቀደምት፡ ወለመኳንንት። ከመ፡ ይትአዘዙ፡ በኵሉ፡ ምግባረ፡ ሠናይ፡ ወይኩኑ፡ ጥቡዓነ፡ ቦቱ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=3&verse=2"
          ],
          "text": "ወኢይትቈጥዑ፡ ወኢይትጋአዙ፡ አላ፡ መሓርያነ፡ ወየዋሃነ፡ ይኩኑ፡ ምስለ፡ ኵሉ፡ ሰብእ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=3&verse=3"
          ],
          "text": "እስመ፡ ንሕነሂ፡ ትካት፡ አበድነ፡ ዘእንበለ፡ አእምሮ። ወክሕድነ፡ ወስሕትነ፡ ወተቀነይነ፡ ለፍትወት፡ ወለሐውዝ፡ ዘዘ፡ ዚኣሁ። ወተለውነ፡ እኩየ፡ ወተቃንኦ፡ ወአሕሠምነ፡ ወጸላእነ፡ ቢጸነ።"
        },
        {
