          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Tit&chapter=3&verse=4"
          ],
          "text": "ወአመ፡ አስተርአየ፡ ምሕረቱ፡ ለእግዚአብሔር፡ መፍቀሬ፡ ሰብእ፡ መድኀኒነ።"
        },
