          "number": 19,
          "unit_order": 19,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=15"
          ],
          "text": "ዘእምትቤሉ፡ እመ፡ ሠምረ፡ እግዚአብሔር። ወሐየውነ፡ ንገብር፡ ዘንተ፡ አው፡ ዝክተ።"
        },
