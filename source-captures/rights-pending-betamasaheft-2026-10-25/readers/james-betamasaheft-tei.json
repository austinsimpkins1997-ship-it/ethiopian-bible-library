        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=14"
          ],
          "text": "ምንትኑመ፡ ሕይወትክሙ፡ አኮኑ፡ ጢስ፡ አንትሙ። ዘለምዕር፡ ያስተርኢ፡ ወእምድኅሬሁ፡ ይማስን።"
        },
