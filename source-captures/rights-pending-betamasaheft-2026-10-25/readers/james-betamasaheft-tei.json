      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ፍቁሩ፡ ለዓለም፡ ጸላኢሁ፡ ለእግዚአብሔር"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=1"
          ],
          "text": "እምአይቴ፡ ለክሙ፡ ጸብእ፡ ወቀትል። አኮኑ፡ እም፡ ዝየ፡ እምአፍቅሮ፡ ዝሙት፡ ዘይትገበር፡ ውስተ፡ አንጒዕክሙ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=2"
          ],
          "text": "ትፈትዉሂ፡ ወኢትረክቡ፡ ትትቃንኡሂ፡ ወትትቃተሉሂ። ወበእንተዝ፡ ኢትክሉ፡ ድኂነ፡ ትትበአሱሂ፡ ወትጻብኡሂ። ወኢትረክቡ፡ ዘተኀሥሡ፡ እስመ፡ ኢትስእሉ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=3"
          ],
          "text": "ትስእሉሂ፡ ወኢይሁቡክሙ፡ እስመ፡ ለእኪት፡ ትስእሉ፡ ለዝሙትክሙ፡ ከመ፡ ተሀቡ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=4"
          ],
          "text": "ኦ፡ ዘማውያን፡ ኢተአምሩኑ፡ ከመ፡ ፍቁሩ፡ ለዝ፡ ዓለም፡ ጸላኢሁ፡ ውእቱ፡ ለእግዚአብሔር። እስመ፡ ዘአብደረ፡ ፍቅሮ፡ ለዝ፡ ዓለም፡ ጸላኢሁ፡ ለእግዚአብሔር፡ ይከውን።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=5"
          ],
          "text": "ወሚመ፡ ይመስለክሙኑ፡ ዘሐሰተ፡ ይብል፡ መጽሐፍ። ከመ፡ ተቃንኦ፡ ያፈቅር፡ መንፈስ፡ ዘየኀድር፡ ላዕሌክሙ።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ሞገስ፡ እንተ፡ ተዐቢ"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=6"
          ],
          "text": "ወባሕቱ፡ አምላክነ፡ እንተ፡ ተዐቢ፡ ሞገሰ፡ ይሁበነ። ወበእንተ፡ ዝንቱ፡ ይቤ፡ እስመ፡ ለዕቡያን፡ ይትሄየዮሙ፡ እግዚአብሔር። ወለእለሰ፡ ያቴሕቱ፡ ርእሶሙ፡ ይሁቦሙ፡ ሞገሰ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=7"
          ],
          "text": "ኦሆ፡ በልዎ፡ ለእግዚአብሔር፡ ወእንብየ፡ በልዎ፡ ለጋኔን፡ ወይጐይይ፡ እምኔክሙ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=8"
          ],
          "text": "ቅረብዎ፡ ለእግዚአብሔር፡ ወይቀርበክሙ። አንጽሑ፡ እደዊክሙ፡ ኃጥኣን፡ ወአንጽሑ፡ ልበክሙ፡ እለ፡ ትናፍቁ፡ ግነዩ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=9"
          ],
          "text": "ላሕዉ፡ ወብክዩ፡ ወለሠሐቅክሙኒ፡ ሚጥዎ፡ ውስተ፡ ላሕ። ወትፍሥሕትክሙኒ፡ ውስተ፡ ትካዝ፡ አግብእዎ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=4&verse=10"
          ],
          "text": "አትሕቱ፡ ርእሰክሙ፡ ወያሌዕለክሙ፡ እግዚአብሔር።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ተዐቅቦ፡ እምነ፡ ሐሜት"
