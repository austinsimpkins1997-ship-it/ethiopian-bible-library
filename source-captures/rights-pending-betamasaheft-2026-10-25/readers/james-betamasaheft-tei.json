      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ትዕግሥት"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=1"
          ],
          "text": "እምያዕቆብ፡ ገብረ፡ እግዚአብሔር፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ለዐሠርቱ፡ ወክልኤቱ፡ ሕዝበ፡ ድዮስጶራ፡ ሰላም፡ ለክሙ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=2"
          ],
          "text": "ኦ፡ አኀው፡ ኩኑ፡ በኵሉ፡ ፍሥሓ። ሶበ፡ መንሱት፡ ይመጽአክሙ፡ ዘዘ፡ ዚኣሁ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=3"
          ],
          "text": "እንዘ፡ ተአምሩ፡ ከመ፡ መከራሃ፡ ለሃይማኖትክሙ፡ ትዕግሥተ፡ ይገብር፡ ለክሙ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=4"
          ],
          "text": "ወትዕግሥትሰ፡ ግብር፡ ፍጹም፡ ባቲ። ከመ፡ ትኩኑ፡ ፍጹማነ፡ ወጥዑያነ፡ እንዘ፡ አልቦ፡ ዘተኀጥኡ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ሥርዐተ፡ ጸሎት"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=5"
          ],
          "text": "ወእመሰ፡ ቦ፡ ዘኀጥኣ፡ ለጥበብ፡ ለይስአል፡ ኀበ፡ ወሃቢ፡ እግዚአብሔር። ዘይሁብ፡ ለኵሉ፡ በስፉሕ፡ እንዘ፡ ኢይትዔየር፡ ወኢይዘረኪ፡ ወይትወሀብ፡ ሎቱ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=6"
          ],
          "text": "ወይስአል፡ እንዘ፡ ይትአመን፡ ወኢይናፍቅ፡ እስመ፡ ዘይናፍቅሰ፡ ይከውን፡ ከመ፡ ሞገደ፡ ባሕር። እንተ፡ ይዘብጣ፡ ነፋስ፡ ወያነውኃ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=7"
          ],
          "text": "ወኢይምሰሎ፡ ለውእቱ፡ ብእሲ፡ ከመ፡ ዘይነሥእ፡ ምንተኒ፡ እምኀበ፡ እግዚአብሔር።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=8"
          ],
          "text": "እስመ፡ ብእሲ፡ ዘክልኤ፡ ልቡ፡ ህዉክ፡ ውእቱ፡ በኵሉ፡ ፍኖቱ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=9"
          ],
          "text": "ለይትመካሕ፡ እኁነ፡ ነዳይ፡ በተልዕሎቱ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=10"
          ],
          "text": "ወባዕልሰ፡ በተትሕቶቱ፡ እስመ፡ ከመ፡ ፍሬ፡ ሣዕር፡ የኀልፍ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=11"
          ],
          "text": "ወእምከመ፡ ሠረቀ፡ ፀሓይ፡ ምስለ፡ ላህቡ። ያየብሶ፡ ለሣዕር፡ ወፍሬሁኒ፡ ይወድቅ፡ ወሥነ፡ ራእዩኒ፡ ይትሀጐል። ከማሁኬ፡ ባዕልኒ፡ በፍናዊሁ፡ ይጸመሒ።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ትዕግሥት፡ ወመከራ"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=12"
          ],
          "text": "ወብፁዕ፡ ብእሲ፡ ዘይትዔገሣ፡ ለእኪት። እስመ፡ ተመኪሮ፡ ይነሥእ፡ አክሊለ፡ ሕይወት። ዘአሰፈዎሙ፡ እግዚአብሔር፡ ለእለ፡ ያፈቅርዎ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=13"
          ],
          "text": "ወእመ፡ ቦ፡ ዘይትሜከር፡ ኢይበል፡ እግዚአብሔር፡ ያሜክረኒ። እስመ፡ እግዚአብሔር፡ ኢያሜክር፡ ለእኪት። ወውእቱሰ፡ ኢያሜክር፡ ወኢ፡ መነሂ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=14"
          ],
          "text": "አላ፡ አሐዱ፡ አሐዱ፡ ይትሜከር፡ በፍትወተ፡ እንቲኣሁ። ወይወፅእ፡ ኀቤሃ፡ ወይደነግፅ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=15"
          ],
          "text": "ወፍትወትሰ፡ እምከመ፡ ፀንሰት፡ ትወልዳ፡ ለኀጢአት። ወኀጢአትኒ፡ እምከመ፡ ተፈጸመት፡ ትወልዳ፡ ለሞት።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=16"
          ],
          "text": "ኢያስሕቱክሙ፡ አኀዊነ፡ ፍቁራን።"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=17"
          ],
          "text": "ኵሉ፡ ሀብት፡ ሠናይ፡ ወኵሉ፡ ፍት፡ ፍጹም። እምላዕሉ፡ ይእቲ፡ ትወርድ፡ እምኀበ፡ አቡሃ፡ ለብርሃን። ውእቱ፡ ዘአልቦ፡ ተውላጥ፡ ኀቤሁ፡ ወአልቦ፡ ምንትኒ፡ ዘያመሥጥ፡ እምእዴሁ።"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=18"
          ],
          "text": "እስመ፡ በፈቃዱ፡ ወለደነ፡ በቃለ፡ ጽድቁ፡ ከመ፡ ንኩን፡ ቀደምተ፡ ለፍጥረቱ።"
        },
        {
          "number": 22,
          "unit_order": 22,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ትዕግሥት፡ ወዐቂበ፡ ሕግ"
        },
        {
          "number": 23,
          "unit_order": 23,
          "source_marker": "19",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=19"
          ],
          "text": "ወይእዜኒ፡ አኀዊነ፡ ኩኑ፡ ወይኩን፡ ኵሉ፡ ብእሲ፡ ፍጡነ፡ ለሰሚዕ። ወጕንዱየ፡ ለነቢብ፡ ወጕንዱየ፡ ለመዓት።"
        },
        {
          "number": 24,
          "unit_order": 24,
          "source_marker": "20",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=20"
          ],
          "text": "እስመ፡ መዓቱ፡ ለብእሲ፡ ጽድቀ፡ እግዚአብሔር፡ ኢያገብሮ።"
        },
        {
          "number": 25,
          "unit_order": 25,
          "source_marker": "21",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=21"
          ],
          "text": "ወይእዜኒ፡ ኅድግዋ፡ ለኵላ፡ ርስሐት፡ ወለኵላ፡ እኪት። ወበየውሀት፡ ተቀበልዎ፡ ለቃል፡ ዘተዘርዐ፡ ውስተ፡ ልብክሙ። ዘይክል፡ አድኅኖታ፡ ለነፍስክሙ።"
        },
        {
          "number": 26,
          "unit_order": 26,
          "source_marker": "22",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=22"
          ],
          "text": "ወኩኑ፡ ገባርያኒሃ፡ ለሕግ፡ ወአኮ፡ ለአጽምዖ። ባሕቲቱ፡ ኀልይዎ፡ እስኩ፡ ለሊክሙ።"
        },
        {
          "number": 27,
          "unit_order": 27,
          "source_marker": "23",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=23"
          ],
          "text": "እመ፡ ቦ፡ ዘያጸምዖ፡ ለቃል፡ ወኢይገብሮ። ይመስል፡ ከመ፡ ብእሲ፡ ዘይሬኢ፡ ፍጥረተ፡ ገጹ፡ በመጽሔት።"
        },
        {
          "number": 28,
          "unit_order": 28,
          "source_marker": "24",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=24"
          ],
          "text": "ወጠይቆ፡ ርእሶ፡ ኀለፈ፡ ወረስዐ፡ ዘከመ፡ እፎ፡ ውእቱ።"
        },
        {
          "number": 29,
          "unit_order": 29,
          "source_marker": "25",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Jam&chapter=1&verse=25"
          ],
