      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ተግሣጽ፡ ለአብዕልት"
        },
        {
          "number": 2,
          "unit_order": 2,
