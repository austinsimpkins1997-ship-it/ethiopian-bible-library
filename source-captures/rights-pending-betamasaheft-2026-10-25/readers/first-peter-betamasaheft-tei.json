      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ኅሩያን"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=1"
          ],
          "text": "እምጴጥሮስ፡ ልኡከ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ለኅሩያን፡ ለእለ፡ ሀለዉ፡ ውስተ፡ በሓውርተ፡ ጳንጦስ፡ ወገላትያ፡ ወቀጰዶቅያ፡ ወእስያ፡ ወቢታንያ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=2"
          ],
          "text": "ለእለ፡ ቀደሙ፡ አእምሮቶ፡ ለእግዚአብሔር፡ አብ፡ በመንፈስ፡ ቅዱስ። ከመ፡ ይስምዑ፡ በንዝሀተ፡ ደሙ፡ ለኢየሱስ፡ ክርስቶስ። ሞገስ፡ ወሰላም፡ ይብዛኅ፡ ለክሙ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=3"
          ],
          "text": "ይትባረክ፡ እግዚአብሔር፡ አቡሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘወለደነ፡ በብዝኀ፡ ምሕረቱ። ወለተስፋ፡ እንተ፡ ባቲ፡ ነሐዩ፡ በተንሥኦቱ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ እምነ፡ ምዉታን።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=4"
          ],
          "text": "ለተዋርሶ፡ ዘኢይበሊ፡ ወዘኢይረኵስ፡ ወዘኢይጸመሒ። ዘዕቁብ፡ ለነ፡ ወለክሙ፡ በሰማያት።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=5"
          ],
          "text": "ለእለ፡ በኀይለ፡ እግዚአብሔር፡ ዕቁባን፡ በሃይማኖት። ለመድኀኒት፡ እንተ፡ ድሉት፡ ከመ፡ ታስተርኢ፡ በደኃሪ፡ መዋዕል።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=6"
          ],
          "text": "ወትትፌሥሑ፡ እስከ፡ ለዓለም። ወባሕቱ፡ ኅዳጠ፡ ሀለወክሙ፡ ይእዜ፡ ትተክዙ፡ በዘይመጽአክሙ፡ መከራ፡ ዘዘ፡ ዚኣሁ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=7"
          ],
          "text": "ከመ፡ መከራሃ፡ ለሃይማኖትክሙ። ዘይትበደር፡ ፈድፋደ፡ እምወርቅ፡ ንጹሕ፡ ዘበእሳት፡ አመከርዎ። ወትትረከቡ፡ ሀለወክሙ፡ በክብር፡ ወበስብሐት፡ ወበውዳሴ። አመ፡ ያስተርኢ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=8"
          ],
          "text": "ውእቱኬ፡ ዘታፈቅርዎ፡ እንዘ፡ ኢትሬእይዎ፡ ወእስከ፡ ይእዜ፡ ኢርኢክምዎ። ወባሕቱ፡ ተአምኑ፡ ቦቱ፡ ወይእዜኒ፡ ትትፌሥሑ፡ በፍሥሓ፡ እንተ፡ አልባቲ፡ ማኅለቅት።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=9"
          ],
          "text": "ወትነሥኡ፡ በፍጻሜሃ፡ ለሃይማኖትክሙ፡ መድኀኒተ፡ ነፍስክሙ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=10"
          ],
          "text": "ይእቲኬ፡ መድኀኒት፡ እንተ፡ ኀሠሥዋ። ወዖድዋ፡ ነቢያት፡ እለ፡ ተነበዩ፡ በእንተ፡ ክብርክሙ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=11"
          ],
          "text": "እንዘ፡ የኀሥሡ፡ ለአይ፡ ወለማእዜ፡ መዋዕል። ዘነገረ፡ በእንቲኣሁ፡ በላዕሌሆሙ፡ መንፈሱ፡ ለኢየሱስ፡ ክርስቶስ። ወአቅደመ፡ ስምዐ፡ ከዊነ፡ በእንተ፡ ዘሀለዎ፡ ይሕምም፡ ክርስቶስ። ወበእንተ፡ ስብሐቲሁ፡ ዘእምድኅሬሁ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=12"
          ],
          "text": "እስመ፡ አስተርአዮሙ፡ ወአኮ፡ በርእሶሙ፡ ዘነገሩክሙ፡ ዘንተ፡ ዘይእዜ፡ ንዜንወክሙ። አላ፡ አይድዑክሙ፡ በመንፈስ፡ ቅዱስ፡ ዘተፈነወ፡ እምሰማይ። እምኀበ፡ ያፈትዎሙ፡ ለመላእክት፡ ከመ፡ የሐውጽዎ።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ዘትመጽእ፡ ትፍሥሕት"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=13"
          ],
          "text": "ወይእዜኒ፡ ቅንቱ፡ ሐቌ፡ ልብክሙ፡ ጥዩቀ፡ ወንቁሀ። ተሰፈውዋ፡ ለእንተ፡ ትመጽእ፡ ለክሙ፡ ትፍሥሕት፡ በአስተርእዮቱ፡ ለኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=14"
          ],
          "text": "ከመ፡ ውሉድ፡ እለ፡ ይትኤዘዙ። እንዘ፡ ኢትትመየጡ፡ ለእንተ፡ ቀዳሚ፡ ጌጋይክሙ፡ በኢያእምሮ፡ ዘፈተውክሙ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=15"
          ],
          "text": "ወባሕቱ፡ በከመ፡ ጸውዐክሙ፡ ቅዱስ፡ ውእቱ። አንትሙኒ፡ ኩኑ፡ ቅዱሳነ፡ በኵሉ፡ ግዕዝክሙ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=16"
          ],
          "text": "እስመ፡ ጽሑፍ፡ ዘይብል፡ ኩኑ፡ ቅዱሳነ፡ እስመ፡ ቅዱስ፡ አነ።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=17"
          ],
          "text": "ወእመሰ፡ ለአብ፡ ትጼውዕዎ፡ ለዘይኴንን። እንዘ፡ ገጸ፡ ኢይነሥእ፡ በበ፡ ምግባሪሁ፡ ለለ፡ አሐዱ። እንዘ፡ ትፈርሁ፡ በኵሉ፡ መዋዕለ፡ ሕይወትክሙ። ወበዘአመንክሙ፡ ሑሩ፡ ባቲ።"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ አእምሮ፡ ቤዛ"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=1Pe&chapter=1&verse=18"
          ],
          "text": "እንዘ፡ ተአምሩ፡ ከመ፡ አኮ፡ በዘይማስን፡ ብሩር፡ ወወርቅ። ዘተቤዘወክሙ፡ እምውስተ፡ ዘኢይበቊዕ፡ ምግባሪክሙ፡ ዘተመጠውክሙ፡ እምአበዊክሙ።"
        },
        {
