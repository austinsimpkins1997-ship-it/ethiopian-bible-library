          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=2&verse=22"
          ],
          "text": "ወተአምርዎ፡ ግእዞ፡ ለዝንቱ፡ ብእሲ። ዘከመ፡ ተቀንየ፡ ሊተ፡ ከመ፡ ወልድ፡ ለወላዲሁ፡ ለትምህርተ፡ ወንጌል።"
