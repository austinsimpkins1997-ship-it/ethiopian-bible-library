      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ዘከመ፡ ጸለየ፡ ለሰብአ፡ ፊልጵስዩስ"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=1"
          ],
          "text": "እምጳውሎስ፡ ወጢሞቴዎስ፡ አግብርተ፡ ኢየሱስ፡ ክርስቶስ። ለኵሎሙ፡ ቅዱሳን፡ እለ፡ ተቀደሱ፡ በኢየሱስ፡ ክርስቶስ። እለ፡ ሀለዉ፡ ፊልጵስዩስ፡ ምስለ፡ ቀሳውስት፡ ወዲያቆናት።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=2"
          ],
          "text": "ሰላም፡ ለክሙ፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=3"
          ],
          "text": "አአኵቶ፡ ለእግዚአብሔር፡ ዘልፈ፡ በኵሉ፡ ተዝካርክሙ፡ ኪያየ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=4"
          ],
          "text": "ወእጼሊ፡ በኵሉ፡ ጊዜ፡ በእንቲኣክሙ። ወእገብር፡ ጸሎተ፡ ፍሥሓ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=5"
          ],
          "text": "በእንተ፡ ተሳትፎትክሙ፡ ኪያየ፡ በትምህርተ፡ ወንጌል። እምቀዳሚት፡ ዕለት፡ እስከ፡ ይእዜ።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=6"
          ],
          "text": "እስመ፡ እትአመን፡ ከመ፡ ውእቱ፡ ዘወጠነ፡ ለክሙ፡ ግብረ፡ ሠናየ። ውእቱ፡ ይፌጽም፡ ለክሙ፡ እስከ፡ ዕለተ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=7"
          ],
          "text": "እስመ፡ ርቱዕ፡ ሊተ፡ ዘንተ፡ አኀሊ፡ በእንቲኣክሙ። እስመ፡ ሀሎክሙ፡ ውስተ፡ ልብየ፡ በመዋቅሕትየ፡ ወበቅስትየ፡ ወበትምህርተ፡ ጽድቅ። እስመ፡ ኀበርክሙ፡ ምስሌየ፡ በጸጋ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=8"
          ],
          "text": "ወእግዚአብሔር፡ ሰማዕትየ፡ ከመ፡ አፈቅረክሙ፡ በፍቅረ፡ ክርስቶስ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=9"
          ],
          "text": "ወእጼሊ፡ በእንተ፡ ዝንቱ። ከመ፡ ይብዛኅ፡ ወይፈድፍድ፡ ተፋቅሮትክሙ፡ በአእምሮ፡ ወበኵሉ፡ ጥበበ፡ መንፈስ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=10"
          ],
          "text": "ከመ፡ ትፍትኑ፡ ወታመክሩ፡ ዘይኄይስ፡ ወዘይሤኒ፡ ግብረ። ከመ፡ ትኩኑ፡ ቅዱሳነ፡ ዘእንበለ፡ ዕቅፍት፡ በዕለተ፡ ክርስቶስ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=11"
          ],
          "text": "እንዘ፡ ምሉኣን፡ አንትሙ፡ ፍሬ፡ ጽድቅ። በኢየሱስ፡ ክርስቶስ፡ በስብሐተ፡ እግዚአብሔር፡ ወአኰቴቱ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ተሞቅሖቱ፡ ለጳውሎስ"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=12"
          ],
          "text": "ወእፈቅድ፡ አኀዊነ፡ ታእምሩ፡ ዜናየ። ከመ፡ ፈድፋደ፡ ተለዐለ፡ ውስተ፡ ትምህርተ፡ ወንጌሉ፡ ለክርስቶስ።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=13"
          ],
          "text": "ወተዐውቀ፡ መዋቅሕትየ፡ በክርስቶስ፡ በኀበ፡ ኵሉ፡ ምኵናን፡ ወበኀበ፡ ኵሉ፡ ሰብእ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=14"
          ],
          "text": "ወከመ፡ ብዙኃን፡ እምአኀዊነ፡ ምእመናን፡ በእግዚእነ፡ ተዐገሡ፡ በመዋቅሕትየ። ወፈድፋደ፡ ተኀበሉ፡ ይንግሩ፡ አጥቢዖሙ፡ ቃለ፡ እግዚአብሔር፡ ዘእንበለ፡ ፍርሀት።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=15"
          ],
          "text": "ወቦ፡ እለ፡ በቅንአቶሙ፡ ወቦ፡ እለ፡ በተቃሕዎቶሙ። ወቦ፡ እለ፡ ፈቀዱ፡ ይስብኩ፡ በፍቅር፡ ሠናይ፡ ወይምሀሩ፡ በእንተ፡ ክርስቶስ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=16"
          ],
          "text": "እስመ፡ የአምሩ፡ ከመ፡ ለምህሮ፡ ወንጌል፡ ተሠየምኩ፡ ዓዲ።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=17"
          ],
          "text": "ወእለሰ፡ በትዝኅርቶሙ፡ ይነግሩ፡ በእንተ፡ ክርስቶስ፡ አኮ፡ በንጽሕ። ዳእሙ፡ ይትሐዘቡ፡ ከመ፡ ገቢሮሙ፡ ኪያሁ፡ ይወስኩ፡ ሊተ፡ ሕማመ፡ በመዋቅሕትየ።"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=18"
          ],
          "text": "ወናሁ፡ ተፈሣሕኩ፡ በዝንቱ፡ ወእትፌሣሕኒ፡ ቦቱ፡ በኵሉ፡ ምክንያት። ይንግሩ፡ በእንተ፡ ክርስቶስ፡ እመኒ፡ በአድልዎ፡ ወእመኒ፡ በአማን። ወይጸውዑ፡ ኀቤሁ፡ ኵሎ፡ ሰብእ።"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "19",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=19"
          ],
          "text": "ወአነ፡ አአምር፡ ከመ፡ ዛቲ፡ ግብር፡ ታበጽሐኒ፡ ኀበ፡ ሕይወት። በጸሎትክሙ፡ ወበሀብተ፡ መንፈሱ፡ ለኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 22,
          "unit_order": 22,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ሕይወት፡ በእንተ፡ ክርስቶስ"
        },
        {
          "number": 23,
          "unit_order": 23,
          "source_marker": "20",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=20"
          ],
          "text": "በከመ፡ ተሰፈውኩ፡ ወተወከልኩ፡ ከመ፡ ኢይትኀፈር፡ ወኢ፡ በምንትኒ። ዳእሙ፡ ገሃደ፡ በፍሥሓ፡ መንፈስ፡ ከመ፡ ዘልፍ። ወይእዜኒ፡ ዕበዩ፡ ለክርስቶስ፡ በሥጋየ። እመኒ፡ በሕይወትየ፡ ወእመኒ፡ በሞትየ።"
        },
        {
          "number": 24,
          "unit_order": 24,
          "source_marker": "21",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Phi&chapter=1&verse=21"
          ],
          "text": "አንሰ፡ እመኒ፡ ሐየውኩ፡ ለክርስቶስ፡ ወእመኒ፡ ሞትኩ፡ ርቡኅ፡ ሊተ።"
        },
