          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=2&verse=22"
          ],
          "text": "ዘያመስልዎ፡ ጥበበ፡ በእንተ፡ ትሕትና፡ ልብ፡ ወፍርሀተ፡ እግዚአብሔር።"
        },
