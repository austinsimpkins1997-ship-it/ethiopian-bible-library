        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=18"
          ],
          "text": "ወውእቱ፡ ርእሳ፡ ለቤተ፡ ክርስቲያን። እስመ፡ ውእቱ፡ በኵር፡ ቀደመ፡ እምኵሎሙ፡ ምዉታን፡ ተንሥኦ። ከመ፡ ይኩን፡ ውእቱ፡ ርእሰ፡ ለኵሉ።"
        },
        {
          "number": 22,
          "unit_order": 22,
          "source_marker": "19",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=19"
          ],
          "text": "እስመ፡ ሠምረ፡ ቦቱ፡ ፍጹመ፡ ኵሉ፡ ይኅድር፡ ላዕሌሁ። ወቦቱ፡ ይሣሀል፡ ለኵሉ።"
        },
        {
          "number": 23,
          "unit_order": 23,
          "source_marker": "20",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=20"
          ],
          "text": "ወገብረ፡ ሰላመ፡ በደመ፡ መስቀሉ፡ ለዘበሰማይ፡ ወለዘበምድር።"
        },
        {
          "number": 24,
          "unit_order": 24,
          "source_marker": "21",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=21"
          ],
          "text": "ወአንትሙሂ፡ ትካት፡ ፀሩ፡ ወነኪሩ፡ በልብክሙ፡ ወበእከየ፡ ምግባሪክሙ።"
        },
