          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=3&verse=7"
          ],
          "text": "ዘቦቱ፡ ሖርክሙ፡ አንትሙሂ፡ ትካት፡ አመ፡ ሐየውክሙ፡ በዝንቱ፡ ግብር።"
