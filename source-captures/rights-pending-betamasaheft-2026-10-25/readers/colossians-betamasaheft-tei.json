        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=3&verse=2"
          ],
          "text": "ዘላዕሉ፡ ኀልዩ፡ ወአኮ፡ ዘበምድር።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=3&verse=3"
          ],
          "text": "እስመ፡ ወዳእክሙ፡ ሞትክሙ። ወኅብእት፡ ሕይወትክሙ፡ ምስለ፡ ክርስቶስ፡ በኀበ፡ እግዚአብሔር።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=3&verse=4"
          ],
          "text": "ወአመ፡ ይመጽእ፡ ክርስቶስ፡ ይትዐወቅ፡ ሕይወትክሙ። ይእተ፡ አሚረ፡ ታስተርእዩ፡ ምስሌሁ፡ በስብሐት፡ ዐቢይ።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ መዊት፡ እምኀጢአት"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=3&verse=5"
          ],
          "text": "አሙትዎ፡ ለነፍስትክሙ፡ ዘዲበ፡ ምድር፡ እምዝሙት፡ ወርኩስ፡ ወመንሱት። ወፍትወት፡ እኪት፡ ወትዕግልት፡ ዘውእቱ፡ አምልኮ፡ ጣዖት።"
