      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ትንሣኤ፡ ልቡና"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=3&verse=1"
          ],
          "text": "ወእመሰ፡ ተንሣእክሙ፡ ምስለ፡ ክርስቶስ፡ ዘላዕለ። ኅሡ፡ ኀበ፡ ሀሎ፡ ክርስቶስ፡ በየማነ፡ እግዚአብሔር፡ ይነብር።"
