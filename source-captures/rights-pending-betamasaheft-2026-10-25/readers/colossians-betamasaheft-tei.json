      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ዘከመ፡ ይደሉ፡ ጸልዮ፡ በእንተ፡ ቢጽ"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=1"
          ],
          "text": "እምጳውሎስ፡ ሐዋርያሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ በፈቃደ፡ እግዚአብሔር፡ ወጢሞቴዎስ፡ እኁነ። ለቅዱሳን፡ እለ፡ ውስተ፡ ቈላስይስ፡ ወምእመናን፡ አኀዊነ፡ በክርስቶስ።"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=2"
          ],
          "text": "ሰላም፡ ለክሙ፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=3"
          ],
          "text": "ነአኵቶ፡ ለእግዚአብሔር፡ አቡሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘልፈ፡ በእንቲኣክሙ፡ ወንጼሊ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=4"
          ],
          "text": "እምአመ፡ ሰማዕነ፡ ሃይማኖትክሙ፡ በኢየሱስ፡ ክርስቶስ። ወዘከመ፡ ታፈቅርዎሙ፡ ለኵሎሙ፡ ቅዱሳን።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=5"
          ],
          "text": "በእንተ፡ ተስፋክሙ፡ ዘሥዩም፡ ለክሙ፡ በሰማያት። ዘአቅደምክሙ፡ ሰሚዐ፡ በቃለ፡ ጽድቅ፡ ትምህርተ፡ ወንጌል።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=6"
          ],
          "text": "ዘበጽሐ፡ ኀቤክሙ፡ ከመ፡ በኵሉ፡ ዓለም፡ ይፍረይ፡ ወይሥመር፡ በላዕሌክሙ። እምአመ፡ ሰማዕክሙ፡ ወርኢክሙ፡ ጸጋ፡ እግዚአብሔር፡ በጽድቅ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=7"
          ],
          "text": "ዘተመሀርክሙ፡ በኀበ፡ ኤጳፍራስ፡ እኁነ። ላእከ፡ ዚኣነ፡ ምእመን፡ በክርስቶስ፡ ዘይትለአክ፡ በእንቲኣክሙ።"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=8"
          ],
          "text": "ወውእቱ፡ ነገረነ፡ ተፋቅሮተክሙ፡ በመንፈስ።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=9"
          ],
          "text": "ወበእንተ፡ ዝ፡ ንሕነሂ፡ እምአመ፡ ሰማዕነ፡ ዜናክሙ፡ ኢኀደግነ፡ ጸልዮ፡ በእንቲኣክሙ። ወስኢለ፡ ከመ፡ ትፈጽሙ፡ አእምሮ፡ ፈቃዱ፡ ለእግዚአብሔር። በኵሉ፡ ጥበብ፡ ወበኵሉ፡ ምክረ፡ መንፈስ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=10"
          ],
          "text": "ከመ፡ ትሑሩ፡ በዘይደልወክሙ፡ ለኀበ፡ እግዚአብሔር። ወበኵሉ፡ ታድልዉ፡ ሎቱ፡ በምግባረ፡ ሠናይ። እንዘ፡ ትፈርዩ፡ ወትሠምሩ፡ በጥበበ፡ አእምሮ፡ እግዚአብሔር።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=11"
          ],
          "text": "እንዘ፡ ትጸንዑ፡ በኵሉ፡ ኀይል። በበ፡ ጽንዐ፡ ስብሐቲሁ፡ በኵሉ፡ ትዕግሥት፡ ወበተስፋ፡ ወበፍሥሓ።"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ አኰቴት"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=12"
          ],
          "text": "አእኵትዎ፡ ለእግዚአብሔር፡ አብ፡ ዘረሰየነ፡ ድልዋነ። ለመክፈልተ፡ ርስቶሙ፡ ለቅዱሳን፡ በብርሃን።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=13"
          ],
          "text": "ወአድኀነነ፡ እምኵነኔ፡ ጽልመት። ወአግብአነ፡ ውስተ፡ መንግሥተ፡ ወልዱ፡ ፍቁሩ።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=14"
          ],
          "text": "ዘቦቱ፡ ረከብነ፡ መድኀኒተ፡ ወተኀድገ፡ ለነ፡ ኀጢአትነ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=15"
          ],
          "text": "ዘውእቱ፡ አምሳሊሁ፡ ለእግዚአብሔር፡ ዘኢያስተርኢ፡ በኵሩ፡ ዘላዕለ፡ ኵሉ፡ ተግባሩ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=16"
          ],
          "text": "እስመ፡ ቦቱ፡ ኵሎ፡ ፈጠረ፡ ዘበሰማይኒ፡ ወዘበምድርኒ፡ ዘያስተርኢ፡ ወዘኢያስተርኢ። እመኒ፡ መናብርት፡ ወእመኒ፡ አጋእዝት፡ ወእመኒ፡ መኳንንት፡ ወእመኒ፡ ቀደምት። ኵሉ፡ ዘኮነ፡ በእዴሁ፡ ወኵሉ፡ ቦቱ፡ ተፈጥረ።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=1&verse=17"
          ],
          "text": "ወውእቱ፡ ህልው፡ እምቅድመ፡ ኵሉ፡ ወኵሉ፡ ቦቱ፡ ቆመ።"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ሰላም"
