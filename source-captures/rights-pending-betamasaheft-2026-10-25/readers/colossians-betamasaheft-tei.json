          "number": 29,
          "unit_order": 29,
          "source_marker": "24",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=3&verse=24"
          ],
          "text": "ወዘሰ፡ ዐመፀ፡ ይረክብ፡ ፍዳሁ፡ ወኢያደሉ፡ ሎቱ።"
        }
      ],
      "notes": []
    },
    {
      "chapter": 4,
      "source_chapter_label": "4",
      "heading": [
        "ምዕራፍ 4"
      ],
      "units": [
        {
          "number": 1,
          "unit_order": 1,
          "source_marker": "1",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=1"
          ],
          "text": "አጋእዝትኒ፡ ዕሩየ፡ ግበሩ፡ ሎሙ፡ ለነባሪክሙ፡ ወፍትሑ፡ ጽድቀ። ተአምሩ፡ ከመ፡ ብክሙ፡ እግዚእ፡ በሰማያት።"
        },
        {
          "number": 2,
          "unit_order": 2,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "በእንተ፡ ተፀምዶ፡ ለጸሎት"
        },
        {
          "number": 3,
          "unit_order": 3,
          "source_marker": "2",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=2"
          ],
          "text": "ወተፀመዱ፡ ለጸሎት፡ እንዘ፡ ትተግሁ፡ በአኰቴት።"
        },
        {
          "number": 4,
          "unit_order": 4,
          "source_marker": "3",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=3"
          ],
          "text": "ጸልዩ፡ ወሰአሉ፡ ለነሂ፡ ከመ፡ ያርኁ፡ ለነ፡ እግዚአብሔር፡ አናቅጸ፡ ቃል። ከመ፡ ንንግር፡ ምክረ፡ ዘእምኀበ፡ እግዚአብሔር፡ ዘበእንቲኣሁ፡ ተሞቃሕኩ።"
        },
        {
          "number": 5,
          "unit_order": 5,
          "source_marker": "4",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=4"
          ],
          "text": "ከመ፡ እክሥቶ፡ በከመ፡ ይደልወኒ፡ እንግር።"
        },
        {
          "number": 6,
          "unit_order": 6,
          "source_marker": "5",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=5"
          ],
          "text": "ሑሩ፡ በልቡና፡ በኀበ፡ ባዕዳን፡ እምሃይማኖት።"
        },
        {
          "number": 7,
          "unit_order": 7,
          "source_marker": "6",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=6"
          ],
          "text": "ወይኩን፡ ነገርክሙ፡ በጸጋ፡ ወቅሱመ፡ በጼው። ከመ፡ ታእምሩ፡ ዘትትዋሥኡ፡ ለለ፡ አሐዱ፡ አሐዱ።"
        },
        {
          "number": 8,
          "unit_order": 8,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "ዜና፡ መምህር፡ በረድእ"
        },
        {
          "number": 9,
          "unit_order": 9,
          "source_marker": "7",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=7"
          ],
          "text": "ወኵሎ፡ ዜናየ፡ ይዜንወክሙ፡ ጢኪቆስ፡ እኁነ፡ ምእመን፡ ዘነኀብር፡ ተቀንዮ። ዘውእቱ፡ እኁክሙ፡ በእግዚአብሔር።"
        },
        {
          "number": 10,
          "unit_order": 10,
          "source_marker": "8",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=8"
          ],
          "text": "ዘፈነውክዎ፡ ኀቤክሙ፡ በእንተ፡ ዝንቱ፡ ግብር። ከመ፡ ታእምሩ፡ ዜናየ፡ ወያስተፍሥሕክሙ፡ ልበክሙ።"
        },
        {
          "number": 11,
          "unit_order": 11,
          "source_marker": "9",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=9"
          ],
          "text": "ምስለ፡ አናሲሞስ፡ እኁነ፡ ምእመን፡ ዘናፍቅር፡ ዘውእቱ፡ ብእሲ፡ እምኔክሙ። ወእሙንቱ፡ ያጤይቁክሙ፡ ግብረነ፡ ወዘሀሎነ፡ ቦቱ።"
        },
        {
          "number": 12,
          "unit_order": 12,
          "source_marker": null,
          "source_element_id": null,
          "source_refs": [],
          "text": "አምኃ፡ ለአርድእት"
        },
        {
          "number": 13,
          "unit_order": 13,
          "source_marker": "10",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=10"
          ],
          "text": "አምኁክሙ፡ አርስጥሮኮስ፡ ዘተፄወወ፡ ምስሌየ። ወማርቆስ፡ ወልደ፡ እኅወ፡ አቡሁ፡ ለበርናባስ፡ ዘበእንቲኣሁ፡ አዘዝኩክሙ።"
        },
        {
          "number": 14,
          "unit_order": 14,
          "source_marker": "11",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=11"
          ],
          "text": "ከመ፡ አመ፡ መጽአ፡ ኀቤክሙ፡ ትትወከፍዎ። ወኢያሱ፡ ዘተሰምየ፡ ኢዩስጦስ፡ እለ፡ እምሰብአ፡ ግዝረት። ወእሉ፡ ዳእሙ፡ ረድኤትየ፡ በግብረ፡ መንግሥተ፡ እግዚአብሔር፡ ወአስተፍሥሑኒ።"
        },
        {
          "number": 15,
          "unit_order": 15,
          "source_marker": "12",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=12"
          ],
          "text": "አምኀክሙ፡ ኤጳፍራስ፡ ዘእምኀቤክሙ፡ ውእቱ፡ ገብረ፡ ክርስቶስ። ወዘልፈ፡ ይጼሊ፡ በእንቲኣክሙ፡ ወይስእል፡ ከመ፡ ትኩኑ፡ ፍጹማነ፡ ወምሉኣነ፡ በኵሉ፡ ሥምረተ፡ እግዚአብሔር።"
        },
        {
          "number": 16,
          "unit_order": 16,
          "source_marker": "13",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=13"
          ],
          "text": "ወአነ፡ ሰማዕቱ፡ ከመ፡ ፈድፋደ፡ ያፈቅረክሙ፡ ወይቴክዝ፡ በእንቲኣክሙ። ወለእለ፡ በሎዶቅያ፡ ወሀገረ፡ ኢያራ።"
        },
        {
          "number": 17,
          "unit_order": 17,
          "source_marker": "14",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=14"
          ],
          "text": "አምኀክሙ፡ ሉቃስ፡ ዐቃቤ፡ ሥራይ፡ ፍቁርነ፡ ወዴማስ።"
        },
        {
          "number": 18,
          "unit_order": 18,
          "source_marker": "15",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=15"
          ],
          "text": "አምኅዎሙ፡ ለአኀዊነ፡ እለ፡ በሎዶቅያ፡ ወንምፋን። ወእለ፡ ሀለዉ፡ ቤተ፡ ክርስቲያን።"
        },
        {
          "number": 19,
          "unit_order": 19,
          "source_marker": "16",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=16"
          ],
          "text": "ወአንቢበክሙ፡ ዛተ፡ መጽሐፈ፡ ፈንውዋ፡ ሎዶቅያ፡ ያንብብዋ፡ በቤተ፡ ክርስቲያን። ወካዕበ፡ አንብብዋ፡ አንትሙ፡ ለመልእክት፡ እንተ፡ ጸሐፍኩ፡ እምሎዶቅያ።"
        },
        {
          "number": 20,
          "unit_order": 20,
          "source_marker": "17",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=17"
          ],
          "text": "ወበልዎ፡ ለአክርጳ፡ ዑቅአ፡ መልእክተከ፡ ዘተሠየምከ፡ እምኀበ፡ እግዚአብሔር፡ ከመ፡ ትፈጽም።"
        },
        {
          "number": 21,
          "unit_order": 21,
          "source_marker": "18",
          "source_element_id": null,
          "source_refs": [
            "http://classic.net.bible.org/verse.php?book=Col&chapter=4&verse=18"
          ],
          "text": "ወአማኅኩክሙ፡ ጽሒፍየ፡ በእዴየ፡ አነ፡ ጳውሎስ። ተዘከሩ፡ መዋቅሕትየ፡ ጸጋ፡ ምስሌክሙ፡ አሜን።"
        }
      ],
      "notes": []
    }
  ]
