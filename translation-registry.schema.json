{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://austinsimpkins1997-ship-it.github.io/ethiopian-bible-library/translation-registry.schema.json",
  "title": "Ethiopian Bible Library language and translation registry",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "coverage_statement",
    "basis_languages",
    "languages",
    "translation_leads",
    "corpus_leads",
    "edition_leads",
    "research_corpora",
    "translation_process_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "coverage_statement": {
      "type": "string",
      "minLength": 1
    },
    "basis_languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language_tag",
          "language_name",
          "role",
          "source_ids"
        ],
        "properties": {
          "language_tag": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
          },
          "language_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "Evidence for the language subtag and the stated basis-language role."
          }
        },
        "additionalProperties": false
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "translation_leads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/translationLead"
      }
    },
    "corpus_leads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/corpusLead"
      }
    },
    "edition_leads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/editionLead"
      }
    },
    "research_corpora": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/researchCorpus"
      }
    },
    "translation_process_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/translationProcessEvidence"
      }
    },
    "edition_basis_evidence": {
      "type": "array",
      "description": "Attributed edition-family basis claims kept separate from verified paths for specific digital witnesses.",
      "items": { "$ref": "#/$defs/editionBasisEvidence" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "translationLead": {
      "type": "object",
      "required": [
        "translation_id",
        "canon_id",
        "title",
        "mapping_state",
        "scope_description",
        "language_tag",
        "translator",
        "edition",
        "translation_path",
        "source_ids",
        "text_bundled",
        "rights_status",
        "rights_classification",
        "review_status",
        "notes"
      ],
      "properties": {
        "translation_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier for this bibliographic translation lead; it does not imply bundled text."
        },
        "canon_id": {
          "type": "string",
          "minLength": 1,
          "description": "Church-list candidate entry for this lead; mapping_state qualifies the strength of that association."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mapping_state": {
          "enum": ["asserted_by_source", "reviewed_match", "related_work", "uncertain"]
        },
        "scope_description": {
          "type": "string",
          "minLength": 1,
          "description": "What this translation lead covers and what remains unverified."
        },
        "language_tag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "translator": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "translation_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
              }
            }
          ],
          "description": "Ordered BCP 47 tags from source through any relay language to output; null means the path is not established."
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "text_bundled": {
          "const": false,
          "description": "No normalized reader-text layer is bundled for this lead; an exact source file may be stored separately with source_snapshot metadata."
        },
        "source_snapshot": {
          "type": "object",
          "description": "Optional byte-verified local copy of the cited source rendition. This is not a proofread transcription, normalized reader, or evidence of worldwide reuse rights.",
          "required": ["path", "sha256", "source_url", "format", "status"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "source_url": { "type": "string", "format": "uri", "minLength": 1 },
            "format": { "enum": ["text/plain", "text/html", "application/xml", "application/pdf"] },
            "status": { "const": "exact-source-rendition; reader structure and text accuracy not independently verified" }
          },
          "additionalProperties": false
        },
        "rights_status": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "rights_classification": {
          "enum": [
            "public_domain_claimed",
            "open_license",
            "permission_limited",
            "all_rights_reserved",
            "unknown",
            "mixed"
          ],
          "description": "Controlled rights category; detailed jurisdiction, attribution, and restrictions remain in rights_status."
        },
        "license_id": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "rights_classification": { "const": "open_license" } }, "required": ["rights_classification"] },
          "then": { "required": ["license_id", "license_url"] }
        }
      ],
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "required": [
        "language_tag",
        "language_name",
        "script_code",
        "source_ids",
        "direction",
        "availability_survey",
        "records"
      ],
      "properties": {
        "language_tag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "language_name": {
          "type": "string",
          "minLength": 1
        },
        "script_code": {
          "type": "string",
          "pattern": "^[A-Z][a-z]{3}$",
          "description": "Legacy single-script field; use Zzzz when this language record has no single default script. See script_codes and script_profile_note."
        },
        "script_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]{3}$"
          },
          "uniqueItems": true,
          "description": "All writing systems supported by evidence for this language profile; do not infer that a list is exhaustive."
        },
        "script_profile_note": {
          "type": "string",
          "description": "Evidence scope, variation, uncertainty, or dates for the language-level script profile."
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Evidence for the language identity, language-tag value, and script profile."
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "unknown"
          ],
          "description": "HTML-compatible base bidirectional text direction. Use auto when direction is unknown in the rendered text; vertical orientation belongs in writing_mode."
        },
        "writing_mode": {
          "enum": [
            "horizontal-tb",
            "vertical-rl",
            "vertical-lr",
            "unknown"
          ],
          "description": "Optional evidenced writing orientation. Leave absent or unknown when the language/witness writing mode is not established; do not infer vertical orientation from a script name."
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "availability_survey": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["not_surveyed", "in_progress", "completed"] },
            "scope": { "type": "string", "minLength": 1 },
            "searched_at": { "type": "string", "format": "date" },
            "result": { "enum": ["records_found", "none_found"] },
            "result_count": { "type": "integer", "minimum": 0 },
            "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "notes": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "not_surveyed" } }, "required": ["status"] },
              "then": {
                "not": {
                  "anyOf": [
                    { "required": ["scope"] },
                    { "required": ["searched_at"] },
                    { "required": ["result"] },
                    { "required": ["result_count"] },
                    { "properties": { "source_ids": { "minItems": 1 } }, "required": ["source_ids"] }
                  ]
                }
              }
            },
            {
              "if": { "properties": { "status": { "const": "in_progress" } }, "required": ["status"] },
              "then": {
                "not": {
                  "anyOf": [
                    { "required": ["searched_at"] },
                    { "required": ["result"] },
                    { "required": ["result_count"] }
                  ]
                }
              }
            },
            {
              "if": { "properties": { "status": { "enum": ["in_progress", "completed"] } }, "required": ["status"] },
              "then": { "required": ["scope", "source_ids"], "properties": { "source_ids": { "minItems": 1 } } }
            },
            {
              "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
              "then": { "required": ["searched_at", "result", "result_count"] }
            },
            {
              "if": { "properties": { "result": { "const": "none_found" } }, "required": ["result"] },
              "then": { "properties": { "result_count": { "const": 0 } } }
            },
            {
              "if": { "properties": { "result": { "const": "records_found" } }, "required": ["result"] },
              "then": { "properties": { "result_count": { "minimum": 1 } } }
            }
          ],
          "additionalProperties": false,
          "description": "External availability survey state. A zero/none-found result requires a bounded completed survey and cited sources; archive record absence alone is not a survey."
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": [
        "canon_id",
        "reader_id",
        "layer_role",
        "status",
        "basis_language_tag",
        "basis_description",
        "rights_status",
        "rights_classification",
        "source_ids"
      ],
      "properties": {
        "canon_id": {
          "type": "string",
          "minLength": 1
        },
        "reader_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Required for bundled records; null is allowed for a source-backed metadata-only candidate."
        },
        "translation_id": {
          "type": "string",
          "minLength": 1
        },
        "layer_role": {
          "enum": [
            "source_text_transcription",
            "source_text_edition",
            "translation",
            "historical_companion_translation",
            "transliteration",
            "paraphrase",
            "draft_translation"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "transcribed",
            "source_checked",
            "translated_draft",
            "translation_reviewed",
            "bundled"
          ]
        },
        "translator": {
          "type": "string",
          "minLength": 1
        },
        "basis_language_tag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "basis_description": {
          "type": "string",
          "minLength": 1
        },
        "translation_path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
          },
          "description": "Ordered BCP 47 tags from source through any relay language to output."
        },
        "rights_status": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rights_classification": {
          "enum": [
            "public_domain_claimed",
            "open_license",
            "permission_limited",
            "all_rights_reserved",
            "unknown",
            "mixed"
          ],
          "description": "Controlled rights category; detailed jurisdiction, attribution, and restrictions remain in rights_status."
        },
        "license_id": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "layer_role": {
                "enum": ["translation", "historical_companion_translation", "draft_translation"]
              }
            },
            "required": ["layer_role"]
          },
          "then": {
            "required": ["translation_id", "translator", "translation_path"]
          }
        },
        {
          "if": { "properties": { "rights_classification": { "const": "open_license" } }, "required": ["rights_classification"] },
          "then": { "required": ["license_id", "license_url"] }
        }
      ],
      "additionalProperties": false
    },
    "corpusLead": {
      "type": "object",
      "required": [
        "corpus_id",
        "title",
        "language_tag",
        "language_name",
        "script_code",
        "publisher",
        "publication_year",
        "scope_description",
        "basis_language_tag",
        "basis_description",
        "translation_path",
        "contributors",
        "text_bundled",
        "rights_status",
        "rights_classification",
        "review_status",
        "source_ids",
        "notes"
      ],
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language_tag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "language_name": {
          "type": "string",
          "minLength": 1
        },
        "script_code": {
          "type": "string",
          "pattern": "^[A-Z][a-z]{3}$",
          "description": "Script of this specific witness when known; use Zzzz when the edition's script has not been verified."
        },
        "script_status": {
          "enum": [
            "identified",
            "unidentified",
            "provisional"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publication_year": {
          "type": "string",
          "minLength": 1
        },
        "scope_description": {
          "type": "string",
          "minLength": 1
        },
        "basis_language_tag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "basis_description": {
          "type": "string",
          "minLength": 1
        },
        "translation_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
              }
            }
          ],
          "description": "Ordered BCP 47 tags from source through any relay language to output; null means the path is not established."
        },
        "contributors": {
          "type": "string",
          "minLength": 1
        },
        "text_bundled": {
          "const": false
        },
        "rights_status": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "rights_classification": {
          "enum": [
            "public_domain_claimed",
            "open_license",
            "permission_limited",
            "all_rights_reserved",
            "unknown",
            "mixed"
          ],
          "description": "Controlled rights category; detailed jurisdiction, attribution, and restrictions remain in rights_status."
        },
        "license_id": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri", "minLength": 1 },
        "candidate_canon_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Church-list work/title link for this research corpus; the accompanying mapping state distinguishes archive-reviewed, source-asserted, provisional, and unmapped cases. Research readers remain distinct from verified tradition-specific editions."
        },
        "canon_mapping_state": {
          "enum": ["asserted_by_source", "reviewed_match", "uncertain", "not_mapped"],
          "description": "asserted_by_source records a named source's explicit title or identity statement; it does not mean the archive has independently verified the match or counted the research text as canon-linked coverage."
        },
        "canon_mapping_note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "rights_classification": { "const": "open_license" } }, "required": ["rights_classification"] },
          "then": { "required": ["license_id", "license_url"] }
        }
      ],
      "additionalProperties": false
    },
    "editionLead": {
      "type": "object",
      "required": [
        "edition_id",
        "candidate_canon_id",
        "mapping_state",
        "title",
        "witness_type",
        "language_tag",
        "language_name",
        "script_code",
        "edition_statement",
        "scope_description",
        "source_ids",
        "text_bundled",
        "rights_status",
        "rights_classification",
        "review_status"
      ],
      "properties": {
        "edition_id": { "type": "string", "minLength": 1 },
        "candidate_canon_id": { "type": ["string", "null"], "minLength": 1, "description": "Provisional link to a Church-list entry; null with mapping_state not_mapped means the source is recorded without an assigned Church-list crosswalk." },
        "mapping_state": { "enum": ["asserted_by_source", "reviewed_match", "related_work", "uncertain", "not_mapped"] },
        "title": { "type": "string", "minLength": 1 },
        "witness_type": { "enum": ["manuscript", "printed_edition", "critical_edition", "digital_edition", "digital_service", "transcription", "composite", "unknown"] },
        "language_tag": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
        "language_name": { "type": "string", "minLength": 1 },
        "language_tags": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" }, "minItems": 2, "uniqueItems": true, "description": "Explicit component language tags for a multilingual witness whose primary tag is IANA mul." },
        "script_code": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" },
        "edition_statement": { "type": "string", "minLength": 1 },
        "scope_description": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "text_bundled": { "const": false, "description": "This metadata lead contains no text itself. Use bundled_reader_id to point to a corresponding local reader when one exists." },
        "bundled_reader_id": { "type": "string", "minLength": 1, "description": "Optional ID of a separate bundled reader for this source-edition lead; this pointer does not establish the canon crosswalk." },
        "raw_extraction": {
          "type": "object",
          "description": "Optional metadata for a bundled machine-derived or otherwise unproofread text extraction that is not a verified reader.",
          "required": ["path", "sha256", "source_sha256", "method", "status"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "method": { "type": "string", "minLength": 1 },
            "status": { "const": "unproofread; not reader text or a verified translation" }
          },
          "additionalProperties": false
        },
        "rights_status": { "type": "string", "minLength": 1 },
        "rights_classification": { "enum": ["public_domain_claimed", "open_license", "permission_limited", "all_rights_reserved", "unknown", "mixed"] },
        "license_id": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri", "minLength": 1 },
        "review_status": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "rights_classification": { "const": "open_license" } }, "required": ["rights_classification"] },
          "then": { "required": ["license_id", "license_url"] }
        },
        {
          "if": { "properties": { "language_tag": { "const": "mul" } }, "required": ["language_tag"] },
          "then": { "required": ["language_tags"], "properties": { "language_name": { "const": "Multiple languages" } } }
        },
        {
          "if": { "properties": { "language_tag": { "const": "und" } }, "required": ["language_tag"] },
          "then": {
            "properties": { "language_name": { "const": "Undetermined" }, "script_code": { "const": "Zzzz" } },
            "not": { "required": ["language_tags"] }
          }
        },
        {
          "if": { "properties": { "mapping_state": { "const": "not_mapped" } }, "required": ["mapping_state"] },
          "then": { "properties": { "candidate_canon_id": { "type": "null" } } },
          "else": { "properties": { "candidate_canon_id": { "type": "string", "minLength": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "researchCorpus": {
      "type": "object",
      "required": [
        "corpus_id", "title", "reader_id", "unit_count", "reader_status",
        "canon_mapping_state", "candidate_canon_id", "canon_mapping_note",
        "language_description", "script_description", "language_tag", "script_code", "unit_summary",
        "rights_classification", "rights_status", "review_status", "source_ids"
      ],
      "properties": {
        "corpus_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reader_id": { "type": "string", "minLength": 1 },
        "unit_count": { "type": "integer", "minimum": 0 },
        "reader_status": { "enum": ["bundled_research_reader"] },
        "canon_mapping_state": { "enum": ["asserted_by_source", "reviewed_match", "uncertain", "not_mapped"], "description": "reviewed_match means the archive reviewed the work/title crosswalk against cited evidence; it does not establish EOTC/Eritrean affiliation, exact edition identity, completeness, accuracy, or translation basis, and it does not make the research reader canon-linked coverage. Research readers remain distinct from verified tradition-specific editions." },
        "candidate_canon_id": { "type": ["string", "null"], "minLength": 1, "description": "A Church-list work/title mapping for this research reader; null is required when no crosswalk is assigned. A reviewed title match does not make this a verified tradition-specific edition or a canon-linked coverage reader." },
        "canon_mapping_note": { "type": "string", "minLength": 1 },
        "language_description": { "type": "string", "minLength": 1 },
        "script_description": { "type": "string", "minLength": 1 },
        "unit_summary": { "type": "string", "minLength": 1 },
        "rights_classification": {
          "enum": ["public_domain_claimed", "open_license", "permission_limited", "all_rights_reserved", "unknown", "mixed"]
        },
        "rights_status": { "type": "string", "minLength": 1 },
        "license_id": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri", "minLength": 1 },
        "review_status": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "text_origin": { "enum": ["source_transcription", "published_translation"] },
        "language_tag": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$", "description": "BCP 47 tag for the actual reader text. Match the reader and a registered profile; use und only when the text language is genuinely unidentified. Language and script are independent observations." },
        "script_code": { "type": "string", "pattern": "^[A-Z][a-z]{3}$", "description": "ISO 15924 script code for the actual reader text. Match the reader; use a script supported by its language profile when known. Use Zzzz only when the script itself is unidentified, even if language is und." },
        "basis_language_tag": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
        "translation_path": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" } },
        "translation_id": { "type": "string", "minLength": 1 },
        "translator": { "type": "string", "minLength": 1 },
        "translation_basis_status": {
          "enum": ["established", "unknown"],
          "description": "Whether the cited edition/source evidence identifies the translation basis; established does not verify translator workflow, wording accuracy, or intermediary languages beyond the recorded path."
        },
        "translation_basis_note": {
          "type": "string",
          "minLength": 1,
          "description": "Evidence and limits for the claimed or unknown source language/translation path."
        },
        "translation_basis_source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Source records that directly support the stated source-language path. Present only when the path is established."
        },
        "edition_statement": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "rights_classification": { "const": "open_license" } }, "required": ["rights_classification"] },
          "then": { "required": ["license_id", "license_url"] }
        },
        {
          "if": { "properties": { "canon_mapping_state": { "const": "not_mapped" } }, "required": ["canon_mapping_state"] },
          "then": { "properties": { "candidate_canon_id": { "type": "null" } } },
          "else": { "properties": { "candidate_canon_id": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "text_origin": { "const": "published_translation" } }, "required": ["text_origin"] },
          "then": {
            "required": ["language_tag", "script_code", "translation_id", "translator", "edition_statement", "translation_basis_status", "translation_basis_note"],
            "oneOf": [
              {
                "properties": { "translation_basis_status": { "const": "unknown" } },
                "required": ["translation_basis_status", "translation_basis_note"],
                "not": { "anyOf": [{ "required": ["basis_language_tag"] }, { "required": ["translation_path"] }, { "required": ["translation_basis_source_ids"] }] }
              },
              {
                "required": ["basis_language_tag", "translation_path", "translation_basis_source_ids"],
                "not": { "properties": { "translation_basis_status": { "const": "unknown" } }, "required": ["translation_basis_status"] }
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "translationProcessEvidence": {
      "type": "object",
      "required": [
        "record_id", "language_tag", "record_type", "claim_summary", "participants",
        "edition_link_status", "edition_ids", "translation_path_status", "milestones",
        "source_ids", "limitations"
      ],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "language_tag": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
        "record_type": { "enum": ["individual_contribution", "project_history"] },
        "claim_summary": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["agent_type", "name", "claimed_role"],
            "properties": {
              "agent_type": { "enum": ["person", "organization", "community_team"] },
              "name": { "type": "string", "minLength": 1 },
              "claimed_role": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "edition_link_status": { "enum": ["identified", "not_established"] },
        "edition_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "translation_path_status": { "enum": ["established", "not_stated", "unknown"] },
        "translation_path": {
          "type": "array", "minItems": 2,
          "items": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
          "description": "Ordered BCP 47 tags from source through any relay language to the registered output language; include only when directly established by evidence."
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event", "date", "date_precision", "source_claim"],
            "properties": {
              "event": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
              "date_precision": { "enum": ["year", "month", "day"] },
              "source_claim": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "limitations": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "edition_link_status": { "const": "identified" } }, "required": ["edition_link_status"] },
          "then": { "properties": { "edition_ids": { "minItems": 1 } } },
          "else": { "properties": { "edition_ids": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "translation_path_status": { "const": "established" } }, "required": ["translation_path_status"] },
          "then": { "required": ["translation_path"] },
          "else": { "not": { "required": ["translation_path"] } }
        }
      ],
      "additionalProperties": false
    },
    "editionBasisEvidence": {
      "type": "object",
      "required": ["family_id", "family_label", "output_language_tag", "claim_type", "witness_relation", "claims", "source_ids", "limitations"],
      "properties": {
        "family_id": { "type": "string", "minLength": 1 },
        "family_label": { "type": "string", "minLength": 1 },
        "output_language_tag": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
        "claim_type": { "enum": ["historical_secondary_report", "publisher_statement", "collated_witness"] },
        "witness_relation": { "enum": ["family_level_not_collated", "specific_witness_collated"] },
        "claims": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scope", "source_language_tags", "statement"],
            "properties": {
              "scope": { "enum": ["whole_edition", "old_testament", "new_testament", "specific_book"] },
              "source_language_tags": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" }, "uniqueItems": true },
              "statement": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }, "uniqueItems": true },
        "limitations": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "witness_relation": { "const": "specific_witness_collated" } }, "required": ["witness_relation"] },
          "then": { "properties": { "claim_type": { "const": "collated_witness" } } },
          "else": { "properties": { "claim_type": { "enum": ["historical_secondary_report", "publisher_statement"] } } }
        }
      ],
      "additionalProperties": false
    }
  }
}
